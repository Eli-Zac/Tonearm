// Tonearm's landing page: static files in public/, served by a Worker at
// its own address. Deploy from this folder with `npx wrangler deploy`.
//
// Changing the address: edit the route below (a custom domain needs a zone
// on this Cloudflare account) and deploy.
{
  "name": "tonearm-site",
  "compatibility_date": "2026-11-18",
  // src/index.ts runs only for Party links; everything else is a static file.
  "main": "src/index.ts",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/party/*"] },
  "routes": [
    { "pattern": "tonearm.eli-zac.dev", "custom_domain": true }
  ]
}
