import { ListView } from "std-widgets.slint";
import "phosphor.ttf";
import "phosphor-fill.ttf";
// Figtree, the app's font, shipped with it so it is the same everywhere.
// SIL Open Font License, in figtree-LICENSE.txt.
import "Figtree-Regular.ttf";
import "Figtree-Medium.ttf";
import "Figtree-SemiBold.ttf";
import "Figtree-Bold.ttf";
import "Figtree-ExtraBold.ttf";

// A piece of a subtitle. A piece with a browse id opens that page when
// clicked, such as an artist or an album.
export struct Run {
    text: string,
    browse: string,
    // All the text before this piece, to measure where it starts.
    before: string,
}

// One line of a song's credits: the role, then the names under it.
// A song at one end of a transition, for the transition editor.
export struct MixSong {
    title: string,
    artist: string,
    art: image,
    has-art: bool,
    bpm: string,
    camelot: string,
    key-color: color,
    // Whether the song has been analysed. Without it there is no waveform to
    // draw, so the editor shows a skeleton of one.
    analysed: bool,
    // Why the two songs cannot be beat matched, shown on the tempo. Empty
    // when they can, or beatmatching is off.
    warning: string,
}

export struct CreditData {
    role: string,
    names: string,
}

export struct ItemData {
    id: int,
    // The song, album, playlist or artist id, to tell if it is playing.
    key: string,
    title: string,
    subtitle: string,
    // The subtitle cut into pieces, when some of it links somewhere.
    // Empty means the subtitle is plain text.
    runs: [Run],
    // The same without the album, for rows that show it in its own column.
    short-runs: [Run],
    album: string,
    album-browse: string,
    duration: string,
    art: image,
    has-art: bool,
    round: bool,
    // Saved on this computer.
    downloaded: bool,
    // Being downloaded, or waiting its turn, and how far it has got (0 to 1).
    downloading: bool,
    progress: float,
    // Marked explicit: an E badge before the subtitle, or after the title
    // when there is none.
    explicit: bool,
    // On a chart, the move since the last one: 0 none, 1 up, 2 down,
    // 3 level.
    trend: int,
    // A Spotify song not matched to YouTube Music yet, or not there at
    // all: drawn faded, with nothing to play.
    pending: bool,
    // A playlist's service, badged on its card: 0 none, 1 YouTube Music,
    // 2 Spotify.
    service: int,
}

// kind: 0 section header, 1 list item, 2 row of cards, 3 load more marker,
//       4 page hero (drawn from AppWindow.header), 5 text block (title holds
//       the text), 6 column header for a track list, 7 the top result
//       of a search, 10 a grid of songs four to a column, 11 a row of
//       music videos, 12 Home's mood chips, 13 a page's only row of
//       cards, wrapped
// style (kind 1 only): 0 art, 1 numbered with no art, 2 numbered with art
export struct RowData {
    kind: int,
    title: string,
    // kind 8: the line under the heading.
    subtitle: string,
    item: ItemData,
    cards: [ItemData],
    style: int,
    // The 1-based track number, for styles 1 and 2.
    number: int,
    // kind 0: shows a "Show all" button.
    more: bool,
    more-id: int,
    // Mix mode: the song's tempo and Camelot key, empty while unknown, and
    // the key's colour on the wheel.
    bpm: string,
    camelot: string,
    key-color: color,
    // Mix mode: the transition into the next song, like "Auto". Empty for
    // the last song.
    mix: string,
    // Mix mode: 0 tempo and key known, 1 being analyzed, 2 waiting its
    // turn, 3 not on this computer yet, so analyzed once it plays.
    analysis: int,
    // How far along the analysis is, 0 to 1, while it is being analyzed.
    analysis-progress: float,
}

// The top of a detail page.
// kind: 0 none (the plain title strip), 1 artist, 2 album, 3 playlist,
//       4 single or EP, 5 podcast, 6 profile, 7 other
export struct PageHeader {
    kind: int,
    label: string,
    title: string,
    byline: string,
    byline-browsable: bool,
    meta: string,
    art: image,
    has-art: bool,
    round: bool,
    // The art is a wide banner, drawn across the whole hero.
    banner: bool,
    // No art of its own: a tile with the download icon, for Downloads.
    icon-tile: bool,
    can-play: bool,
    can-shuffle: bool,
    can-follow: bool,
    followed: bool,
    can-like: bool,
    liked: bool,
    // A playlist, which can be played in mix mode, and whether it is.
    can-mix: bool,
    mixing: bool,
    // The download button: 0 none, 1 not all saved, 2 downloading,
    // 3 every song saved. download-progress is how many are saved (0 to 1).
    download: int,
    download-progress: float,
    // A playlist's service, shown by its label: 0 none, 1 YouTube Music,
    // 2 Spotify.
    service: int,
}

// A playlist's service as its official logo, in full colour: 1 YouTube
// Music, 2 Spotify. Spotify's waves are cut out of its circle, so a black
// disc behind shows them black, as Spotify draws them on dark.
component ServiceBadge inherits Rectangle {
    in property <int> service;
    in property <length> size: 22px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    drop-shadow-blur: 6px;
    drop-shadow-color: #00000080;
    if root.service == 2: Rectangle {
        x: root.size * 0.08;
        y: root.size * 0.08;
        width: root.size * 0.84;
        height: root.size * 0.84;
        border-radius: self.width / 2;
        background: #000000;
    }
    Image {
        width: root.size;
        height: root.size;
        source: root.service == 2 ? @image-url("spotify-color.svg") : @image-url("youtubemusic-color.svg");
    }
}

// A Cast device in the cast menu. `kind` is 0 for a speaker, 1 for a TV or
// anything else with a screen, 2 for a speaker group.
export struct CastDevice {
    name: string,
    model: string,
    kind: int,
}

// One of the Tonearm account's devices, for its list in Settings.
export struct AccountDevice {
    name: string,
    // "phone", "tablet" or "computer", for its icon.
    kind: string,
    // Make and model; empty when unknown.
    model: string,
    // "just now", "5 minutes ago"
    seen: string,
    current: bool,
}

// The cast button's icon: a screen with the corner waves, as a filled
// path in a 24 unit box. The icon font has no cast glyph.
global CastIcon {
    out property <string> shape: "M 2 8 L 2 4 L 22 4 L 22 20 L 14 20 L 14 18.5 L 20.5 18.5 L 20.5 5.5 L 3.5 5.5 L 3.5 8 Z M 2 17.8 A 2.2 2.2 0 0 1 4.2 20 L 2 20 Z M 2 13.5 A 6.5 6.5 0 0 1 8.5 20 L 7 20 A 5 5 0 0 0 2 15 Z M 2 9.5 A 10.5 10.5 0 0 1 12.5 20 L 11 20 A 9 9 0 0 0 2 11 Z";
}

// A synced pair on the Syncs page: the playlist it was made from, the one
// it syncs to, and what can be done with it. `key` is its Spotify browse id.
export struct SyncRowData {
    key: string,
    from-title: string,
    from-label: string,
    from-service: int,
    from-art: image,
    from-has-art: bool,
    to-title: string,
    to-label: string,
    to-service: int,
    to-art: image,
    to-has-art: bool,
    // "5 min ago", or "Syncing" while it does.
    when: string,
    // A sync of this pair is under way.
    busy: bool,
    // Removals waiting for the user, songs only one side has.
    held: int,
    missing: int,
    can-undo: bool,
}

// One line of the right click menu. icon is one of the Icons glyphs.
// Rust fills the list for the item clicked.
export struct MenuEntry {
    label: string,
    icon: string,
}

// A row under the search bar. kind 0 is a completed search, shown as
// head in bold (what was typed) and tail after it. kind 1 is an item.
// kind 2 is a recent search, its text in head.
export struct SuggestData {
    kind: int,
    head: string,
    tail: string,
    item: ItemData,
}

export struct SyllableData {
    text: string,
    start: int,
    end: int,
    space: bool,
    // When the word it is part of starts, which a click on it plays from.
    word-start: int,
}

export struct LyricRow {
    text: string,
    syllables: [SyllableData],
    start: int,
    end: int,
    // 0 words, 1 gap between lines, 2 interlude dots, 3 backing vocals,
    // 4 translation
    kind: int,
    line: int,
    // The first row of its line. The view scrolls to it.
    first: bool,
    // 0 left, 1 right, 2 centred: where the singer's lines sit.
    align: int,
    // The row drawn out of focus, a little and a lot, for lines away from
    // the sung one. Empty until drawn. Each has `soft-pad` of clear room
    // on every side, and is `soft-height` tall in all.
    soft: image,
    softer: image,
    soft-pad: length,
    soft-height: length,
}

export global Theme {
    in property <string> font: "Figtree";
    out property <color> bg: #08080a;
    out property <color> island: #131316;
    out property <color> raised: #1c1c21;
    out property <color> hover: #ffffff12;
    out property <color> line: #ffffff14;
    out property <color> text: #f5f5f7;
    out property <color> dim: #9c9ca6;
    out property <color> faint: #ffffff59;
    out property <color> accent: #ff4f6d;
    out property <length> radius: 14px;
}

// Phosphor icons (phosphoricons.com), subset to the glyphs we use, in two
// weights: phosphor.ttf (regular) and phosphor-fill.ttf (fill). Both use
// the same code points, so Icon picks the weight. See icons-LICENSE.txt.
// Redo the subsets with pyftsubset when adding an icon.
export global Icons {
    // Transport. The fill weight has all four, the regular only play.
    out property <string> play: "\u{e3d0}";
    out property <string> pause: "\u{e39e}";
    out property <string> prev: "\u{e5a4}";
    out property <string> next: "\u{e5a6}";
    // Filled only: two triangles each way, the transport's skip buttons.
    out property <string> rewind: "\u{e6a8}";
    out property <string> fast-forward: "\u{e6a6}";
    out property <string> shuffle: "\u{e422}";
    out property <string> repeat: "\u{e3f6}";
    out property <string> repeat-one: "\u{e3f8}";
    out property <string> heart: "\u{e2a8}";
    // Pins an album, artist or playlist to Quick access in the side menu.
    out property <string> pin: "\u{e3e2}";
    // Navigation. Both weights, so the selected page can show fill.
    out property <string> home: "\u{e2c2}";
    out property <string> explore: "\u{e1c8}";
    out property <string> library: "\u{e758}";
    out property <string> download: "\u{e028}";
    out property <string> settings: "\u{e270}";
    // Regular only from here, apart from dots.
    out property <string> search: "\u{e30c}";
    out property <string> back: "\u{e058}";
    out property <string> left: "\u{e138}";
    out property <string> right: "\u{e13a}";
    out property <string> down: "\u{e136}";
    out property <string> arrow-up: "\u{e08e}";
    out property <string> arrow-down: "\u{e03e}";
    out property <string> queue: "\u{e6ac}";
    out property <string> lyrics: "\u{e75c}";
    out property <string> now-playing: "\u{e64c}";
    out property <string> expand: "\u{e0a6}";
    out property <string> collapse: "\u{e09e}";
    out property <string> speaker-high: "\u{e44a}";
    out property <string> speaker-low: "\u{e44c}";
    out property <string> muted: "\u{e45c}";
    out property <string> play-next: "\u{ea1e}";
    out property <string> add-queue: "\u{e2f8}";
    out property <string> artist: "\u{e4c2}";
    out property <string> album: "\u{ecac}";
    out property <string> radio: "\u{e77e}";
    out property <string> trash: "\u{e4a6}";
    out property <string> open: "\u{e092}";
    out property <string> connections: "\u{eb5a}";
    out property <string> moon: "\u{e330}";
    out property <string> sparkle: "\u{e6a2}";
    out property <string> recent: "\u{e1a0}";
    // Fill only: three solid dots for the "more" button.
    out property <string> dots: "\u{e204}";
    // Fill only: a phone and a computer, for the Tonearm account's devices.
    out property <string> mobile: "\u{e1e0}";
    out property <string> desktop: "\u{e560}";
}

// One of the Icons glyphs. fill draws it from the fill weight.
component Icon inherits Text {
    in property <bool> fill;
    font-family: fill ? "Phosphor-Fill" : "Phosphor";
    color: Theme.text;
    font-size: 18px;
    horizontal-alignment: center;
    vertical-alignment: center;
}

// What is playing, for every play button to compare its item against.
export global Now {
    // The video id of the current song.
    in property <string> song;
    // The key of the album, playlist, mix or artist the queue came from.
    in property <string> from;
    // The key of the album, playlist or artist page that is open.
    in property <string> page;
    in property <bool> playing;
    // A clock in ms for the playing bars, stepped from Rust while a song
    // plays. animation-tick() would redraw at the screen's full rate.
    in property <int> beat;
    // During a crossfade: the song going out, and how far the mix has got,
    // 0 to 1. Its row draws the pulse on the line to the next song.
    in property <string> fade-from;
    in property <float> fade-progress;
    // The crossfade's length in ms, so the pulse can keep its own time.
    in property <int> fade-length;
    // Whether the item keyed `key` is playing or paused right now.
    public pure function is-current(key: string) -> bool {
        return key != "" && (key == song || key == from);
    }
}

// A ring that fills clockwise as a song downloads. Empty while it waits.
component DownloadRing inherits Rectangle {
    in property <float> progress;
    width: 14px;
    height: 14px;
    // Short of a full turn, as an arc that ends where it starts draws nothing.
    property <angle> sweep: clamp(root.progress, 0, 0.999) * 360deg;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: Theme.faint;
        stroke-width: 2.5px;
        MoveTo { x: 12; y: 2.5; }
        ArcTo { x: 12; y: 21.5; radius-x: 9.5; radius-y: 9.5; sweep: true; }
        ArcTo { x: 12; y: 2.5; radius-x: 9.5; radius-y: 9.5; sweep: true; }
    }
    if root.progress > 0: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: Theme.accent;
        stroke-width: 2.5px;
        MoveTo { x: 12; y: 2.5; }
        ArcTo {
            x: 12 + 9.5 * sin(root.sweep);
            y: 12 - 9.5 * cos(root.sweep);
            radius-x: 9.5;
            radius-y: 9.5;
            large-arc: root.sweep > 180deg;
            sweep: true;
        }
    }
}

// Three bars bouncing like a level meter: what a play button shows while
// its item plays. They stand still while paused, and only animate, and so
// only redraw, while running.
component Bars inherits Rectangle {
    in property <bool> running;
    in property <color> tint: Theme.accent;
    in property <length> bar: 3px;
    property <length> gap: 2px;
    width: bar * 3 + gap * 2;
    height: 14px;
    // Bars only run while music plays, when Rust steps Now.beat.
    property <float> t: running ? Now.beat : 0;
    for i in 3: Rectangle {
        x: i * (root.bar + root.gap);
        width: root.bar;
        height: root.height * (root.running
            ? 0.25 + 0.75 * abs(sin((root.t * (0.33 + i * 0.07) + i * 70) * 1deg))
            : (i == 1 ? 0.8 : i == 0 ? 0.5 : 0.35));
        y: root.height - self.height;
        border-radius: root.bar / 2;
        background: root.tint;
    }
}

// The one loading indicator. Three dots that rise and brighten in turn.
// It only animates while it is on screen, so an idle app stays idle.
component Loader inherits Rectangle {
    in property <length> dot: 7px;
    in property <color> tint: Theme.dim;
    property <float> t: animation-tick() / 1ms;
    width: dot * 5;
    height: dot * 3;
    for i in 3: Rectangle {
        // Each dot runs the same wave, a third of a cycle behind the last.
        property <float> wave: (sin((t * 0.3 - i * 120) * 1deg) + 1) / 2;
        x: i * dot * 2;
        y: (root.height - dot) / 2 - wave * dot * 0.6;
        width: dot;
        height: dot;
        border-radius: dot / 2;
        background: root.tint;
        opacity: 0.3 + wave * 0.7;
    }
}

// Skeletons stand in for content that is on its way: Loader is for an
// action in progress, a skeleton is for a list, card or text still
// loading. Every skeleton is built from Bone. A band of light sweeps
// left to right across the window, and each bone shows the part of it
// over where the bone sits, so one wave passes over the whole skeleton.
component Bone inherits Rectangle {
    in property <length> corner: 6px;
    // The band's left edge in the window: across it and out the other
    // side every 1.6 seconds.
    property <length> sweep: mod(animation-tick() / 1ms, 1600) / 1600 * 3200px - 800px;
    border-radius: corner;
    background: #ffffff0e;
    clip: true;
    Rectangle {
        x: root.sweep - root.absolute-position.x;
        width: 800px;
        background: @linear-gradient(90deg, #ffffff00 0%, #ffffff16 50%, #ffffff00 100%);
    }
}

// Stands in for a SongRow: the art on the left, a title and a line under it.
component SkeletonRow inherits Rectangle {
    // Varies the bar lengths so a stack of rows does not look stamped out.
    in property <int> seed;
    in property <bool> round;
    // A track on an album: a short number bone where the art would be.
    in property <bool> numbered;
    property <length> left: numbered ? 48px : 64px;
    property <length> room: self.width - root.left - 14px;
    height: numbered ? 52px : 60px;
    if !root.numbered: Bone {
        x: 8px;
        y: 8px;
        width: 44px;
        height: 44px;
        corner: root.round ? 22px : 6px;
    }
    if root.numbered: Bone {
        x: 16px;
        y: 20px;
        width: 12px;
        height: 12px;
        corner: 3px;
    }
    Bone {
        x: root.left;
        y: root.numbered ? 14px : 17px;
        width: root.room * (0.62 - mod(root.seed * 7, 5) * 0.055);
        height: 11px;
    }
    Bone {
        x: root.left;
        y: root.numbered ? 32px : 36px;
        width: root.room * (0.34 - mod(root.seed * 3, 4) * 0.035);
        height: 9px;
    }
}

// Stands in for a Card in a carousel.
component SkeletonCard inherits Rectangle {
    in property <int> seed;
    width: 176px;
    height: 232px;
    Bone {
        x: 10px;
        y: 10px;
        width: 156px;
        height: 156px;
        corner: 10px;
    }
    Bone {
        x: 10px;
        y: 180px;
        width: 156px * (0.8 - mod(root.seed * 5, 4) * 0.08);
        height: 11px;
    }
    Bone {
        x: 10px;
        y: 201px;
        width: 156px * (0.5 - mod(root.seed * 3, 3) * 0.07);
        height: 9px;
    }
}

// Stands in for a shelf: its title, then a row of cards.
component SkeletonShelf inherits Rectangle {
    in property <int> seed;
    height: 56px + 236px;
    Bone {
        x: 0;
        y: 16px;
        width: 150px + mod(root.seed * 37, 4) * 30px;
        height: 22px;
        corner: 7px;
    }
    for i in 10: SkeletonCard {
        x: i * 176px - 10px;
        y: 56px;
        seed: i + root.seed;
        visible: self.x < root.width;
    }
}

// Stands in for a whole page while it loads, laid out as the page will
// be, so nothing jumps when it arrives. It sits where the page list does,
// below the room, title and tabs the layout puts above it. Everything is
// placed by hand, so it never sizes the window.
//   style 0: Home, its mood chips, then shelves of cards
//   style 1: a page of shelves, such as Explore and Library, whose title
//            only arrives with the page, so a bone holds its 52 pixel band
//   style 2: search results: the top result, then songs
component SkeletonPage inherits Rectangle {
    in property <int> style;
    clip: true;
    // Home's mood chips.
    if root.style == 0: Rectangle {
        y: 10px;
        height: 32px;
        // Widths of 66, 94 and 80 pixels in turn, each placed after the
        // ones before it with the chip row's 8 pixel gap, starting where
        // the shelf titles do. The x is the sum of the widths so far.
        for i in 11: Bone {
            property <int> r: mod(i, 3);
            x: 8px + i * (66px + 8px) + 14px * (3 * floor(i / 3) + (self.r == 2 ? 2 : 0));
            width: 66px + 14px * mod(i * 2, 3);
            height: 32px;
            corner: 8px;
            visible: self.x < root.width;
        }
    }
    // A page's title, over the height of its capitals, in the 52 pixel
    // band it sits in: the same height as Home's chip row.
    if root.style == 1: Bone {
        x: 8px;
        y: 10px;
        width: 220px;
        height: 24px;
        corner: 8px;
    }
    if root.style != 2: Rectangle {
        y: 52px;
        for i in 3: SkeletonShelf {
            x: 8px;
            y: i * (56px + 236px);
            width: root.width - 8px;
            seed: i * 3;
            visible: self.y < root.height;
        }
    }
    if root.style == 2: Rectangle {
        // "Top result", then its card: art, a name and a line under it.
        Bone {
            x: 8px;
            y: 16px;
            width: 130px;
            height: 22px;
            corner: 7px;
        }
        Rectangle {
            x: 0;
            y: 56px;
            width: min(root.width - 10px, 560px);
            height: 144px;
            border-radius: 12px;
            background: #ffffff08;
            Bone {
                x: 16px;
                y: 16px;
                width: 112px;
                height: 112px;
                corner: 10px;
            }
            Bone {
                x: 148px;
                y: 44px;
                width: 200px;
                height: 22px;
                corner: 7px;
            }
            Bone {
                x: 148px;
                y: 78px;
                width: 120px;
                height: 12px;
            }
        }
        // "Songs", then the rows.
        Bone {
            x: 8px;
            y: 56px + 156px + 16px;
            width: 90px;
            height: 22px;
            corner: 7px;
        }
        for i in 8: SkeletonRow {
            x: 0;
            y: 56px + 156px + 56px + i * 56px;
            width: root.width - 10px;
            seed: i + 2;
            visible: self.y < root.height;
        }
    }
}

// The sizes of a detail page's hero, shared by the hero and its skeleton
// so nothing jumps when the real one replaces the stand in.
// Set from wheel.rs while the wheel or touchpad is scrolling, and for a
// moment after. Lists and cards hold their hover effects meanwhile, as
// browsers do. Besides rows flashing as they fly past, a row reacting to
// the mouse as it slides under it made Windows coast a touchpad flick as
// one late jump instead of a smooth stream of small steps.
export global Scroll {
    in property <bool> active;
}

export global Hero {
    public pure function pad(compact: bool) -> length { return compact ? 16px : 24px; }
    public pure function art(compact: bool) -> length { return compact ? 152px : 216px; }
    // kind and banner as in PageHeader.
    public pure function height(kind: int, banner: bool, compact: bool) -> length {
        return banner ? (compact ? 236px : 300px)
            // Label, title, owner, meta and buttons, with padding.
            : kind == 7 ? (compact ? 200px : 240px)
            : art(compact) + pad(compact) * 2;
    }
}

// Stands in for a detail page while it loads: the hero card, then a list.
// banner is the artist layout, numbered the album track rows.
component SkeletonDetail inherits Rectangle {
    in property <bool> compact;
    in property <bool> banner;
    in property <bool> numbered;
    in property <bool> round;
    property <length> pad: Hero.pad(compact);
    property <length> art-size: Hero.art(compact);
    property <length> hero: Hero.height(1, banner, compact);
    property <length> text-x: banner ? pad : pad + art-size + pad;
    property <length> buttons-y: hero - pad - (compact ? 44px : 56px);
    property <length> meta-y: buttons-y - 10px - 6px - 13px;
    property <length> byline-y: meta-y - 6px - 16px;
    property <length> title-h: compact ? 28px : 40px;
    property <length> title-y: byline-y - 10px - title-h;
    clip: true;
    Rectangle {
        width: parent.width;
        height: root.hero;
        x: 0;
        y: 0;
        background: #ffffff0a;
        if !root.banner: Bone {
            x: root.pad;
            y: root.pad;
            width: root.art-size;
            height: root.art-size;
            corner: root.round ? root.art-size / 2 : 10px;
        }
        Bone {
            x: root.text-x;
            y: root.title-y - 8px - 11px;
            width: 56px;
            height: 11px;
        }
        Bone {
            x: root.text-x;
            y: root.title-y;
            width: min(parent.width - root.text-x - root.pad, 320px);
            height: root.title-h;
            corner: 8px;
        }
        Bone {
            x: root.text-x;
            y: root.byline-y;
            width: 110px;
            height: 14px;
        }
        Bone {
            x: root.text-x;
            y: root.meta-y;
            width: 170px;
            height: 12px;
        }
        Bone {
            x: root.text-x;
            y: root.buttons-y;
            width: 80px;
            height: 36px;
            corner: 18px;
        }
        Bone {
            x: root.text-x + 90px;
            y: root.buttons-y;
            width: root.compact ? 36px : 96px;
            height: 36px;
            corner: 18px;
        }
    }
    // In the song rows' 16 pixel margins.
    for i in 10: SkeletonRow {
        x: 16px;
        y: root.hero + 12px + 32px + i * (root.numbered ? 52px : 60px);
        width: root.width - 32px;
        numbered: root.numbered;
        seed: i + 2;
        visible: self.y < root.height;
    }
}

// Stands in for lines of text, such as lyrics.
component SkeletonLines inherits Rectangle {
    in property <int> lines: 6;
    in property <length> line-height: 22px;
    in property <length> spacing: 14px;
    height: lines * (line-height + spacing);
    for i in root.lines: Bone {
        x: 0;
        y: i * (root.line-height + root.spacing);
        width: root.width * (0.82 - mod(i * 7, 5) * 0.09);
        height: root.line-height;
        corner: root.line-height / 3;
    }
}

// A line of text that scrolls when it is too long to fit, instead of
// being cut short. It rests at the start, slides left until its end shows,
// rests there, then slides back, and so on. An edge fades where the text
// runs past it: at the start only the right, at the end only the left,
// and both in between. Text that fits stays put.
component Marquee inherits Rectangle {
    in property <string> text;
    in property <color> text-color: Theme.text;
    in property <length> font-size: 14px;
    in property <int> font-weight: 400;
    property <bool> long: label.preferred-width > self.width + 0.5px;
    // How far the text slides to show its end.
    property <length> travel: max(0px, label.preferred-width - self.width);
    property <bool> at-end;
    // Jump instead of slide, as a new line starts over at the start.
    property <bool> snap;
    // A steady 32 pixels a second, however long the text.
    property <duration> glide: self.travel / 32px * 1s;
    // How wide each fade is, at its fullest.
    property <length> fade: 28px;
    height: label.preferred-height;
    horizontal-stretch: 1;
    min-width: 0px;
    clip: true;
    changed text => {
        self.snap = true;
        self.at-end = false;
        pace.restart();
    }
    // Widened until it fits: back to the start, not stuck at the end.
    changed long => {
        if !self.long {
            self.snap = true;
            self.at-end = false;
        }
    }
    label := Text {
        x: root.at-end ? -root.travel : 0px;
        width: self.preferred-width;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        // How much of each fade shows: none with the text's own end at
        // that edge, all of it once a fade's width of text is past it.
        property <float> left-fade: max(0, min(1, -self.x / root.fade));
        property <float> right-fade: max(0, min(1, (self.width + self.x - root.width) / root.fade));
        // The window's edges in the text's own span, from 0 to 1.
        property <float> from: -self.x / max(1px, self.width);
        property <float> to: (root.width - self.x) / max(1px, self.width);
        property <float> band: root.fade / max(1px, self.width);
        property <float> inner-from: self.from + self.band;
        property <float> inner-to: self.to - self.band;
        color: root.long
            ? @linear-gradient(90deg,
                root.text-color.transparentize(self.left-fade) self.from * 100%,
                root.text-color self.inner-from * 100%,
                root.text-color self.inner-to * 100%,
                root.text-color.transparentize(self.right-fade) self.to * 100%)
            : root.text-color;
        animate x { duration: root.snap ? 0ms : root.glide; easing: ease-in-out; }
    }
    // Each turn is the slide plus a rest at the end it reaches.
    pace := Timer {
        interval: root.glide + 2.5s;
        running: root.long;
        triggered => {
            root.snap = false;
            root.at-end = !root.at-end;
        }
    }
}

// The one tooltip, drawn over the window by AppWindow. A TipSource in a
// button fills it in when the mouse rests there.
global Tip {
    // The TipSource showing, 0 for none.
    in-out property <int> owner;
    in-out property <string> text;
    // The button's box, in window coordinates.
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> width;
    in-out property <length> height;
    // A tip showed a moment ago, so the next one shows at once, as moving
    // along a row of buttons reads each one.
    in-out property <bool> warm;
    // Show it to the right of the button, as for a column of buttons where
    // above or under would cover the next one.
    in-out property <bool> beside;
    // Hands each TipSource its own number.
    in-out property <int> count;
    // Kept true by the TipSource showing, so a tip whose button is gone,
    // such as a carousel arrow at the end of its row, goes too.
    in-out property <bool> alive;
}

// Put inside a button to give it a tooltip. It fills the button and takes
// no input: pass it the button's hover and press. A Rectangle with nothing
// drawn, as a bare component would be sized nothing and sit at the
// button's centre, putting the tip half a button too close.
component TipSource inherits Rectangle {
    in property <string> tip;
    // To the right of the button rather than over it: see Tip.beside.
    in property <bool> beside;
    in property <bool> hovered;
    in property <bool> pressed;
    property <int> id;
    // Clicked: no tip again until the mouse leaves and comes back.
    property <bool> spent;
    init => {
        Tip.count += 1;
        self.id = Tip.count;
    }
    changed hovered => {
        if !self.hovered {
            self.spent = false;
            if Tip.owner == self.id { Tip.owner = 0; }
        }
    }
    changed pressed => {
        if self.pressed {
            self.spent = true;
            if Tip.owner == self.id { Tip.owner = 0; }
        }
    }
    // The page moving under a tip leaves it pointing at nothing.
    property <bool> scrolling: Scroll.active;
    changed scrolling => {
        if self.scrolling && Tip.owner == self.id { Tip.owner = 0; }
    }
    // Play turning to Pause under the mouse, say.
    changed tip => {
        if Tip.owner == self.id { Tip.text = self.tip; }
    }
    Timer {
        interval: Tip.warm ? 40ms : 650ms;
        running: root.hovered && !root.spent && !Scroll.active && root.tip != "" && Tip.owner != root.id;
        triggered => {
            Tip.text = root.tip;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y;
            Tip.width = root.width;
            Tip.height = root.height;
            Tip.beside = root.beside;
            Tip.owner = root.id;
            Tip.warm = true;
            Tip.alive = true;
        }
    }
    Timer {
        interval: 100ms;
        running: Tip.owner == root.id;
        triggered => { Tip.alive = true; }
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    // A filled path in a 24 unit box, drawn instead of `icon`.
    in property <string> shape;
    // Draw the icon from the fill weight.
    in property <bool> fill;
    // A small dot under the icon, for a toggle that is on.
    in property <bool> dot;
    in property <length> size: 18px;
    in property <color> tint: Theme.text;
    // A white round button, with the icon in black.
    in property <bool> filled;
    // Says what the button does, when the mouse rests on it.
    in property <string> tip;
    out property <bool> hovered: (touch.has-hover && !Scroll.active);
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: self.height / 2;
    background: filled ? (touch.pressed ? #d0d0d6 : (touch.has-hover && !Scroll.active) ? #ffffff : #f0f0f3) : (touch.pressed ? #ffffff24 : (touch.has-hover && !Scroll.active) ? Theme.hover : transparent);
    animate background { duration: 120ms; }
    if shape == "": Icon {
        text: icon;
        fill: root.fill;
        font-size: size;
        color: filled ? #08080a : tint;
    }
    if shape != "": Path {
        x: (parent.width - size) / 2;
        y: (parent.height - size) / 2;
        width: size;
        height: size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: shape;
        fill: filled ? #08080a : tint;
    }
    if dot: Rectangle {
        x: (parent.width - 4px) / 2;
        y: parent.height - 6px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: tint;
    }
    TipSource {
        tip: root.tip;
        hovered: (touch.has-hover && !Scroll.active);
        pressed: touch.pressed;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A round button with a cross, to close a panel. The icon font has no
// cross, so it is drawn. As tall as a PillButton, to sit beside one.
component CloseButton inherits Rectangle {
    in property <string> tip: "Close";
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: (touch.has-hover && !Scroll.active) ? #ffffff1c : transparent;
    animate background { duration: 120ms; }
    Path {
        x: 12px;
        y: 12px;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 1 1 L 11 11 M 11 1 L 1 11";
        stroke: (touch.has-hover && !Scroll.active) ? Theme.text : Theme.dim;
        stroke-width: 1.75px;
    }
    TipSource {
        tip: root.tip;
        hovered: (touch.has-hover && !Scroll.active);
        pressed: touch.pressed;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    // For actions that undo something, like unlinking an account.
    in property <bool> danger;
    // Bars before the label, for the Play button of what is playing.
    in property <bool> bars;
    in property <bool> bars-running;
    callback clicked;
    height: 36px;
    width: label.preferred-width + 36px + (bars ? 20px : 0px);
    border-radius: 18px;
    background: primary ? ((touch.has-hover && !Scroll.active) ? #ffffff : #f0f0f3)
        : danger ? ((touch.has-hover && !Scroll.active) ? #ff4f6d33 : #ff4f6d1a)
        : ((touch.has-hover && !Scroll.active) ? #ffffff24 : #ffffff14);
    animate background { duration: 120ms; }
    if root.bars: Bars {
        x: 16px;
        y: (parent.height - self.height) / 2;
        height: 12px;
        running: root.bars-running;
        tint: root.primary ? #08080a : Theme.text;
    }
    label := Text {
        x: root.bars ? 36px : 18px;
        width: self.preferred-width;
        text: root.text;
        color: primary ? #08080a : danger ? #ff8095 : Theme.text;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Field inherits Rectangle {
    in property <string> placeholder;
    in property <string> icon;
    in property <bool> secret;
    in-out property <string> text <=> input.text;
    out property <bool> focused: input.has-focus;
    callback accepted(string);
    callback edited(string);
    public function blur() { input.clear-focus(); }
    public function take-focus() { input.focus(); }
    // Taller, with a larger icon and text, as search is in the top bar.
    in property <bool> large;
    height: root.large ? 48px : 40px;
    border-radius: self.height / 2;
    background: input.has-focus ? #ffffff1c : #ffffff10;
    border-width: 1px;
    border-color: input.has-focus ? #ffffff40 : transparent;
    animate background, border-color { duration: 150ms; }
    if root.icon != "": Icon {
        x: root.large ? 16px : 14px;
        width: root.large ? 22px : 18px;
        text: root.icon;
        color: Theme.dim;
        font-size: root.large ? 22px : 17px;
    }
    Text {
        x: root.icon != "" ? (root.large ? 50px : 42px) : 18px;
        width: parent.width - self.x - 18px;
        text: input.text == "" ? root.placeholder : "";
        color: Theme.dim;
        font-size: root.large ? 16px : 14px;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: root.icon != "" ? (root.large ? 50px : 42px) : 18px;
        width: parent.width - self.x - 18px;
        clip: true;
        input := TextInput {
            width: 100%;
            color: Theme.text;
            font-size: root.large ? 16px : 14px;
            single-line: true;
            vertical-alignment: center;
            input-type: root.secret ? InputType.password : InputType.text;
            selection-background-color: #ffffff40;
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
        }
    }
}

// One group of settings on a card: a title, an optional status beside it,
// a line about what it does, then whatever controls the group needs.
component Section inherits Rectangle {
    in property <string> title;
    in property <string> status;
    in property <string> about;
    // An optional logo, drawn white on a tile of the brand colour.
    in property <image> logo;
    // Or an icon from the icon font, drawn white on the tile instead.
    in property <string> glyph;
    in property <color> brand;
    max-width: 880px;
    border-radius: 12px;
    background: #ffffff0a;
    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            if root.brand != transparent: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: root.brand;
                    if root.glyph == "": Image {
                        width: 18px;
                        height: 18px;
                        source: root.logo;
                        colorize: #ffffff;
                    }
                    if root.glyph != "": Icon {
                        text: root.glyph;
                        color: #ffffff;
                        font-size: 18px;
                    }
                }
            }
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 16px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: root.status;
                color: Theme.accent;
                font-size: 14px;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
            }
        }
        if root.about != "": Text {
            text: root.about;
            color: Theme.dim;
            font-size: 14px;
            wrap: word-wrap;
        }
        @children
    }
}

// The last row of a service card: whether an account is linked, and the
// button that links or unlinks it.
component AccountRow inherits VerticalLayout {
    in property <bool> linked;
    in property <string> title;
    in property <string> subtitle;
    in property <string> link-text: "Connect";
    in property <string> unlink-text: "Unlink account";
    callback link();
    callback unlink();
    spacing: 12px;
    Rectangle {
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    y: (parent.height - 8px) / 2;
                    border-radius: 4px;
                    background: root.linked ? #3ba55d : #ffffff40;
                }
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.dim;
                font-size: 14px;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            if root.linked: PillButton {
                text: root.unlink-text;
                danger: true;
                clicked => { root.unlink(); }
            }
            if !root.linked: PillButton {
                text: root.link-text;
                primary: true;
                clicked => { root.link(); }
            }
        }
    }
}

// A row on the settings page that opens a sub page.
component SubpageRow inherits Rectangle {
    in property <string> icon;
    // A logo drawn white on a tile of the brand colour, used instead of icon.
    in property <image> logo;
    in property <color> brand;
    in property <string> title;
    in property <string> subtitle;
    callback clicked;
    max-width: 880px;
    height: 68px;
    border-radius: 12px;
    background: (touch.has-hover && !Scroll.active) ? #ffffff14 : #ffffff0a;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 9px;
                background: root.brand != transparent ? root.brand : #ffffff14;
                if root.brand == transparent: Icon {
                    text: root.icon;
                    font-size: 20px;
                }
                if root.brand != transparent: Image {
                    width: 20px;
                    height: 20px;
                    source: root.logo;
                    colorize: #ffffff;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 16px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.subtitle;
                color: Theme.dim;
                font-size: 14px;
                overflow: elide;
            }
        }
        Icon {
            width: 20px;
            text: Icons.right;
            color: Theme.dim;
            font-size: 16px;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A number and what it counts, on the profile page.
component StatTile inherits Rectangle {
    in property <int> value;
    in property <string> label;
    // The same width each, whatever their labels.
    horizontal-stretch: 1;
    min-width: 0;
    preferred-width: 0;
    height: 84px;
    border-radius: 12px;
    background: #ffffff0a;
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.value;
            color: Theme.text;
            font-size: 28px;
            font-weight: 800;
        }
        Text {
            text: root.label;
            color: Theme.dim;
            font-size: 13px;
            overflow: elide;
        }
    }
}

// One of the artists you play most, with its place.
component ArtistRank inherits Rectangle {
    in property <int> rank;
    in property <string> name;
    callback clicked;
    height: 48px;
    border-radius: 8px;
    background: (touch.has-hover && !Scroll.active) ? Theme.hover : transparent;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        Text {
            width: 22px;
            text: root.rank;
            color: root.rank <= 3 ? Theme.accent : Theme.dim;
            font-size: 16px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: #ffffff14;
                Icon {
                    text: Icons.artist;
                    font-size: 16px;
                    color: Theme.dim;
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.name;
            color: Theme.text;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Icon {
            width: 18px;
            text: Icons.search;
            color: Theme.dim;
            font-size: 14px;
            opacity: (touch.has-hover && !Scroll.active) ? 1 : 0;
            animate opacity { duration: 120ms; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A copy of Discord's profile card, so the user sees what friends see.
component DiscordPreview inherits Rectangle {
    in property <string> app-name: "Tonearm";
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <image> art;
    in property <bool> has-art;
    in property <float> progress;
    in property <string> position;
    in property <string> duration;
    // 0 artist, 1 song, 2 app name. What the member list repeats.
    in property <int> status;
    in property <string> user: "you";
    property <string> status-line: status == 1 ? title : status == 2 ? app-name : artist;
    border-radius: 10px;
    background: #232428;
    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        Text {
            text: "Listening to " + root.app-name;
            color: #dbdee1;
            font-size: 13px;
            font-weight: 700;
        }
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 80px;
                height: 80px;
                border-radius: 8px;
                background: #ffffff10;
                clip: true;
                if root.has-art: Image {
                    width: 100%;
                    height: 100%;
                    source: root.art;
                    image-fit: cover;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.title;
                    color: #f2f3f5;
                    font-size: 14px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.artist;
                    color: #dbdee1;
                    font-size: 13px;
                    overflow: elide;
                }
                if root.album != "": Text {
                    text: root.album;
                    color: #dbdee1;
                    font-size: 13px;
                    overflow: elide;
                }
                HorizontalLayout {
                    padding-top: 6px;
                    spacing: 8px;
                    Text {
                        text: root.position;
                        color: #dbdee1;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 4px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 2px;
                        background: #4e5058;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.progress, 0, 1);
                            border-radius: 2px;
                            background: #f2f3f5;
                        }
                    }
                    Text {
                        text: root.duration;
                        color: #dbdee1;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }
        // The member list line.
        Rectangle {
            height: 1px;
            background: #ffffff14;
        }
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: #5865f2;
                Text {
                    text: "Y";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 700;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text {
                    text: "In the member list";
                    color: #949ba4;
                    font-size: 11px;
                }
                Text {
                    text: "Listening to " + root.status-line;
                    color: #b5bac1;
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }
    }
}

// A button showing the picked option that opens a list of the others.
component Dropdown inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback changed(int);
    // The menu is at least this wide, for long options, and the button at
    // most `widest`, past which its label is cut short.
    in property <length> menu-min: 160px;
    in property <length> widest: 100000px;
    property <length> menu-width: max(self.width, root.menu-min);
    width: min(max(label.preferred-width + 52px, 140px), root.widest);
    height: 34px;
    border-radius: 10px;
    background: (touch.has-hover && !Scroll.active) ? #ffffff24 : #ffffff14;
    animate background { duration: 120ms; }
    label := Text {
        x: 14px;
        width: parent.width - 14px - 34px;
        overflow: elide;
        text: root.options[root.selected];
        color: Theme.text;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
        height: parent.height;
    }
    // A chevron pointing down.
    Icon {
        x: parent.width - 28px;
        width: 18px;
        height: parent.height;
        text: Icons.down;
        color: Theme.dim;
        font-size: 14px;
    }
    keeper := FocusScope { }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            keeper.focus();
            menu.show();
        }
    }
    menu := PopupWindow {
        x: root.width - root.menu-width;
        y: root.height + 6px;
        width: root.menu-width;
        Rectangle {
            border-radius: 12px;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000080;
            VerticalLayout {
                padding: 5px;
                spacing: 2px;
                for option[i] in root.options: Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: (item.has-hover && !Scroll.active) ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: option;
                            color: i == root.selected ? Theme.text : Theme.dim;
                            font-size: 14px;
                            font-weight: i == root.selected ? 600 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if i == root.selected: Rectangle {
                            width: 6px;
                            height: 6px;
                            y: (parent.height - 6px) / 2;
                            border-radius: 3px;
                            background: Theme.accent;
                        }
                    }
                    item := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected = i;
                            root.changed(i);
                        }
                    }
                }
            }
        }
    }
}

// A setting: a title and a line under it on the left, its control on the right.
component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 16px;
    padding-top: 4px;
    padding-bottom: 4px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 16px;
            font-weight: 600;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.dim;
            font-size: 14px;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        alignment: center;
        @children
    }
}

// Pulses in place of a cover that is still on its way, like the skeletons.
// A cover that never comes (a dead link, or a song with none) stops it after
// a while, so an idle app stays idle.
component ArtPending inherits Rectangle {
    in property <bool> waiting;
    property <bool> gave-up;
    changed waiting => {
        if root.waiting {
            root.gave-up = false;
        }
    }
    Timer {
        interval: 8s;
        running: root.waiting && !root.gave-up;
        triggered => { root.gave-up = true; }
    }
    if root.waiting && !root.gave-up: Bone {
        width: 100%;
        height: 100%;
        corner: 0;
    }
}

component Art inherits Rectangle {
    in property <image> source;
    in property <bool> has;
    in property <bool> round;
    in property <length> corner: 8px;
    // An animated cover laid over the still one, and how far it has faded in.
    in property <image> motion;
    in property <float> motion-t;
    background: has || motion-t > 0 ? transparent : #232329;
    border-radius: round ? self.width / 2 : corner;
    clip: true;
    ArtPending {
        waiting: !root.has && root.motion-t <= 0;
    }
    if has: Image {
        source: root.source;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }
    if motion-t > 0: Image {
        source: root.motion;
        width: 100%;
        height: 100%;
        image-fit: cover;
        opacity: root.motion-t;
    }
}

// Text that opens a page when it carries a browse id, such as an artist
// name in a subtitle. It brightens under the mouse to show it is a link.
// A right click passes through as `menu`, so the row's menu still opens.
component LinkText inherits Text {
    in property <string> browse;
    in property <color> rest-color: Theme.dim;
    in property <color> hover-color: Theme.text;
    callback open(string);
    callback menu(length, length);
    // The link is under the mouse. A row it sits in no longer sees the mouse
    // then, so the row asks this to stay lit.
    out property <bool> hovered: (link.has-hover && !Scroll.active);
    color: root.browse != "" && (link.has-hover && !Scroll.active) ? root.hover-color : root.rest-color;
    font-size: 14px;
    overflow: elide;
    vertical-alignment: center;
    link := TouchArea {
        // Only the drawn text is a link, not the room the layout gives it.
        width: min(root.width, root.preferred-width);
        enabled: root.browse != "";
        mouse-cursor: root.browse != "" ? pointer : default;
        clicked => { root.open(root.browse); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// A subtitle with links in it. The line is drawn as one text, so it elides
// at the end like any other. Each link lays a click area over its own
// words, placed by measuring the text before it.
component RunLine inherits Rectangle {
    // Empty means plain text: `text` shows and nothing links.
    in property <[Run]> runs;
    in property <string> text;
    in property <color> text-color: Theme.dim;
    in property <color> hover-color: Theme.text;
    in property <length> font-size: 14px;
    callback open(string);
    callback menu(length, length);
    property <string> line: root.runs.length > 0
        ? root.runs[root.runs.length - 1].before + root.runs[root.runs.length - 1].text
        : root.text;
    // How wide the whole line is when nothing is cut off.
    out property <length> line-width: base.preferred-width;
    // How many of the links are under the mouse: zero or one.
    property <int> hot;
    // A link is under the mouse, which the row around it no longer sees.
    out property <bool> hovered: root.hot > 0 && !Scroll.active;
    // A link removed while under the mouse never says it left. New text
    // means new links, so start the count again.
    changed line => { root.hot = 0; }
    // One text for the whole line. A second copy for the link under the
    // mouse never lined up exactly with it, so the whole line brightens.
    base := Text {
        width: 100%;
        height: 100%;
        text: root.line;
        color: root.hot > 0 && !Scroll.active ? root.hover-color : root.text-color;
        font-size: root.font-size;
        overflow: elide;
        vertical-alignment: center;
    }
    for run in root.runs: Rectangle {
        // An empty text still measures a few pixels wide, so a link at the
        // start of the line would sit (and underline) past its words.
        x: run.before == "" ? 0px : lead.preferred-width;
        y: 0;
        width: max(0px, min(piece.preferred-width, root.width - self.x));
        height: root.height;
        visible: run.browse != "" && self.x < root.width - 12px;
        lead := Text {
            text: run.before;
            font-size: root.font-size;
            visible: false;
        }
        piece := Text {
            text: run.text;
            font-size: root.font-size;
            visible: false;
        }
        // Under the mouse the link is underlined just below its letters.
        if (hit.has-hover && !Scroll.active): Rectangle {
            x: 0;
            // The baseline sits about a third of the font size below the
            // middle of a centred line.
            y: round((parent.height / 1px) / 2 + (root.font-size / 1px) * 0.36 + 1) * 1px;
            width: parent.width;
            height: 1px;
            background: root.hover-color;
        }
        hit := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => { root.hot += self.has-hover ? 1 : -1; }
            clicked => { root.open(run.browse); }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
}

// A small sound wave, as five bars, for a transition set by hand. The
// icon font has no such glyph, so it is drawn.
component WaveIcon inherits Rectangle {
    in property <color> tint: Theme.text;
    width: 13px;
    height: 14px;
    for bar[i] in [0.45, 0.8, 1.0, 0.65, 0.4]: Rectangle {
        x: i * 2.75px;
        y: (parent.height - self.height) / 2;
        width: 1.5px;
        height: parent.height * bar;
        border-radius: 0.75px;
        background: root.tint;
    }
}

// The round play button at the top of a page. Usually a solid disc in the
// accent colour with a dark triangle; in mix mode a brushed metal disc in a
// glowing ring. The two fade into each other as mix mode turns on or off.
component PlayDisc inherits Rectangle {
    in property <bool> playing;
    in property <bool> mixed;
    in property <length> size: 56px;
    in property <string> tip;
    callback clicked;
    width: size;
    height: size;
    property <float> mix-level: mixed ? 1 : 0;
    animate mix-level { duration: 300ms; easing: ease-in-out; }
    property <bool> hot: (touch.has-hover && !Scroll.active);
    // The usual look.
    Rectangle {
        opacity: 1 - root.mix-level;
        visible: self.opacity > 0.01;
        border-radius: root.size / 2;
        background: touch.pressed ? Theme.accent.darker(0.1) : root.hot ? Theme.accent.brighter(0.12) : Theme.accent;
        animate background { duration: 120ms; }
        Icon {
            text: root.playing ? Icons.pause : Icons.play;
            fill: true;
            color: #000000;
            font-size: root.size * 0.4;
        }
    }
    // Mix mode: the ring glows, and a thin dark line parts it from the
    // silver rim of the metal.
    Rectangle {
        opacity: root.mix-level;
        visible: self.opacity > 0.01;
        border-radius: root.size / 2;
        background: root.hot ? Theme.accent.brighter(0.15) : Theme.accent;
        drop-shadow-blur: root.hot ? 16px : 11px;
        drop-shadow-color: Theme.accent.with-alpha(root.hot ? 0.8 : 0.6);
        animate background, drop-shadow-blur, drop-shadow-color { duration: 150ms; }
        Rectangle {
            width: root.size - 6px;
            height: self.width;
            border-radius: self.width / 2;
            background: #141414;
            // The rim: lit at the top left and the bottom right.
            Rectangle {
                width: root.size - 8px;
                height: self.width;
                border-radius: self.width / 2;
                background: @conic-gradient(#8e8e94 0deg, #c9c9ce 45deg, #6a6a70 90deg, #e6e6ea 140deg, #8a8a90 200deg, #5c5c62 270deg, #d8d8dc 315deg, #8e8e94 360deg);
                // Brushed metal: light bands on the diagonal, dark across the middle.
                Rectangle {
                    width: root.size - 12px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: @conic-gradient(#4a464c 0deg, #5e5a60 30deg, #2a272b 80deg, #1d1b1e 95deg, #6a666c 125deg, #a6a3a8 140deg, #5a565c 170deg, #3e3a40 220deg, #2a272b 265deg, #1d1b1e 275deg, #6a666c 305deg, #a6a3a8 320deg, #5a565c 345deg, #4a464c 360deg);
                    Icon {
                        text: root.playing ? Icons.pause : Icons.play;
                        fill: true;
                        color: #ffffff;
                        font-size: root.size * 0.46;
                    }
                }
            }
        }
    }
    TipSource {
        tip: root.tip;
        hovered: (touch.has-hover && !Scroll.active);
        pressed: touch.pressed;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// An icon on its own in the row under a page's title: dim, white under the
// mouse, in the accent colour when on.
component HeroIcon inherits Rectangle {
    in property <string> icon;
    in property <bool> fill;
    in property <bool> on;
    // A small dot under it while on, for a mode like mix.
    in property <bool> dot;
    in property <length> size: 26px;
    in property <string> tip;
    out property <bool> hovered: (touch.has-hover && !Scroll.active);
    out property <color> tint: root.on ? ((touch.has-hover && !Scroll.active) ? Theme.accent.brighter(0.15) : Theme.accent) : (touch.has-hover && !Scroll.active) ? #ffffff : #ffffffb3;
    callback clicked;
    width: 40px;
    height: 40px;
    if root.icon != "": Icon {
        text: root.icon;
        fill: root.fill;
        color: root.tint;
        font-size: root.size;
        animate color { duration: 120ms; }
    }
    @children
    if root.dot && root.on: Rectangle {
        x: (parent.width - 4px) / 2;
        y: parent.height - 3px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: root.tint;
    }
    TipSource {
        tip: root.tip;
        hovered: (touch.has-hover && !Scroll.active);
        pressed: touch.pressed;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Three mixer faders, each with its knob at a different height: the Mix
// button's icon, as Spotify draws it.
component SlidersIcon inherits Rectangle {
    in property <color> tint: Theme.text;
    in property <length> size: 16px;
    property <float> k: root.size / 16px;
    width: size;
    height: size;
    for knob[i] in [0.3, 0.7, 0.45]: Rectangle {
        x: (2px + i * 5.5px) * root.k;
        Rectangle {
            x: 0;
            y: 1px * root.k;
            width: 1.5px * root.k;
            height: root.height - 2px * root.k;
            border-radius: 0.75px * root.k;
            background: root.tint;
        }
        Rectangle {
            x: -2.25px * root.k;
            y: (1px + 14px * knob - 1px) * root.k;
            width: 6px * root.k;
            height: 2px * root.k;
            border-radius: 1px * root.k;
            background: root.tint;
        }
    }
}

// The small E that marks a song explicit, as Spotify draws it.
component ExplicitBadge inherits VerticalLayout {
    alignment: center;
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 3px;
        background: #ffffff1a;
        Text {
            text: "E";
            color: #ebebeb;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component SongRow inherits Rectangle {
    in property <ItemData> item;
    in property <bool> current;
    // 0 draws no number. Otherwise the 1-based track number sits before the title.
    in property <int> number;
    in property <bool> show-art: true;
    // A chart: the number column is wider, for the up or down mark.
    in property <bool> wide-number;
    property <length> num-w: root.wide-number ? 46px : 28px;
    // The album in a column before the length, for playlists on a wide window.
    in property <bool> show-album;
    // Mix mode: BPM and key columns, and the transition chip under the row.
    in property <bool> mixing;
    in property <string> bpm;
    in property <string> camelot;
    in property <color> key-color;
    in property <string> mix-label;
    // How open the gap under the row is, 0 to 1, as mix mode turns on or off.
    in property <float> mix-level;
    in property <int> analysis;
    in property <float> analysis-progress;
    // The Analyse now button on a song that is queued or not yet analyzed.
    callback analyse-now;
    // A suggestion: an Add button where the length would be.
    in property <bool> addable;
    callback add;
    callback edit-mix;
    // Plays the end of this song into the next, through the transition.
    callback preview-mix;
    callback activated;
    // The play button: plays the song, or pauses it if it is playing.
    callback play;
    // The mouse has stayed on the row a moment: it may be played soon.
    callback rested;
    callback open(string);
    // A right click, at window coordinates.
    callback menu(length, length);
    property <bool> is-now: Now.is-current(item.key);
    // The mouse over a button or link inside the row leaves the row's own
    // touch area, so each of those says when it has the mouse too.
    property <bool> num-hot;
    property <bool> art-hot;
    property <bool> sub-hot;
    property <bool> album-hot;
    // Held while scrolling: see Scroll.
    property <bool> hovered: !Scroll.active && ((touch.has-hover && !Scroll.active) || root.num-hot || root.art-hot || root.sub-hot || root.album-hot);
    // A row reused for another song starts clean: a part removed while under
    // the mouse never says it left.
    property <string> key: item.key;
    changed key => {
        root.num-hot = false;
        root.art-hot = false;
        root.sub-hot = false;
        root.album-hot = false;
    }
    property <length> base: number > 0 && !show-art ? 48px : 56px;
    // Keep the gap in step with the row heights the page list reserves.
    height: root.base + (root.mix-label != "" ? 34px * root.mix-level : 0px);
    // Faded while there is nothing to play, and brightening once there is.
    opacity: root.item.pending ? 0.4 : 1;
    animate opacity { duration: 250ms; }
    Timer {
        interval: 350ms;
        running: root.hovered;
        triggered => { root.rested(); }
    }
    // Only the song itself lights up, not the transition gap under it.
    Rectangle {
        y: 0;
        height: root.base;
        border-radius: 10px;
        background: root.current ? #ffffff14 : root.hovered ? Theme.hover : transparent;
        animate background { duration: 120ms; }
    }
    touch := TouchArea {
        y: 0;
        height: root.base;
        mouse-cursor: root.item.pending ? default : pointer;
        clicked => {
            if !root.item.pending { root.activated(); }
        }
        pointer-event(event) => {
            if !root.item.pending && event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        y: 0;
        height: root.base;
        padding-left: 8px;
        padding-right: 14px;
        spacing: 12px;
        if root.number > 0: Rectangle {
            width: root.num-w;
            // A chart's mark: up green, down red, level a grey dot.
            if item.trend != 0 && !(root.hovered || root.is-now): Rectangle {
                x: 2px;
                width: 12px;
                if item.trend == 1: Path {
                    width: 12px;
                    height: 8px;
                    commands: "M 6 0 L 12 8 L 0 8 Z";
                    fill: #3ec46d;
                }
                if item.trend == 2: Path {
                    width: 12px;
                    height: 8px;
                    commands: "M 0 0 L 12 0 L 6 8 Z";
                    fill: #ff4f5e;
                }
                if item.trend == 3: Rectangle {
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: Theme.faint;
                }
            }
            Text {
                x: root.wide-number ? 14px : 0px;
                width: parent.width - self.x;
                text: root.hovered || root.is-now ? "" : root.number;
                color: root.current ? Theme.accent : Theme.dim;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.is-now && !root.hovered: Bars {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                running: Now.playing;
            }
            if root.hovered: Icon {
                text: root.is-now && Now.playing ? Icons.pause : Icons.play;
                fill: true;
                font-size: 15px;
            }
            // Always there: made only while the row had the mouse, it took
            // the mouse from the row, vanished, and came back, so it
            // flickered and could not be clicked.
            TouchArea {
                mouse-cursor: pointer;
                changed has-hover => { root.num-hot = self.has-hover; }
                clicked => { root.play(); }
            }
        }
        if root.show-art: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                Art {
                    width: 100%;
                    height: 100%;
                    corner: 6px;
                    source: item.art;
                    has: item.has-art;
                    round: item.round;
                }
                // With no number column, the play button sits on the art.
                if root.number == 0 && (root.hovered || root.is-now): Rectangle {
                    border-radius: item.round ? 20px : 6px;
                    background: #000000a0;
                    if root.is-now && !(art-touch.has-hover && !Scroll.active): Bars {
                        tint: #ffffff;
                        running: Now.playing;
                    }
                    if (art-touch.has-hover && !Scroll.active) || !root.is-now: Icon {
                        text: root.is-now && Now.playing ? Icons.pause : Icons.play;
                        fill: true;
                        color: #ffffff;
                        font-size: 16px;
                    }
                }
                art-touch := TouchArea {
                    enabled: root.number == 0;
                    mouse-cursor: pointer;
                    changed has-hover => { root.art-hot = self.has-hover; }
                    clicked => { root.play(); }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3px;
            // With no subtitle, as on an album, the E follows the title.
            // Placed by hand, so the title can elide before it.
            title-line := Rectangle {
                property <bool> badge: item.explicit && item.subtitle == "";
                height: title.preferred-height;
                title := Text {
                    x: 0;
                    width: min(self.preferred-width, parent.width - (parent.badge ? 16px + 6px : 0px));
                    text: item.title;
                    color: current || root.is-now ? Theme.accent : Theme.text;
                    font-size: 16px;
                    font-weight: 500;
                    overflow: elide;
                }
                if title-line.badge: ExplicitBadge {
                    x: title.width + 6px;
                    y: (title-line.height - 16px) / 2;
                    height: 16px;
                }
            }
            if item.subtitle != "": HorizontalLayout {
                height: 18px;
                spacing: 5px;
                if item.explicit: ExplicitBadge {}
                RunLine {
                    text: item.subtitle;
                    runs: root.show-album ? item.short-runs : item.runs;
                    changed hovered => { root.sub-hot = self.hovered; }
                    open(b) => { root.open(b); }
                    menu(x, y) => { root.menu(x, y); }
                }
            }
        }
        if root.mixing && root.analysis == 0: Text {
            width: 52px;
            text: root.bpm;
            color: Theme.dim;
            font-size: 14px;
            vertical-alignment: center;
        }
        // Not known yet: the tempo and key columns say why, as one.
        if root.mixing && root.analysis != 0: Rectangle {
            width: 52px + 12px + 44px;
            // Queued or not yet analyzed: hovering offers to do it now. The
            // label and the button take the same room, so nothing moves.
            analyse-area := TouchArea {
                enabled: root.analysis >= 2;
                mouse-cursor: root.analysis >= 2 ? MouseCursor.pointer : MouseCursor.default;
                clicked => { root.analyse-now(); }
            }
            Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: root.analysis == 1 ? "Analysing " + round(root.analysis-progress * 100) + "%"
                    : analyse-area.has-hover ? "Analyse now"
                    : root.analysis == 2 ? "Queued" : "After a play";
                color: root.analysis == 1 ? Theme.text : analyse-area.has-hover ? Theme.accent : Theme.faint;
                font-size: 13px;
                font-italic: root.analysis == 3 && !analyse-area.has-hover;
                vertical-alignment: center;
                overflow: elide;
            }
            // The bar along the bottom of the cell while it is being analyzed.
            if root.analysis == 1: Rectangle {
                x: 0;
                y: parent.height - 7px;
                width: parent.width;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.faint.with-alpha(0.25);
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.analysis-progress, 0, 1);
                    height: parent.height;
                    border-radius: 1.5px;
                    background: Theme.accent;
                    animate width { duration: 350ms; easing: ease-out; }
                }
            }
        }
        if root.mixing && root.analysis == 0: VerticalLayout {
            width: 44px;
            alignment: center;
            if root.camelot != "": Rectangle {
                width: key-text.preferred-width + 10px;
                height: 20px;
                border-radius: 5px;
                background: root.key-color;
                key-text := Text {
                    text: root.camelot;
                    color: #101014;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if root.show-album: LinkText {
            width: root.width * 0.24;
            text: item.album;
            browse: item.album-browse;
            changed hovered => { root.album-hot = self.hovered; }
            open(b) => { root.open(b); }
            menu(x, y) => { root.menu(x, y); }
        }
        // As wide as the download slot and the length, so the columns
        // before it line up with the list above.
        if root.addable: VerticalLayout {
            width: 14px + 12px + 40px;
            alignment: center;
            Rectangle {
                x: parent.width - self.width;
                width: 62px;
                height: 32px;
                border-radius: 16px;
                border-width: 1px;
                border-color: (add-touch.has-hover && !Scroll.active) ? Theme.text : #ffffff80;
                background: add-touch.pressed ? #ffffff14 : transparent;
                Text {
                    text: "Add";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                add-touch := TouchArea {
                    mouse-cursor: pointer;
                    changed has-hover => { root.album-hot = self.has-hover; }
                    clicked => { root.add(); }
                }
            }
        }
        // Saved on this computer. The slot is always there, so a downloaded
        // song does not push its album out of line with the rows around it.
        if !root.addable: VerticalLayout {
            alignment: center;
            width: 14px;
            if item.downloaded: Icon {
                height: 14px;
                text: Icons.download;
                fill: true;
                color: Theme.accent;
                font-size: 15px;
            }
            if item.downloading: DownloadRing {
                progress: item.progress;
            }
        }
        if !root.addable: Text {
            width: 40px;
            text: item.duration;
            color: Theme.dim;
            font-size: 14px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    // The transition into the next song, in the gap under this one: a line
    // from this song's art down to the next one's, with the chip on it.
    if root.mix-level > 0.01 && root.mix-label != "": Rectangle {
        opacity: root.mix-level;
        property <length> art-x: root.number > 0 ? 8px + root.num-w + 12px : 8px;
        property <length> art-bottom: (root.base + 40px) / 2;
        Rectangle {
            x: parent.art-x + 20px;
            y: parent.art-bottom;
            width: 1px;
            // On to where the next song's art starts.
            height: root.height - parent.art-bottom + (root.base - 40px) / 2;
            background: #ffffff59;
        }
        // The gap under the row, apart from the row, so it does not light it.
        gap-touch := TouchArea {
            y: root.base;
            height: root.height - root.base;
        }
        // In the number column, beside the chip, while the row or the gap
        // has the mouse.
        if root.number > 0 && (root.hovered || (gap-touch.has-hover && !Scroll.active) || (chip-touch.has-hover && !Scroll.active) || (preview-touch.has-hover && !Scroll.active)): Rectangle {
            x: 8px;
            y: root.base + (root.height - root.base - self.height) / 2;
            width: 28px;
            height: 20px;
            border-radius: 10px;
            background: (preview-touch.has-hover && !Scroll.active) ? #ffffff24 : transparent;
            Icon {
                text: Icons.play;
                fill: true;
                color: (preview-touch.has-hover && !Scroll.active) ? Theme.text : Theme.dim;
                font-size: 11px;
            }
        }
        TipSource {
            x: 8px;
            y: root.base;
            width: root.number > 0 ? 28px : 0px;
            height: root.height - root.base;
            tip: "Preview the transition";
            hovered: (preview-touch.has-hover && !Scroll.active);
            pressed: preview-touch.pressed;
        }
        preview-touch := TouchArea {
            x: 8px;
            y: root.base;
            width: root.number > 0 ? 28px : 0px;
            height: root.height - root.base;
            mouse-cursor: pointer;
            clicked => { root.preview-mix(); }
        }
        chip := Rectangle {
            x: parent.art-x;
            y: root.base + (root.height - root.base - self.height) / 2;
            // Padding, the icon, a gap, the label, padding.
            width: 9px + 12px + 5px + chip-label.preferred-width + 10px;
            height: 20px;
            border-radius: 10px;
            background: chip-touch.pressed ? #3a3a42 : (chip-touch.has-hover && !Scroll.active) ? #34343b : #26262c;
            border-width: 1px;
            border-color: (chip-touch.has-hover && !Scroll.active) ? #ffffff30 : #ffffff14;
            animate background, border-color { duration: 120ms; }
            if root.mix-label == "Auto": Icon {
                x: 9px;
                width: 12px;
                text: Icons.sparkle;
                fill: false;
                color: Theme.accent;
                font-size: 11px;
            }
            if root.mix-label != "Auto": WaveIcon {
                x: 9px;
                tint: Theme.text;
            }
            chip-label := Text {
                x: 9px + 12px + 5px;
                width: self.preferred-width;
                text: root.mix-label;
                color: Theme.text;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
            TipSource {
                tip: "Edit the transition";
                hovered: (chip-touch.has-hover && !Scroll.active);
                pressed: chip-touch.pressed;
            }
            chip-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.edit-mix(); }
            }
        }
        // Mixing out of this song right now: a white pulse runs down the
        // line as the mix goes on, splits round both sides of the chip to
        // meet under it, and runs on to the next song, lighting the way
        // behind it. It keeps time on the frame clock, so it glides.
        if Now.fade-from != "" && Now.fade-from == root.item.key: pulse := Rectangle {
            property <duration> length: max(1ms, Now.fade-length * 1ms);
            property <duration> start;
            init => {
                // Joining part way through, as when the list scrolls to it.
                self.start = animation-tick() - Now.fade-progress * self.length;
            }
            property <float> p: clamp((animation-tick() - self.start) / self.length, 0, 1);
            // Fades in at the start and out at the end.
            property <float> env-raw: clamp(min(self.p / 0.06, (1 - self.p) / 0.08), 0, 1);
            opacity: self.env-raw * self.env-raw * (3 - 2 * self.env-raw);
            // The path: down to the chip, round it both ways, down to the
            // next song's art.
            property <length> lx: chip.x + 20px;
            property <length> top: parent.art-bottom;
            property <length> bottom: root.height + (root.base - 40px) / 2;
            property <length> r: chip.height / 2;
            property <length> cy0: chip.y;
            property <length> cy1: chip.y + chip.height;
            property <length> s1l: self.lx - chip.x - self.r;
            property <length> s1r: chip.x + chip.width - self.r - self.lx;
            property <length> arc: 3.14159 * self.r;
            property <length> len-l: 2 * self.s1l + self.arc;
            property <length> len-r: 2 * self.s1r + self.arc;
            property <length> la: self.cy0 - self.top;
            property <length> lb: (self.len-l + self.len-r) / 2;
            property <length> lc: self.bottom - self.cy1;
            property <length> d: self.p * (self.la + self.lb + self.lc);
            // A point on the path `dist` along it, by the left way round the
            // chip, or the right when `right`. Both ways arrive together.
            pure function at-x(dist: length, right: bool) -> length {
                if dist <= self.la || dist >= self.la + self.lb {
                    return self.lx;
                }
                let q = (dist - self.la) / self.lb;
                if !right {
                    let dl = q * self.len-l;
                    if dl < self.s1l { return self.lx - dl; }
                    if dl < self.s1l + self.arc {
                        return chip.x + self.r - self.r * sin((dl - self.s1l) / self.r * 1rad);
                    }
                    return chip.x + self.r + (dl - self.s1l - self.arc);
                }
                let dr = q * self.len-r;
                if dr < self.s1r { return self.lx + dr; }
                if dr < self.s1r + self.arc {
                    return chip.x + chip.width - self.r + self.r * sin((dr - self.s1r) / self.r * 1rad);
                }
                return chip.x + chip.width - self.r - (dr - self.s1r - self.arc);
            }
            pure function at-y(dist: length, right: bool) -> length {
                if dist <= self.la {
                    return self.top + dist;
                }
                if dist >= self.la + self.lb {
                    return self.cy1 + (dist - self.la - self.lb);
                }
                let q = (dist - self.la) / self.lb;
                let along = q * (right ? self.len-r : self.len-l);
                let straight = right ? self.s1r : self.s1l;
                if along < straight { return self.cy0; }
                if along < straight + self.arc {
                    return self.cy0 + self.r - self.r * cos((along - straight) / self.r * 1rad);
                }
                return self.cy1;
            }
            // How far round the chip its edge is lit, 0 to 1.
            property <float> q: clamp((self.d - self.la) / self.lb, 0, 1);
            // The way behind it, faintly lit: the line above the chip, the
            // chip's edge as it is rounded, and the line below.
            Rectangle {
                x: pulse.lx;
                y: pulse.top;
                width: 1px;
                height: min(pulse.d, pulse.la);
                background: #ffffff70;
            }
            Rectangle {
                x: chip.x;
                y: chip.y;
                width: chip.width;
                height: chip.height;
                border-radius: chip.border-radius;
                border-width: 1px;
                border-color: #ffffff.with-alpha(0.55 * pulse.q);
            }
            if pulse.d > pulse.la + pulse.lb: Rectangle {
                x: pulse.lx;
                y: pulse.cy1;
                width: 1px;
                height: pulse.d - pulse.la - pulse.lb;
                background: #ffffff70;
            }
            // A comet each way: a soft glow at the head, then a tail of
            // dots that shrink and fade behind it. Off the chip the two
            // ways share one path, so only one is drawn there.
            for side in 2: Rectangle {
                // The tail: points packed closer than their own size, so they
                // run together into one streak that thins and fades behind
                // the head, round the chip's curve as well as down the line.
                for k in 56: Rectangle {
                    property <length> dist: pulse.d - k * 0.75px;
                    property <float> fade: 1 - k / 56;
                    property <length> size: 0.6px + 1.8px * self.fade;
                    visible: self.dist > 0px && (side == 0 || (self.dist > pulse.la && self.dist < pulse.la + pulse.lb));
                    x: pulse.at-x(self.dist, side == 1) - self.size / 2;
                    y: pulse.at-y(self.dist, side == 1) - self.size / 2;
                    width: self.size;
                    height: self.size;
                    border-radius: self.size / 2;
                    background: #ffffff.with-alpha(0.55 * self.fade * self.fade);
                }
                // The head: a small bright point.
                Rectangle {
                    visible: side == 0 || (pulse.d > pulse.la && pulse.d < pulse.la + pulse.lb);
                    x: pulse.at-x(pulse.d, side == 1) - 1.5px;
                    y: pulse.at-y(pulse.d, side == 1) - 1.5px;
                    width: 3px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: #ffffff;
                }
            }
        }
    }
}

// One side of a sync on the Syncs page: the playlist's cover, badged with
// its service, and beside it its name and the service's. Clicking opens
// the playlist.
component SyncSide inherits Rectangle {
    in property <string> title;
    in property <string> label;
    in property <int> service;
    in property <image> art;
    in property <bool> has-art;
    callback clicked;
    height: 80px;
    border-radius: 10px;
    background: (touch.has-hover && !Scroll.active) ? Theme.hover : #ffffff00;
    animate background { duration: 150ms; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Art {
        x: 8px;
        y: 8px;
        width: 64px;
        height: 64px;
        corner: 6px;
        source: root.art;
        has: root.has-art;
    }
    if root.service > 0: ServiceBadge {
        x: 10px;
        y: 10px;
        size: 18px;
        service: root.service;
    }
    Text {
        x: 84px;
        y: 22px;
        width: root.width - 84px - 8px;
        text: root.title;
        color: Theme.text;
        font-size: 15px;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        x: 84px;
        y: 42px;
        width: root.width - 84px - 8px;
        text: root.label;
        color: Theme.dim;
        font-size: 13px;
        overflow: elide;
    }
}

// The line from a sync's source to its destination. A comet runs along it
// as the one in a mixed playlist runs down to the next song: a bright head
// with a tail of dots that shrink and fade behind it. It sweeps every few
// seconds, and back to back while the pair syncs. Between sweeps nothing
// moves, so the window can rest.
component SyncLine inherits Rectangle {
    in property <bool> busy;
    in property <string> when;
    // Where along its height the line runs: the covers' middle.
    in property <length> line-y: 40px;
    property <length> x0: 6px;
    property <length> x1: root.width - 14px;
    // Each sweep is one step of `sweeps`; `at` follows it smoothly, and the
    // part after the decimal point is how far the comet has got.
    property <int> sweeps;
    property <float> at: root.sweeps;
    animate at { duration: root.busy ? 900ms : 1500ms; easing: ease-in-out; }
    property <float> p: root.at - floor(root.at);
    Timer {
        interval: root.busy ? 1000ms : 4500ms;
        running: true;
        triggered => { root.sweeps += 1; }
    }
    // The line, faint, and an arrowhead into the destination.
    Rectangle {
        x: root.x0;
        y: root.line-y;
        width: root.x1 - root.x0;
        height: 1px;
        background: #ffffff38;
    }
    Icon {
        x: root.x1 - 4px;
        y: root.line-y - self.height / 2;
        width: 14px;
        height: 14px;
        text: Icons.right;
        color: #ffffff60;
        font-size: 14px;
    }
    // The comet, fading in as it leaves and out as it arrives.
    property <float> env: clamp(min(root.p / 0.08, (1 - root.p) / 0.1), 0, 1);
    property <length> head: root.x0 + root.p * (root.x1 - root.x0);
    if root.p > 0.001: Rectangle {
        opacity: root.env * root.env * (3 - 2 * root.env);
        // The way behind it, lit.
        Rectangle {
            x: root.x0;
            y: root.line-y;
            width: root.head - root.x0;
            height: 1px;
            background: #ffffff70;
        }
        for k in 56: Rectangle {
            property <length> dist: root.head - k * 0.75px;
            property <float> fade: 1 - k / 56;
            property <length> size: 0.6px + 1.8px * self.fade;
            visible: self.dist > root.x0;
            x: self.dist - self.size / 2;
            y: root.line-y + 0.5px - self.size / 2;
            width: self.size;
            height: self.size;
            border-radius: self.size / 2;
            background: #ffffff.with-alpha(0.55 * self.fade * self.fade);
        }
        Rectangle {
            x: root.head - 1.5px;
            y: root.line-y + 0.5px - 1.5px;
            width: 3px;
            height: 3px;
            border-radius: 1.5px;
            background: #ffffff;
        }
    }
    // When it last synced, on the line's middle, as the mix chip sits on
    // the line between two songs.
    Rectangle {
        x: (root.x0 + root.x1 - self.width) / 2;
        y: root.line-y - self.height / 2;
        width: 9px + 12px + 5px + when-label.preferred-width + 10px;
        height: 22px;
        border-radius: 11px;
        background: #26262c;
        border-width: 1px;
        border-color: root.busy ? Theme.accent.with-alpha(0.6) : #ffffff14;
        Icon {
            x: 9px;
            width: 12px;
            text: Icons.repeat;
            color: root.busy ? Theme.accent : Theme.dim;
            font-size: 11px;
        }
        when-label := Text {
            x: 9px + 12px + 5px;
            width: self.preferred-width;
            text: root.when;
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// A sync on the Syncs page: source, line, destination, and its actions.
component SyncRowView inherits Rectangle {
    in property <SyncRowData> pair;
    // 0 the source, 1 the destination.
    callback open(int);
    // 0 sync now, 1 undo, 2 review removals, 3 songs not synced, 4 stop.
    callback act(int);
    border-radius: 14px;
    background: #ffffff08;
    height: 96px;
    // One band: source, line, destination, then the actions at the right.
    HorizontalLayout {
        padding: 8px;
        padding-right: 16px;
        spacing: 0px;
        SyncSide {
            min-width: 150px;
            preferred-width: 220px;
            max-width: 260px;
            horizontal-stretch: 1;
            title: root.pair.from-title;
            label: root.pair.from-label;
            service: root.pair.from-service;
            art: root.pair.from-art;
            has-art: root.pair.from-has-art;
            clicked => { root.open(0); }
        }
        SyncLine {
            min-width: 120px;
            preferred-width: 220px;
            max-width: 280px;
            horizontal-stretch: 1;
            busy: root.pair.busy;
            when: root.pair.when;
        }
        SyncSide {
            min-width: 150px;
            preferred-width: 220px;
            max-width: 260px;
            horizontal-stretch: 1;
            title: root.pair.to-title;
            label: root.pair.to-label;
            service: root.pair.to-service;
            art: root.pair.to-art;
            has-art: root.pair.to-has-art;
            clicked => { root.open(1); }
        }
        // Room between, so the actions sit at the right edge.
        Rectangle { horizontal-stretch: 2; }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            if root.pair.held > 0: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Review " + root.pair.held;
                    clicked => { root.act(2); }
                }
            }
            if root.pair.missing > 0: VerticalLayout {
                alignment: center;
                PillButton {
                    text: root.pair.missing + " not synced";
                    clicked => { root.act(3); }
                }
            }
            VerticalLayout {
                alignment: center;
                PillButton {
                    text: root.pair.busy ? "Syncing…" : "Sync now";
                    primary: !root.pair.busy;
                    clicked => { root.act(0); }
                }
            }
            if root.pair.can-undo: VerticalLayout {
                alignment: center;
                HeroIcon {
                    icon: Icons.back;
                    size: 20px;
                    tip: "Undo last sync";
                    clicked => { root.act(1); }
                }
            }
            VerticalLayout {
                alignment: center;
                HeroIcon {
                    icon: Icons.trash;
                    size: 20px;
                    tip: "Stop syncing";
                    clicked => { root.act(4); }
                }
            }
        }
    }
}

// A small bold heading inside a side panel, such as "Next up".
component SectionLabel inherits Text {
    height: 24px;
    color: Theme.text;
    font-size: 16px;
    font-weight: 700;
    vertical-alignment: center;
}

// A song in the queue panel. Click plays it, a right click opens its menu,
// and a press that moves more than a few pixels drags it to a new place.
// While one row is dragged it rides on the pointer, and the rows it passes
// slide aside to open the gap it will drop into.
component QueueRow inherits Rectangle {
    in property <ItemData> item;
    in property <bool> current;
    // Picked up. The list cannot draw one row over the others, so the row
    // hides here and the panel draws a raised copy of it above the list.
    in property <bool> lifted;
    // The raised copy that follows the pointer.
    in property <bool> raised;
    // How far the row steps aside to make room for the one dragged.
    in property <length> shift;
    callback activated;
    callback menu(length, length);
    // How far the pointer has moved since the press, while dragging, and
    // the press's height in the window.
    callback drag(length, length);
    callback drop();
    // The list took the mouse away mid drag, as when the pointer leaves
    // it. The drag carries on from the window; see `drag-catcher`.
    callback loose();
    property <bool> dragging;
    // A drag just ended. The click that comes with its release is not a play.
    property <bool> dropped;
    height: 60px;
    card := Rectangle {
        opacity: root.lifted ? 0 : 1;
        width: root.width;
        height: root.height;
        y: root.lifted ? touch.mouse-y - touch.pressed-y : root.shift;
        // Follows the pointer at once, and eases into place otherwise.
        animate y { duration: root.lifted ? 0ms : 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        border-radius: 8px;
        background: root.raised ? Theme.raised : (touch.has-hover && !Scroll.active) && !root.dragging ? Theme.hover : transparent;
        // Only the raised copy has a shadow. Skia draws one even with no blur.
        drop-shadow-blur: root.raised ? 18px : 0px;
        drop-shadow-offset-y: root.raised ? 6px : 0px;
        drop-shadow-color: root.raised ? #00000070 : transparent;
        animate background { duration: 120ms; }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Art {
                    width: 44px;
                    height: 44px;
                    corner: 6px;
                    source: item.art;
                    has: item.has-art;
                    round: item.round;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text {
                    text: item.title;
                    color: root.current ? Theme.accent : Theme.text;
                    font-size: 16px;
                    font-weight: 500;
                    overflow: elide;
                }
                if item.subtitle != "": Text {
                    text: item.subtitle;
                    color: Theme.dim;
                    font-size: 14px;
                    overflow: elide;
                }
            }
        }
    }
    // Ends a drag once, however the press ended.
    function end-drag() {
        if root.dragging {
            root.dragging = false;
            root.dropped = true;
            root.drop();
        }
    }
    touch := TouchArea {
        // The raised copy only shows. The row in the list does the work.
        enabled: !root.raised;
        mouse-cursor: root.dragging ? grabbing : pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.dragging = false;
                root.dropped = false;
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                root.end-drag();
            }
            if event.kind == PointerEventKind.cancel && root.dragging {
                root.dragging = false;
                root.loose();
            }
        }
        moved => {
            if self.pressed && !root.dragging && abs(self.mouse-y - self.pressed-y) > 6px {
                root.dragging = true;
            }
            if root.dragging {
                root.drag(self.mouse-y - self.pressed-y, self.absolute-position.y + self.pressed-y);
            }
        }
        // Only a press that stayed put plays.
        clicked => {
            if !root.dragging && !root.dropped {
                root.activated();
            }
            root.dropped = false;
        }
    }
}

// A key drawn as a small outlined cap, for the hints atop the search list.
// arrow 1 draws an up arrow, 2 a down arrow, 0 shows the label.
component KeyCap inherits Rectangle {
    in property <string> label;
    in property <int> arrow;
    width: arrow != 0 ? 18px : name.preferred-width + 10px;
    height: 18px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #ffffff40;
    name := Text {
        text: root.arrow != 0 ? "" : root.label;
        color: Theme.dim;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.arrow != 0: Icon {
        text: root.arrow == 1 ? Icons.arrow-up : Icons.arrow-down;
        color: Theme.dim;
        font-size: 12px;
    }
}

// One row in the search list: a completed search or an item.
component SuggestRow inherits Rectangle {
    in property <SuggestData> data;
    in property <bool> highlighted;
    callback clicked;
    callback open(string);
    // Right clicked, at this place in the window.
    callback menu(length, length);
    height: data.kind != 1 ? 48px : 60px;
    border-radius: 8px;
    background: highlighted || (touch.has-hover && !Scroll.active) ? #ffffff14 : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 14px;
        spacing: 12px;
        if root.data.kind != 1: Icon {
            width: 44px;
            text: root.data.kind == 2 ? Icons.recent : Icons.search;
            color: Theme.dim;
            font-size: 20px;
        }
        if root.data.kind != 1: HorizontalLayout {
            alignment: start;
            horizontal-stretch: 1;
            Text {
                text: root.data.head;
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: root.data.tail;
                color: #ffffffcc;
                font-size: 16px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        if root.data.kind == 1: VerticalLayout {
            alignment: center;
            Art {
                width: 44px;
                height: 44px;
                corner: 6px;
                source: root.data.item.art;
                has: root.data.item.has-art;
                round: root.data.item.round;
            }
        }
        if root.data.kind == 1: VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3px;
            Text {
                text: root.data.item.title;
                color: Theme.text;
                font-size: 16px;
                font-weight: 600;
                overflow: elide;
            }
            RunLine {
                height: 18px;
                text: root.data.item.subtitle;
                runs: root.data.item.runs;
                open(b) => { root.open(b); }
            }
        }
    }
}

// The search field with its list of suggestions underneath. It sits at
// window level, above everything, so the list can cover the page.
component SearchBox inherits Rectangle {
    in property <[SuggestData]> rows;
    in property <bool> loading;
    in-out property <string> text;
    // True while the list may show. It shows once something is typed.
    in-out property <bool> open;
    // The row picked with the arrow keys, or -1.
    in-out property <int> highlight: -1;
    // With nothing typed it lists the recent searches, when there are any.
    out property <bool> showing: open && (text != "" || rows.length > 0);
    out property <bool> focused: field.focused;
    callback edited(string);
    callback search(string);
    callback picked(int);
    // An artist or album name in a row was clicked.
    callback open-link(string);
    // A row was right clicked: its index, and where in the window.
    callback menu(int, length, length);
    height: showing ? 54px + list.preferred-height : 48px;

    // Closes the list and lets go of focus. A focused box opens its list
    // whenever focus comes back to it, for instance when a popup closes.
    public function close() {
        root.open = false;
        root.highlight = -1;
        field.blur();
    }

    // Closes the list as a line of its right click menu is picked. The menu
    // gives focus back to the box as it closes, which would open the list
    // again, so the box lets go of that focus once, for a moment.
    property <bool> stay-closed;
    public function close-from-menu() {
        root.stay-closed = true;
        root.close();
    }
    Timer {
        interval: 400ms;
        running: root.stay-closed;
        triggered => { root.stay-closed = false; }
    }

    function pick(index: int) {
        root.close();
        root.picked(index);
    }

    // Puts the cursor in the box, for the search shortcut.
    public function take-focus() {
        root.open = true;
        field.take-focus();
    }

    keys := FocusScope {
        y: 0;
        height: 48px;
        focus-on-click: false;
        capture-key-pressed(event) => {
            if !root.showing {
                return reject;
            }
            if event.text == Key.DownArrow && root.rows.length > 0 {
                root.highlight = root.highlight + 1 >= root.rows.length ? -1 : root.highlight + 1;
                return accept;
            }
            if event.text == Key.UpArrow && root.rows.length > 0 {
                root.highlight = root.highlight - 1 < -1 ? root.rows.length - 1 : root.highlight - 1;
                return accept;
            }
            if event.text == Key.Escape {
                root.close();
                return accept;
            }
            if event.text == Key.Return && root.highlight >= 0 {
                root.pick(root.highlight);
                return accept;
            }
            reject
        }
        field := Field {
            large: true;
            icon: Icons.search;
            placeholder: "Search songs, albums, artists";
            text <=> root.text;
            changed focused => {
                if self.focused && root.stay-closed {
                    root.stay-closed = false;
                    self.blur();
                } else if self.focused {
                    root.open = true;
                }
            }
            edited(text) => {
                root.open = true;
                root.highlight = -1;
                root.edited(text);
            }
            accepted(text) => {
                root.close();
                root.search(text);
            }
        }
    }

    if root.showing: Rectangle {
        y: 54px;
        height: list.preferred-height;
        border-radius: 12px;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000099;
        // Keeps clicks on the list from reaching the page below.
        TouchArea { }
    }
    list := VerticalLayout {
        y: 54px;
        height: self.preferred-height;
        visible: root.showing;
        padding: 6px;
        HorizontalLayout {
            height: 30px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 5px;
            VerticalLayout { alignment: center; KeyCap { arrow: 1; } }
            VerticalLayout { alignment: center; KeyCap { arrow: 2; } }
            Text {
                text: "Navigate";
                color: Theme.dim;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            VerticalLayout { alignment: center; KeyCap { label: "Enter"; } }
            Text {
                text: "Search";
                color: Theme.dim;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        if root.text == "" && root.rows.length > 0: Text {
            height: 28px;
            x: 14px;
            text: "Recent searches";
            color: Theme.dim;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
        if root.loading && root.rows.length == 0: VerticalLayout {
            for i in 6: SkeletonRow {
                seed: i;
            }
        }
        for row[i] in root.rows: SuggestRow {
            data: row;
            highlighted: i == root.highlight;
            clicked => { root.pick(i); }
            open(b) => {
                root.close();
                root.open-link(b);
            }
            menu(x, y) => { root.menu(i, x, y); }
        }
    }
}

// The first result of a search, as a large card: big art, the name, what
// it is and by whom, and a play button.
component TopResult inherits Rectangle {
    in property <ItemData> item;
    callback activated;
    callback play;
    callback menu(length, length);
    property <bool> is-now: Now.is-current(item.key);
    border-radius: 12px;
    background: (touch.has-hover && !Scroll.active) ? #ffffff14 : #ffffff0a;
    animate background { duration: 120ms; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    Art {
        x: 16px;
        y: (parent.height - self.height) / 2;
        width: 112px;
        height: 112px;
        corner: 8px;
        source: root.item.art;
        has: root.item.has-art;
        round: root.item.round;
    }
    VerticalLayout {
        x: 148px;
        width: parent.width - 148px - 84px;
        alignment: center;
        spacing: 6px;
        Text {
            text: root.item.title;
            color: root.is-now ? Theme.accent : Theme.text;
            font-size: 26px;
            font-weight: 800;
            overflow: elide;
        }
        Text {
            text: root.item.subtitle;
            color: Theme.dim;
            font-size: 14px;
            overflow: elide;
        }
    }
    // Shows on hover, or while this result plays.
    Rectangle {
        x: parent.width - 68px;
        y: (parent.height - self.height) / 2;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: (play-touch.has-hover && !Scroll.active) ? #ff6b84 : Theme.accent;
        opacity: (touch.has-hover && !Scroll.active) || (play-touch.has-hover && !Scroll.active) || root.is-now ? 1 : 0;
        animate opacity { duration: 150ms; }
        Icon {
            text: root.is-now && Now.playing ? Icons.pause : Icons.play;
            fill: true;
            color: #ffffff;
            font-size: 20px;
        }
        TipSource {
            tip: root.is-now && Now.playing ? "Pause" : "Play";
            hovered: (play-touch.has-hover && !Scroll.active);
            pressed: play-touch.pressed;
        }
        play-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.play(); }
        }
    }
}

component Card inherits Rectangle {
    in property <ItemData> item;
    callback activated;
    // The play button: plays the item at once, or pauses what is playing.
    callback play;
    property <bool> is-now: Now.is-current(item.key);
    // The mouse has stayed on the card a moment: it may be played soon.
    callback rested;
    callback open(string);
    callback menu(length, length);
    width: 176px;
    Timer {
        interval: 350ms;
        running: (touch.has-hover && !Scroll.active);
        triggered => { root.rested(); }
    }
    height: 232px;
    border-radius: 12px;
    background: (touch.has-hover && !Scroll.active) ? Theme.hover : transparent;
    animate background { duration: 150ms; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    Art {
        x: 10px;
        y: 10px;
        width: 156px;
        height: 156px;
        corner: 10px;
        source: item.art;
        has: item.has-art;
        round: item.round;
    }
    // Which service a playlist lives on, at the art's top left. Large
    // enough, and close enough to the corner, to cover the small icon both
    // services print there on their own covers (YouTube Music's about 12 px
    // across, some 10 to 16 px in; Spotify's a little smaller, nearer the
    // corner), while staying inside the art's rounded corner.
    if item.service > 0: ServiceBadge {
        x: 14px;
        y: 14px;
        size: 26px;
        service: item.service;
    }
    // Shows on hover, and stays while its item plays.
    Rectangle {
        x: 118px;
        y: 118px;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: (play-touch.has-hover && !Scroll.active) ? #ff6b84 : Theme.accent;
        opacity: (touch.has-hover && !Scroll.active) || (play-touch.has-hover && !Scroll.active) || root.is-now ? 1 : 0;
        animate opacity { duration: 150ms; }
        animate background { duration: 120ms; }
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 4px;
        if root.is-now && Now.playing && !(play-touch.has-hover && !Scroll.active): Bars {
            tint: #ffffff;
            running: true;
        }
        if !(root.is-now && Now.playing) || (play-touch.has-hover && !Scroll.active): Icon {
            text: root.is-now && Now.playing ? Icons.pause : Icons.play;
            fill: true;
            color: #ffffff;
            font-size: 18px;
        }
        TipSource {
            tip: root.is-now && Now.playing ? "Pause" : "Play";
            hovered: (play-touch.has-hover && !Scroll.active);
            pressed: play-touch.pressed;
        }
        play-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.play(); }
        }
    }
    Text {
        x: 10px;
        y: 176px;
        width: 156px;
        text: item.title;
        color: Theme.text;
        font-size: 16px;
        font-weight: 600;
        overflow: elide;
        horizontal-alignment: item.round ? center : left;
    }
    if item.runs.length == 0: Text {
        x: 10px;
        y: 200px;
        width: 156px;
        text: item.subtitle;
        color: Theme.dim;
        font-size: 14px;
        overflow: elide;
        horizontal-alignment: item.round ? center : left;
    }
    if item.runs.length > 0: RunLine {
        x: 10px;
        y: 200px;
        width: 156px;
        height: 18px;
        runs: item.runs;
        open(b) => { root.open(b); }
        menu(x, y) => { root.menu(x, y); }
    }
}

// Songs four to a column, three columns across, paging sideways, as YouTube
// Music lays out "Song mixes" and "Quick picks".
component SongGrid inherits Rectangle {
    in property <[ItemData]> cards;
    callback activated(int);
    callback rested(int);
    callback open(string);
    callback menu(int, length, length);
    property <length> row-h: 60px;
    // Three columns fill the width, and none gets narrower than this.
    property <length> col-w: max(280px, (root.width - 8px) / 3);
    height: 4 * self.row-h + 8px;
    clip: true;
    flick := Flickable {
        content-width: max(self.width, ceil(root.cards.length / 4) * root.col-w);
        content-height: self.height;
        animate content-x { duration: 300ms; easing: ease-out; }
        for card[i] in root.cards: cell := Rectangle {
            x: floor(i / 4) * root.col-w;
            y: mod(i, 4) * root.row-h;
            width: root.col-w - 8px;
            height: root.row-h - 4px;
            border-radius: 8px;
            background: (touch.has-hover && !Scroll.active) ? Theme.hover : transparent;
            animate background { duration: 120ms; }
            property <bool> is-now: Now.is-current(card.key);
            Timer {
                interval: 350ms;
                running: (touch.has-hover && !Scroll.active);
                triggered => { root.rested(card.id); }
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.activated(card.id); }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        root.menu(card.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
            Art {
                x: 6px;
                y: (parent.height - self.height) / 2;
                width: 48px;
                height: 48px;
                corner: 6px;
                source: card.art;
                has: card.has-art;
            }
            // Over the art: bars while it plays, a play sign on hover.
            if (touch.has-hover && !Scroll.active) || cell.is-now: Rectangle {
                x: 6px;
                y: (parent.height - 48px) / 2;
                width: 48px;
                height: 48px;
                border-radius: 6px;
                background: #00000080;
                if cell.is-now && Now.playing: Bars {
                    tint: #ffffff;
                    running: true;
                }
                if !(cell.is-now && Now.playing): Icon {
                    text: Icons.play;
                    fill: true;
                    color: #ffffff;
                    font-size: 18px;
                }
            }
            Text {
                x: 66px;
                y: parent.height / 2 - 19px;
                width: parent.width - 72px;
                text: card.title;
                color: cell.is-now ? Theme.accent : Theme.text;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            if card.runs.length == 0: Text {
                x: 66px;
                y: parent.height / 2 + 2px;
                width: parent.width - 72px;
                text: card.subtitle;
                color: Theme.dim;
                font-size: 13px;
                overflow: elide;
            }
            if card.runs.length > 0: RunLine {
                x: 66px;
                y: parent.height / 2 + 2px;
                width: parent.width - 72px;
                height: 18px;
                runs: card.runs;
                text: card.subtitle;
                font-size: 13px;
                open(b) => { root.open(b); }
            }
        }
    }
    if flick.content-x < 0: IconButton {
        x: 4px;
        y: (root.height - 36px) / 2;
        icon: Icons.left;
        size: 20px;
        filled: true;
        tip: "Scroll left";
        clicked => { flick.content-x = min(0px, flick.content-x + root.col-w * 3); }
    }
    if flick.content-x > flick.width - flick.content-width: IconButton {
        x: root.width - 40px;
        y: (root.height - 36px) / 2;
        icon: Icons.right;
        size: 20px;
        filled: true;
        tip: "Scroll right";
        clicked => { flick.content-x = max(flick.width - flick.content-width, flick.content-x - root.col-w * 3); }
    }
}

// A row of music videos: wide frames with a play sign, as YouTube Music
// shows "Music videos for you".
component VideoCarousel inherits Rectangle {
    in property <[ItemData]> cards;
    callback activated(int);
    callback rested(int);
    callback menu(int, length, length);
    property <length> card-w: 288px;
    property <length> art-h: self.card-w * 9 / 16;
    height: self.art-h + 74px;
    clip: true;
    flick := Flickable {
        content-width: max(self.width, root.cards.length * (root.card-w + 16px));
        content-height: self.height;
        animate content-x { duration: 300ms; easing: ease-out; }
        for card[i] in root.cards: frame := Rectangle {
            x: i * (root.card-w + 16px);
            width: root.card-w;
            height: root.height;
            property <bool> is-now: Now.is-current(card.key);
            Timer {
                interval: 350ms;
                running: (touch.has-hover && !Scroll.active);
                triggered => { root.rested(card.id); }
            }
            Art {
                y: 8px;
                width: parent.width;
                height: root.art-h;
                corner: 10px;
                source: card.art;
                has: card.has-art;
            }
            Rectangle {
                y: 8px;
                width: parent.width;
                height: root.art-h;
                border-radius: 10px;
                background: (touch.has-hover && !Scroll.active) ? #00000040 : transparent;
                animate background { duration: 150ms; }
                if frame.is-now && Now.playing: Bars {
                    tint: #ffffff;
                    running: true;
                }
                if !(frame.is-now && Now.playing): Icon {
                    text: Icons.play;
                    fill: true;
                    color: #ffffff;
                    font-size: 36px;
                    opacity: (touch.has-hover && !Scroll.active) || frame.is-now ? 1 : 0.85;
                }
            }
            Text {
                y: root.art-h + 18px;
                width: parent.width;
                text: card.title;
                color: frame.is-now ? Theme.accent : Theme.text;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                y: root.art-h + 40px;
                width: parent.width;
                text: card.subtitle;
                color: Theme.dim;
                font-size: 13px;
                overflow: elide;
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.activated(card.id); }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        root.menu(card.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
        }
    }
    if flick.content-x < 0: IconButton {
        x: 4px;
        y: 8px + (root.art-h - 36px) / 2;
        icon: Icons.left;
        size: 20px;
        filled: true;
        tip: "Scroll left";
        clicked => { flick.content-x = min(0px, flick.content-x + flick.width * 0.8); }
    }
    if flick.content-x > flick.width - flick.content-width: IconButton {
        x: root.width - 40px;
        y: 8px + (root.art-h - 36px) / 2;
        icon: Icons.right;
        size: 20px;
        filled: true;
        tip: "Scroll right";
        clicked => { flick.content-x = max(flick.width - flick.content-width, flick.content-x - flick.width * 0.8); }
    }
}

// Home's moods, such as Relax and Workout. The lit one is the mood showing;
// `explicit` marks it, as chips have no other use for it.
component ChipRow inherits Rectangle {
    in property <[ItemData]> chips;
    callback clicked(int);
    height: 52px;
    clip: true;
    Flickable {
        content-width: max(self.width, strip.preferred-width);
        content-height: self.height;
        strip := HorizontalLayout {
            alignment: start;
            spacing: 8px;
            padding-top: 10px;
            padding-bottom: 10px;
            for chip in root.chips: Rectangle {
                height: 32px;
                width: label.preferred-width + 28px;
                border-radius: 8px;
                background: chip.explicit ? Theme.text : (touch.has-hover && !Scroll.active) ? #ffffff24 : #ffffff14;
                animate background { duration: 120ms; }
                label := Text {
                    text: chip.title;
                    color: chip.explicit ? #08080a : Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.clicked(chip.id); }
                }
            }
        }
    }
}

component Carousel inherits Rectangle {
    in property <[ItemData]> cards;
    callback activated(int);
    callback play(int);
    callback rested(int);
    callback open(string);
    // A card was right clicked: its id and the window coordinates.
    callback menu(int, length, length);
    height: 236px;
    clip: true;
    flick := Flickable {
        content-width: max(self.width, strip.preferred-width);
        content-height: self.height;
        animate content-x { duration: 300ms; easing: ease-out; }
        strip := HorizontalLayout {
            alignment: start;
            for card in root.cards: Card {
                item: card;
                activated => { root.activated(card.id); }
                play => { root.play(card.id); }
                rested => { root.rested(card.id); }
                open(b) => { root.open(b); }
                menu(x, y) => { root.menu(card.id, x, y); }
            }
        }
    }
    if flick.content-x < 0: IconButton {
        x: 4px;
        y: 70px;
        icon: Icons.left;
        size: 20px;
        filled: true;
        tip: "Scroll left";
        clicked => { flick.content-x = min(0px, flick.content-x + flick.width * 0.8); }
    }
    if flick.content-x > flick.width - flick.content-width: IconButton {
        x: root.width - 40px;
        y: 70px;
        icon: Icons.right;
        size: 20px;
        filled: true;
        tip: "Scroll right";
        clicked => { flick.content-x = max(flick.width - flick.content-width, flick.content-x - flick.width * 0.8); }
    }
}

// A thin bar at the right edge of a scrolling area, as Spotify draws it,
// in place of the style's own. Drag it, or click above or below it to jump.
// A page's only row of cards, wrapped onto as many lines as it needs. Each
// card keeps the size it has in a carousel.
export global CardGrid {
    // How many cards fit across `width`.
    public pure function columns(width: length) -> int {
        return max(1, floor(width / 176px));
    }
    public pure function height(width: length, count: int) -> length {
        return ceil(count / columns(width)) * 236px;
    }
}

component CardWrap inherits Rectangle {
    in property <[ItemData]> cards;
    callback activated(int);
    callback play(int);
    callback rested(int);
    callback open(string);
    callback menu(int, length, length);
    property <int> columns: CardGrid.columns(self.width);
    height: CardGrid.height(self.width, root.cards.length);
    for card[i] in root.cards: Card {
        x: mod(i, root.columns) * 176px;
        y: floor(i / root.columns) * 236px;
        item: card;
        activated => { root.activated(card.id); }
        play => { root.play(card.id); }
        rested => { root.rested(card.id); }
        open(b) => { root.open(b); }
        menu(x, y) => { root.menu(card.id, x, y); }
    }
}

component ScrollThumb inherits Rectangle {
    in-out property <length> content-y;
    in property <length> content-height;
    in property <length> view-height;
    // Space kept free at each end, so a rounded corner never cuts it.
    in property <length> inset: 10px;
    property <length> track: max(1px, root.height - root.inset * 2);
    property <length> range: max(0px, root.content-height - root.view-height);
    property <length> thumb: root.range > 0 ? max(40px, root.track * (root.view-height / root.content-height)) : 0px;
    property <length> travel: max(1px, root.track - root.thumb);
    property <length> at: root.range > 0 ? max(0px, min(root.travel, -root.content-y / root.range * root.travel)) : 0px;
    property <length> drag-from;
    width: 14px;
    visible: root.range > 1px;
    Rectangle {
        x: parent.width - self.width - 3px;
        y: root.inset + root.at;
        width: 8px;
        height: root.thumb;
        border-radius: self.width / 2;
        background: touch.pressed ? #ffffff8c : (touch.has-hover && !Scroll.active) ? #ffffff66 : #ffffff40;
        animate background { duration: 120ms; }
    }
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                // Off the thumb: it jumps there, centred on the click.
                if self.mouse-y < root.inset + root.at || self.mouse-y > root.inset + root.at + root.thumb {
                    root.content-y = -max(0px, min(root.range, (self.mouse-y - root.inset - root.thumb / 2) / root.travel * root.range));
                }
                root.drag-from = -root.content-y;
            }
        }
        moved => {
            if self.pressed {
                root.content-y = -max(0px, min(root.range, root.drag-from + (self.mouse-y - self.pressed-y) / root.travel * root.range));
            }
        }
    }
}

component Appear inherits Rectangle {
    callback appeared;
    init => { root.appeared(); }
}

// The title above a shelf. `more` adds a quiet "Show all" button on the right.
component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <bool> more;
    callback more-clicked;
    height: 56px;
    Text {
        x: 8px;
        y: 18px;
        height: 34px;
        width: parent.width - 16px - (root.more ? 96px : 0px);
        text: root.title;
        color: Theme.text;
        font-size: 24px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.more: Rectangle {
        x: parent.width - 92px;
        y: 21px;
        width: 88px;
        height: 28px;
        border-radius: 14px;
        background: (all.has-hover && !Scroll.active) ? Theme.hover : transparent;
        animate background { duration: 120ms; }
        Text {
            text: "Show all";
            color: (all.has-hover && !Scroll.active) ? Theme.text : Theme.dim;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        all := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.more-clicked(); }
        }
    }
}

// "# Title  Album" above a track list. The offsets match SongRow's columns.
// One column title in a track list. A click sorts the list by it.
component ColumnTitle inherits Rectangle {
    in property <string> text;
    in property <bool> centred;
    // 0 not sorted by this column, 1 rising, 2 falling.
    in property <int> order;
    callback clicked;
    HorizontalLayout {
        alignment: root.centred ? center : start;
        spacing: 4px;
        label := Text {
            text: root.text;
            color: root.order > 0 ? Theme.accent : (touch.has-hover && !Scroll.active) ? Theme.text : Theme.faint;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.order > 0: Icon {
            text: root.order == 1 ? Icons.arrow-up : Icons.arrow-down;
            color: Theme.accent;
            font-size: 12px;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TrackColumns inherits Rectangle {
    in property <bool> show-art;
    // A chart: the number column is wider, as in SongRow.
    in property <bool> wide-number;
    property <length> num-w: root.wide-number ? 46px : 28px;
    in property <bool> show-album;
    in property <bool> mixing;
    // Where the BPM and key columns start: before the album, or before the
    // download slot and the length without one.
    property <length> key-x: root.width - 14px - 40px - 12px - 14px - 12px - (root.show-album ? root.width * 0.24 + 12px : 0px) - 44px;
    // The column the list is sorted by: 0 #, 1 title, 2 album, 3 BPM, 4 key.
    in property <int> sort-column;
    in property <bool> sort-descending;
    callback sort(int);
    height: 32px;
    ColumnTitle {
        x: 8px;
        width: root.num-w;
        height: parent.height;
        text: "#";
        centred: true;
        // The list's own order is the usual one, so it is not marked.
        order: root.sort-column == 0 && root.sort-descending ? 2 : 0;
        clicked => { root.sort(0); }
    }
    ColumnTitle {
        x: root.show-art ? 8px + root.num-w + 12px + 40px + 12px : 8px + root.num-w + 12px;
        width: 160px;
        height: parent.height;
        text: "Title";
        order: root.sort-column == 1 ? (root.sort-descending ? 2 : 1) : 0;
        clicked => { root.sort(1); }
    }
    if root.mixing: ColumnTitle {
        x: root.key-x - 12px - 52px;
        width: 52px;
        height: parent.height;
        text: "BPM";
        order: root.sort-column == 3 ? (root.sort-descending ? 2 : 1) : 0;
        clicked => { root.sort(3); }
    }
    if root.mixing: ColumnTitle {
        x: root.key-x;
        width: 44px;
        height: parent.height;
        text: "Key";
        order: root.sort-column == 4 ? (root.sort-descending ? 2 : 1) : 0;
        clicked => { root.sort(4); }
    }
    if root.show-album: ColumnTitle {
        // padding, length, the download slot and the gaps between them.
        x: parent.width - 14px - 40px - 12px - 14px - 12px - parent.width * 0.24;
        width: 160px;
        height: parent.height;
        text: "Album";
        order: root.sort-column == 2 ? (root.sort-descending ? 2 : 1) : 0;
        clicked => { root.sort(2); }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

// A round button with three dots that opens a menu at itself.
component MoreButton inherits Rectangle {
    // Window coordinates of the button's bottom left corner.
    callback clicked(length, length);
    // Just the dots, dim until the mouse is on them.
    in property <bool> bare;
    in property <string> tip: "More options";
    width: bare ? 40px : 36px;
    height: bare ? 40px : 36px;
    border-radius: 18px;
    background: bare ? transparent : (touch.has-hover && !Scroll.active) ? #ffffff24 : #ffffff14;
    animate background { duration: 120ms; }
    Icon {
        text: Icons.dots;
        fill: true;
        font-size: root.bare ? 26px : 20px;
        color: !root.bare || (touch.has-hover && !Scroll.active) ? #ffffff : #ffffffb3;
    }
    TipSource {
        tip: root.tip;
        hovered: (touch.has-hover && !Scroll.active);
        pressed: touch.pressed;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(self.absolute-position.x, self.absolute-position.y + root.height + 4px); }
    }
}

// The top of an artist, album or playlist page. It is the first row of the
// list, so it scrolls away with it. Everything inside is placed by hand in
// a card of fixed height, so the row never feeds back into the layout.
component DetailHeader inherits Rectangle {
    in property <PageHeader> data;
    in property <color> tint: #2b2440;
    in property <bool> compact;
    // An album's moving cover, faded in over the still art once it plays.
    in property <image> motion;
    in property <bool> motion-on;
    callback play();
    callback shuffle();
    callback mix();
    callback download();
    callback follow();
    callback like();
    callback byline-clicked();
    // A right click or the dots button, at window coordinates.
    callback menu(length, length);
    property <length> pad: Hero.pad(compact);
    property <length> art-size: Hero.art(compact);
    property <bool> banner: data.banner;
    property <bool> side-art: !banner && data.kind != 7;
    property <length> text-x: side-art ? pad + art-size + pad : pad;
    // Softer text for the label and the line under the byline.
    property <color> soft: #ffffffc0;
    // The buttons after Play, left to right, each shown only while the row
    // has room for it and for the dots at the end. The rest go into the
    // dots menu, which Rust fills, so `fit` tells it how many still show:
    // shuffle, mix, follow, save, download, in that order.
    property <length> room: root.width - root.text-x - root.pad;
    property <length> play-w: root.data.can-play ? (root.compact ? 44px : 56px) + 16px : 0px;
    property <length> more-w: 48px;
    property <length> w1: root.data.can-shuffle ? 48px : 0px;
    property <length> w2: root.data.can-mix ? 48px : 0px;
    property <length> w3: root.data.can-follow ? 118px : 0px;
    property <length> w4: root.data.can-like ? 48px : 0px;
    property <length> w5: root.data.download != 0 ? 48px : 0px;
    property <length> used: root.play-w + root.more-w;
    property <bool> show1: root.used + root.w1 <= root.room;
    property <bool> show2: root.show1 && root.used + root.w1 + root.w2 <= root.room;
    property <bool> show3: root.show2 && root.used + root.w1 + root.w2 + root.w3 <= root.room;
    property <bool> show4: root.show3 && root.used + root.w1 + root.w2 + root.w3 + root.w4 <= root.room;
    property <bool> show5: root.show4 && root.used + root.w1 + root.w2 + root.w3 + root.w4 + root.w5 <= root.room;
    out property <int> fit: !root.show1 ? 0 : !root.show2 ? 1 : !root.show3 ? 2 : !root.show4 ? 3 : !root.show5 ? 4 : 5;
    border-radius: 0px;
    background: @linear-gradient(180deg, root.tint.with-alpha(0.78) 0%, root.tint.with-alpha(0.14) 100%);

    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    if root.banner && root.data.has-art: Rectangle {
        border-radius: 0px;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.data.art;
            image-fit: cover;
        }
    }
    // Darkens the bottom of the banner so the text on it reads.
    if root.banner: Rectangle {
        border-radius: 0px;
        background: @linear-gradient(180deg, #00000000 20%, #000000d8 100%);
    }

    // The square or round art, with a soft shadow under it.
    if root.side-art: Rectangle {
        x: root.pad;
        y: root.pad;
        width: root.art-size;
        height: root.art-size;
        border-radius: root.data.round ? root.art-size / 2 : 10px;
        background: #00000040;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000070;
        drop-shadow-offset-y: 8px;
        if !root.data.icon-tile: Art {
            width: 100%;
            height: 100%;
            corner: 10px;
            source: root.data.art;
            has: root.data.has-art;
            round: root.data.round;
        }
        if !root.data.icon-tile && !root.data.round: Rectangle {
            border-radius: 10px;
            clip: true;
            opacity: root.motion-on ? 1 : 0;
            animate opacity { duration: 450ms; }
            Image {
                width: 100%;
                height: 100%;
                source: root.motion;
                image-fit: cover;
            }
        }
        if root.data.icon-tile: Rectangle {
            border-radius: 10px;
            background: @linear-gradient(135deg, #ff4f6d 0%, #8a3ffc 100%);
            Icon {
                text: Icons.download;
                color: #ffffff;
                font-size: parent.width * 0.42;
            }
        }
    }

    // Text and buttons, bottom aligned, so the buttons line up with the
    // bottom of the art.
    Rectangle {
        x: root.text-x;
        y: root.side-art ? root.pad : 0px;
        width: root.width - root.text-x - root.pad;
        height: root.side-art ? root.art-size : root.height - root.pad;
        VerticalLayout {
            alignment: end;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.data.service > 0: ServiceBadge {
                    size: 18px;
                    y: (parent.height - self.height) / 2;
                    service: root.data.service;
                }
                Text {
                    text: root.data.label;
                    color: root.soft;
                    font-size: 14px;
                    font-weight: 700;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.data.title;
                color: #ffffff;
                font-size: root.data.title.character-count > 26 ? (root.compact ? 22px : 34px) : (root.compact ? 28px : 46px);
                font-weight: 800;
                overflow: elide;
            }
            if root.data.byline != "": HorizontalLayout {
                alignment: start;
                height: 20px;
                LinkText {
                    text: root.data.byline;
                    browse: root.data.byline-browsable ? "byline" : "";
                    rest-color: #ffffff;
                    hover-color: Theme.accent;
                    font-size: 14px;
                    font-weight: 700;
                    open => { root.byline-clicked(); }
                    menu(x, y) => { root.menu(x, y); }
                }
            }
            if root.data.meta != "": Text {
                text: root.data.meta;
                color: root.soft;
                font-size: 14px;
                overflow: elide;
            }
            // Spotify's row: the big round play button, then icons alone.
            HorizontalLayout {
                property <length> play-size: root.compact ? 44px : 56px;
                height: play-size + (root.compact ? 2px : 10px);
                padding-top: root.compact ? 2px : 10px;
                spacing: 8px;
                alignment: start;
                if root.data.can-play: VerticalLayout {
                    alignment: center;
                    padding-right: 8px;
                    PlayDisc {
                        size: play-size;
                        playing: Now.page != "" && Now.page == Now.from && Now.playing;
                        mixed: root.data.mixing;
                        tip: self.playing ? "Pause" : "Play";
                        clicked => { root.play(); }
                    }
                }
                if root.data.can-shuffle && root.show1: VerticalLayout {
                    alignment: center;
                    HeroIcon {
                        icon: Icons.shuffle;
                        size: 28px;
                        tip: "Shuffle play";
                        clicked => { root.shuffle(); }
                    }
                }
                if root.data.can-mix && root.show2: VerticalLayout {
                    alignment: center;
                    mix-button := HeroIcon {
                        on: root.data.mixing;
                        dot: true;
                        tip: root.data.mixing ? "Turn off mix" : "Mix";
                        SlidersIcon {
                            size: 22px;
                            tint: mix-button.tint;
                        }
                        clicked => { root.mix(); }
                    }
                }
                if root.data.can-follow && root.show3: VerticalLayout {
                    alignment: center;
                    PillButton {
                        text: root.data.followed ? "Following" : "Follow";
                        clicked => { root.follow(); }
                    }
                }
                if root.data.can-like && root.show4: VerticalLayout {
                    alignment: center;
                    HeroIcon {
                        icon: Icons.heart;
                        fill: root.data.liked;
                        on: root.data.liked;
                        size: 28px;
                        tip: root.data.liked ? "Remove from library" : "Save to library";
                        clicked => { root.like(); }
                    }
                }
                // Saves every song on the page. Filled once all are saved, a
                // ring of how far while they download.
                if root.data.download != 0 && root.show5: VerticalLayout {
                    alignment: center;
                    download-button := HeroIcon {
                        icon: root.data.download == 2 ? "" : Icons.download;
                        fill: root.data.download == 3;
                        on: root.data.download == 3;
                        size: 28px;
                        tip: root.data.download == 3 ? "Downloaded" : root.data.download == 2 ? "Downloading" : "Download all";
                        if root.data.download == 2: DownloadRing {
                            width: 24px;
                            height: 24px;
                            progress: root.data.download-progress;
                        }
                        clicked => { root.download(); }
                    }
                }
                // The page menu offers playing and the artist.
                if root.data.can-play || root.data.can-shuffle || root.data.byline-browsable || root.fit < 5: VerticalLayout {
                    alignment: center;
                    MoreButton {
                        bare: true;
                        clicked(x, y) => { root.menu(x, y); }
                    }
                }
            }
        }
    }
}

component Bar inherits Rectangle {
    in property <float> value;
    in property <bool> live;
    // From here to the end is marked, as where the next song fades in.
    in property <float> zone-from: 1;
    callback picked(float);
    property <float> shown: touch.pressed ? clamp(touch.mouse-x / self.width, 0, 1) : value;
    height: 16px;
    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: #ffffff24;
        if root.zone-from < 1: Rectangle {
            x: parent.width * root.zone-from;
            width: parent.width * (1 - root.zone-from);
            border-radius: 2px;
            background: @linear-gradient(90deg, Theme.accent.with-alpha(0.15) 0%, Theme.accent.with-alpha(0.7) 100%);
        }
        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            border-radius: 2px;
            background: (touch.has-hover && !Scroll.active) || touch.pressed ? Theme.accent : Theme.text;
            animate background { duration: 120ms; }
        }
    }
    Rectangle {
        x: clamp(root.width * root.shown - 6px, 0px, root.width - 12px);
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: #ffffff;
        opacity: (touch.has-hover && !Scroll.active) || touch.pressed ? 1 : 0;
        animate opacity { duration: 120ms; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if (root.live && self.pressed) {
                root.picked(clamp(self.mouse-x / self.width, 0, 1));
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.picked(clamp(self.mouse-x / self.width, 0, 1));
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    // Whether the icon has a filled version to show while selected. The
    // icon font's filled weight lacks some, such as Syncs' arrows.
    in property <bool> can-fill: true;
    // The menu is folded to its icons: the label fades, and shows as a
    // tooltip instead.
    in property <bool> collapsed;
    callback clicked;
    height: 42px;
    clip: true;
    border-radius: 10px;
    background: selected ? #ffffff18 : (touch.has-hover && !Scroll.active) ? Theme.hover : transparent;
    animate background { duration: 120ms; }
    TipSource {
        tip: root.collapsed ? root.label : "";
        // Above or under would cover the next item in the menu.
        beside: true;
        hovered: touch.has-hover;
        pressed: touch.pressed;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Rectangle {
        x: 0;
        y: 12px;
        width: 3px;
        height: 18px;
        border-radius: 2px;
        background: Theme.accent;
        opacity: selected ? 1 : 0;
        animate opacity { duration: 150ms; }
    }
    // Placed by hand, so the label never sizes the item: folded, the item
    // is only as wide as the icon's square, and the icon sits centred in it.
    property <length> icon-x: root.collapsed ? (root.width - 20px) / 2 : 14px;
    animate icon-x { duration: 240ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    // The page you are on shows its icon solid.
    Icon {
        x: root.icon-x;
        width: 20px;
        text: icon;
        fill: root.selected && root.can-fill;
        font-size: 20px;
        color: selected ? Theme.text : Theme.dim;
    }
    Text {
        x: root.icon-x + 20px + 12px;
        width: self.preferred-width;
        text: label;
        color: selected ? Theme.text : Theme.dim;
        font-size: 16px;
        font-weight: selected ? 600 : 500;
        vertical-alignment: center;
        opacity: root.collapsed ? 0 : 1;
        animate opacity { duration: 160ms; }
    }
}

// An entry in Quick access in the side menu: its art, and its name while
// the menu is open.
component PinnedItem inherits Rectangle {
    in property <ItemData> item;
    in property <bool> collapsed;
    callback clicked;
    // A right click, at window coordinates.
    callback menu(length, length);
    height: 42px;
    clip: true;
    border-radius: 10px;
    background: (touch.has-hover && !Scroll.active) ? Theme.hover : transparent;
    animate background { duration: 120ms; }
    TipSource {
        tip: root.collapsed ? root.item.title : "";
        // Above or under would cover the next item in the menu.
        beside: true;
        hovered: touch.has-hover;
        pressed: touch.pressed;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    // Placed by hand like a NavItem's icon, so the name never sizes the item.
    property <length> art-x: root.collapsed ? (root.width - 28px) / 2 : 10px;
    animate art-x { duration: 240ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    Rectangle {
        x: root.art-x;
        y: 7px;
        width: 28px;
        height: 28px;
        border-radius: root.item.round ? 14px : 6px;
        background: #ffffff14;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.item.art;
            image-fit: cover;
        }
    }
    Text {
        x: root.art-x + 28px + 12px;
        width: max(0px, root.width - self.x - 10px);
        text: root.item.title;
        color: Theme.dim;
        font-size: 15px;
        font-weight: 500;
        vertical-alignment: center;
        overflow: elide;
        opacity: root.collapsed ? 0 : 1;
        animate opacity { duration: 160ms; }
    }
}

component SyllableView inherits Rectangle {
    in property <SyllableData> syllable;
    in property <int> time;
    in property <bool> active;
    in property <length> font-size: 24px;
    // How bright words not yet sung are on the sung line.
    in property <float> unsung: 0.4;
    property <float> progress: !active || time <= syllable.start ? 0 : time >= syllable.end ? 1 : 1.0 * (time - syllable.start) / max(1, syllable.end - syllable.start);
    // Sung syllables rise a little, the way Apple Music lifts them.
    property <length> lift: active && time >= syllable.start ? -2px : 0px;
    animate lift { duration: 350ms; easing: ease-out; }
    width: base.preferred-width + (syllable.space ? root.font-size * 0.3 : 0px);
    height: root.font-size * 1.5;
    base := Text {
        x: 0;
        y: root.lift;
        height: 100%;
        text: syllable.text;
        color: active ? #ffffff.with-alpha(root.unsung) : #ffffff;
        font-size: root.font-size;
        font-family: "Figtree";
        font-weight: 700;
        vertical-alignment: center;
    }
    Rectangle {
        x: 0;
        y: root.lift;
        width: base.preferred-width * root.progress;
        height: 100%;
        clip: true;
        Text {
            x: 0;
            width: base.preferred-width;
            height: 100%;
            text: syllable.text;
            color: #ffffff;
            font-size: root.font-size;
            font-family: "Figtree";
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// Where a syllable sits, as SyllableView lays it out, to be clicked. Draws
// nothing.
component SyllableHit inherits Rectangle {
    in property <SyllableData> syllable;
    in property <length> font-size: 24px;
    callback clicked;
    width: measure.preferred-width + (syllable.space ? root.font-size * 0.3 : 0px);
    measure := Text {
        text: syllable.text;
        color: transparent;
        font-size: root.font-size;
        font-family: "Figtree";
        font-weight: 700;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A line of text that can be drawn out of focus. Slint cannot blur, so Rust
// draws the line blurred, a little (`soft`) and a lot (`softer`), and the
// images are faded over the text by `level`: 0 sharp, 1 soft, 2 softer.
// Until the images arrive the line stays sharp.
component BlurText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 24px;
    in property <int> font-weight: 700;
    in property <string> font-family: "Figtree";
    in property <color> text-color: #ffffff;
    in property <TextHorizontalAlignment> align: left;
    in property <float> level;
    in property <image> soft;
    in property <image> softer;
    // The clear room around the letters in each image, and its full height.
    in property <length> soft-pad;
    in property <length> soft-height;
    property <bool> drawn: root.soft.width > 0 && root.softer.width > 0;
    // Where the letters really are, so the images land on them. Stretching
    // the image to this width hides small differences between how Rust and
    // Slint lay the line out.
    measure := Text {
        text: root.text;
        font-family: root.font-family;
        font-size: root.font-size;
        font-weight: root.font-weight;
        visible: false;
    }
    property <length> text-width: min(measure.preferred-width, root.width);
    property <length> text-x: root.align == TextHorizontalAlignment.right ? root.width - root.text-width
        : root.align == TextHorizontalAlignment.center ? (root.width - root.text-width) / 2 : 0px;
    if !root.drawn || root.level < 1: Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: root.text-color;
        opacity: root.drawn ? 1 - root.level : 1;
        font-family: root.font-family;
        font-size: root.font-size;
        font-weight: root.font-weight;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.drawn && root.level > 0 && root.level < 2: Image {
        x: root.text-x - root.soft-pad;
        y: (root.height - root.soft-height) / 2;
        width: root.text-width + root.soft-pad * 2;
        height: root.soft-height;
        source: root.soft;
        image-fit: fill;
        colorize: root.text-color;
        opacity: root.level <= 1 ? root.level : 2 - root.level;
    }
    if root.drawn && root.level > 1: Image {
        x: root.text-x - root.soft-pad;
        y: (root.height - root.soft-height) / 2;
        width: root.text-width + root.soft-pad * 2;
        height: root.soft-height;
        source: root.softer;
        image-fit: fill;
        colorize: root.text-color;
        opacity: root.level - 1;
    }
}

component Dot inherits Rectangle {
    in property <float> level;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: #ffffff;
    opacity: 0.25 + 0.75 * clamp(level, 0, 1);
}

// A layer of the transition picture, drawn at its own size.
component MixPath inherits Path {
    width: 100%;
    height: 100%;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    fill: transparent;
    stroke-width: 0px;
}

// One end of a transition in the editor: art, name, tempo and key.
component MixSongLine inherits HorizontalLayout {
    in property <MixSong> song;
    height: 32px;
    spacing: 10px;
    Art {
        width: 32px;
        height: 32px;
        corner: 4px;
        source: root.song.art;
        has: root.song.has-art;
    }
    Text {
        text: root.song.title + (root.song.artist != "" ? "  \u{2022}  " + root.song.artist : "");
        color: Theme.text;
        font-size: 14px;
        font-weight: 600;
        overflow: elide;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    // The tempo, in orange with a warning mark when the songs cannot be
    // beat matched. The reason shows above it on hover.
    Rectangle {
        width: tempo-row.preferred-width;
        tempo-row := HorizontalLayout {
            spacing: 5px;
            if root.song.warning != "": VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: #f5a524;
                    Text {
                        text: "!";
                        color: #101014;
                        font-size: 11px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Text {
                text: root.song.bpm;
                color: root.song.warning != "" ? #f5a524 : Theme.dim;
                font-size: 13px;
                font-weight: root.song.warning != "" ? 600 : 400;
                vertical-alignment: center;
            }
        }
        tempo-touch := TouchArea { }
        if (tempo-touch.has-hover && !Scroll.active) && root.song.warning != "": Rectangle {
            x: parent.width - self.width;
            y: -self.height - 6px;
            width: tip.preferred-width + 20px;
            height: 28px;
            border-radius: 6px;
            background: #2a2a30;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000080;
            tip := Text {
                text: root.song.warning;
                color: Theme.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    if root.song.camelot != "": VerticalLayout {
        alignment: center;
        Rectangle {
            width: camelot-text.preferred-width + 10px;
            height: 20px;
            border-radius: 5px;
            background: root.song.key-color;
            camelot-text := Text {
                text: root.song.camelot;
                color: #101014;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// A part of a transition and how it is set, as a row with a menu.
component MixChoice inherits Rectangle {
    in property <string> title;
    in property <color> accent;
    in property <[string]> options;
    in-out property <int> selected;
    callback changed(int);
    height: 52px;
    border-radius: 12px;
    background: #ffffff0a;
    Rectangle {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: root.accent;
    }
    Text {
        x: 26px;
        text: root.title;
        color: Theme.text;
        font-size: 15px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Dropdown {
        x: parent.width - self.width - 9px;
        y: (parent.height - self.height) / 2;
        options: root.options;
        menu-min: 300px;
        widest: parent.width - 100px;
        selected <=> root.selected;
        changed(i) => { root.changed(i); }
    }
}

// A switch on the right of a row in the mix editor.
component MixToggle inherits Rectangle {
    in property <string> title;
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled();
    height: 52px;
    border-radius: 12px;
    background: #ffffff0a;
    Text {
        x: 16px;
        text: root.title;
        color: root.enabled ? Theme.text : Theme.faint;
        font-size: 15px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Rectangle {
        x: parent.width - self.width - 16px;
        width: 42px;
        height: 24px;
        border-radius: 12px;
        background: root.on && root.enabled ? Theme.accent : #ffffff30;
        opacity: root.enabled ? 1 : 0.4;
        animate background { duration: 150ms; }
        Rectangle {
            x: root.on && root.enabled ? parent.width - self.width - 3px : 3px;
            animate x { duration: 150ms; easing: ease-out; }
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: #ffffff;
        }
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.toggled(); }
        }
    }
}

// A line of the cast menu: a device, or this computer. `kind` as in
// CastDevice, with 3 for this computer. The icons are drawn, as the icon
// font has none for devices.
component CastLine inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <int> kind;
    in property <bool> active;
    callback clicked;
    height: 46px;
    border-radius: 8px;
    background: (touch.has-hover && !Scroll.active) ? Theme.hover : transparent;
    Path {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.active ? Theme.accent : Theme.dim;
        stroke-width: 1.6px;
        commands: root.kind == 0
            // a speaker
            ? "M 8 3 L 16 3 A 2 2 0 0 1 18 5 L 18 19 A 2 2 0 0 1 16 21 L 8 21 A 2 2 0 0 1 6 19 L 6 5 A 2 2 0 0 1 8 3 Z M 9 14.5 A 3 3 0 1 0 15 14.5 A 3 3 0 1 0 9 14.5 M 11 8 A 1 1 0 1 0 13 8 A 1 1 0 1 0 11 8"
            : root.kind == 1
            // a TV on its stand
            ? "M 4 4 L 20 4 A 2 2 0 0 1 22 6 L 22 15 A 2 2 0 0 1 20 17 L 4 17 A 2 2 0 0 1 2 15 L 2 6 A 2 2 0 0 1 4 4 Z M 8 21 L 16 21 M 12 17 L 12 21"
            : root.kind == 2
            // two speakers
            ? "M 4 4 L 9 4 A 1.5 1.5 0 0 1 10.5 5.5 L 10.5 18.5 A 1.5 1.5 0 0 1 9 20 L 4 20 A 1.5 1.5 0 0 1 2.5 18.5 L 2.5 5.5 A 1.5 1.5 0 0 1 4 4 Z M 15 4 L 20 4 A 1.5 1.5 0 0 1 21.5 5.5 L 21.5 18.5 A 1.5 1.5 0 0 1 20 20 L 15 20 A 1.5 1.5 0 0 1 13.5 18.5 L 13.5 5.5 A 1.5 1.5 0 0 1 15 4 Z M 4.5 14 A 2 2 0 1 0 8.5 14 A 2 2 0 1 0 4.5 14 M 15.5 14 A 2 2 0 1 0 19.5 14 A 2 2 0 1 0 15.5 14"
            // a laptop
            : "M 5 5 L 19 5 A 1 1 0 0 1 20 6 L 20 16 L 4 16 L 4 6 A 1 1 0 0 1 5 5 Z M 2 19 L 22 19";
    }
    Text {
        x: 44px;
        y: root.subtitle == "" ? (parent.height - self.height) / 2 : 6px;
        width: parent.width - 44px - 26px;
        height: 18px;
        text: root.title;
        color: root.active ? Theme.accent : Theme.text;
        font-size: 14px;
        font-weight: root.active ? 600 : 400;
        overflow: elide;
        vertical-alignment: center;
    }
    if root.subtitle != "": Text {
        x: 44px;
        y: 24px;
        width: parent.width - 44px - 26px;
        height: 16px;
        text: root.subtitle;
        color: Theme.dim;
        font-size: 12px;
        overflow: elide;
        vertical-alignment: center;
    }
    if root.active: Rectangle {
        x: parent.width - 16px;
        y: (parent.height - self.height) / 2;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.accent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "Tonearm";
    // Takes the keys whenever no text box has the cursor. The app gives
    // it focus back when nothing else holds it.
    hotkeys := FocusScope {
        width: 0;
        height: 0;
        focus-on-click: false;
        init => { self.focus(); }
        key-pressed(event) => {
            if root.hotkey(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt) {
                return accept;
            }
            reject
        }
    }
    icon: @image-url("logo.svg");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 820px;
    min-height: 520px;
    // Flipped by the app after the window is restored. The two colours look
    // the same, but the change makes the renderer repaint the whole window.
    in property <bool> repaint;
    background: repaint ? #09090b : Theme.bg;
    default-font-size: 14px;
    default-font-family: Theme.font;

    // page
    in property <[RowData]> rows;
    in property <string> page-title;
    // The tab on a search results page, or -1 when not on one.
    in property <int> search-tab: -1;
    callback search-tab-picked(int);
    in property <string> page-subtitle;
    in property <bool> page-playable;
    // The hero of an artist, album or playlist page. kind 0 keeps the
    // plain title strip. Before the page arrives, kind is a guess from the
    // link, so the matching skeleton shows.
    in property <PageHeader> header;
    // Colour pulled from the page art. Tints the hero as `tint` tints the player.
    in property <color> page-tint: #2b2440;
    property <color> shown-page-tint: page-tint;
    animate shown-page-tint { duration: 700ms; easing: ease-in-out; }
    callback show-all(int);
    // A mood chip over Home, by its place in the row.
    callback chip-clicked(int);
    callback byline-clicked();
    callback toggle-follow();
    callback toggle-like-page();
    // Mix mode on the open playlist, and the transition chip of a song.
    callback toggle-mix();
    // The download button on a page's hero.
    callback download-page();
    callback edit-mix(int);
    callback analyse-now(int);
    // Plays a song's end into the next through its transition.
    callback preview-mix(int);
    // The editor's play button: the same, with the choices on screen.
    callback mix-preview();

    // The transition editor. Rust fills it from the two songs and redraws
    // the picture whenever a choice changes.
    // The panel it replaced, to go back to.
    property <int> mix-back;
    public function open-mix-panel() {
        if root.panel != 4 {
            root.mix-back = root.panel;
        }
        root.panel = 4;
        root.shown-panel = 4;
    }
    public function close-mix-panel() {
        root.panel = root.mix-back;
        if root.panel != 0 {
            root.shown-panel = root.panel;
        }
    }
    // Leaving the editor with changes not saved asks first. discard-then is
    // what to do after a Discard: -1 close the editor, else open that panel.
    in-out property <bool> discard-open;
    property <int> discard-then: -1;
    function leave-mix-panel(then: int) {
        if root.mix-changed {
            root.discard-then = then;
            root.discard-open = true;
        } else if then < 0 {
            root.close-mix-panel();
        } else {
            root.switch-panel(then);
        }
    }
    in property <MixSong> mix-from;
    in property <MixSong> mix-to;
    // Into `mix-presets`, or -1 for a choice made by hand.
    in property <int> mix-preset;
    in property <[string]> mix-presets;
    in property <[string]> mix-volumes;
    in property <[string]> mix-eqs;
    in property <[string]> mix-filters;
    in property <[string]> mix-effects;
    in property <[string]> mix-loops;
    in property <[string]> mix-lengths;
    in-out property <int> mix-length;
    in-out property <int> mix-volume;
    in-out property <int> mix-eq;
    in-out property <int> mix-filter;
    in-out property <int> mix-effect;
    in-out property <int> mix-loop;
    in property <bool> mix-beatmatch;
    // The song coming in keeps its key as its speed changes to match.
    in property <bool> mix-key-lock;
    // A preview is starting, so the play button shows a spinner, and the
    // spinner's running piece, in a 52 by 40 box.
    in property <bool> mix-loading;
    in property <string> mix-spinner;
    // Seconds across the picture.
    in property <float> mix-span: 1;
    // Whether the two songs can be beat matched at all.
    in property <bool> mix-can-beatmatch: true;
    // A song dragged along by `seconds` of the transition: 0 the one going
    // out, 1 the one coming in. Exact, with Shift held, skips the snap to
    // the nearest beat.
    callback mix-dragged(int, float, bool);
    in property <bool> mix-changed;
    // Paths in the picture: the song going out above, coming in below. Each
    // song's sound, and its bass alone.
    in property <string> mix-out-wave;
    in property <string> mix-out-low;
    in property <string> mix-in-wave;
    in property <string> mix-in-low;
    // Where the transition starts and ends across the picture, 0 to 1.
    in property <float> mix-card-from;
    in property <float> mix-card-to;
    in property <string> mix-volume-path;
    in property <string> mix-bass-path;
    in property <string> mix-filter-path;
    // How much of the song going out feeds the effect.
    in property <string> mix-fx-path;

    // Faint lines down the picture, fixed to the transition: bars, and the
    // beats between them.
    in property <string> mix-bars-path;
    in property <string> mix-beats-path;
    // A preview's playhead: where it was, 0 to 1 across the picture, how
    // far it moves a second, and when. Below -5 when none plays.
    in-out property <float> mix-head-at: -10;
    in-out property <float> mix-head-rate;
    in-out property <duration> mix-head-stamp;
    public function set-playhead(at: float, rate: float) {
        root.mix-head-at = at;
        root.mix-head-rate = rate;
        root.mix-head-stamp = animation-tick();
    }
    // A preview of this transition is playing.
    in property <bool> mix-previewing;
    callback mix-preset-picked(int);
    callback mix-volume-picked(int);
    callback mix-eq-picked(int);
    callback mix-filter-picked(int);
    callback mix-effect-picked(int);
    callback mix-loop-picked(int);
    callback mix-length-picked(int);
    callback mix-beatmatch-toggled();
    callback mix-key-lock-toggled();
    callback mix-save();
    // Opens a page by browse id, for artist and album names.
    callback open-browse(string);
    // The right click menu. Rust fills menu-entries for the item: source 0
    // is a page item by id, 1 a queue entry by index, 2 the playing track,
    // 3 the page itself.
    in property <[MenuEntry]> menu-entries;
    callback item-menu(int, int);
    callback menu-picked(int);
    property <length> menu-x;
    // Where the open menu came from, as show-menu numbers it.
    property <int> menu-source;
    property <length> menu-y;
    property <length> menu-height: 10px + root.menu-entries.length * 34px - 2px;
    // Opens the menu again where it last was, with new entries, such as
    // the list of playlists after "Add to playlist".
    public function reopen-menu() {
        if root.menu-entries.length > 0 {
            context-menu.show();
        }
    }
    // A small box over the window that asks for a name, or to confirm.
    // Rust says what it is for and acts on the answer.
    in-out property <bool> prompt-open;
    in property <string> prompt-title;
    in property <string> prompt-action: "Save";
    // A question with no name to type, such as deleting a playlist.
    in property <bool> prompt-confirm;
    in-out property <string> prompt-text;
    callback prompt-done(string);
    callback new-playlist();
    in property <bool> loading;
    in property <bool> can-back;
    in property <int> nav: 0;
    in property <string> toast;
    // The open page is a chart: its numbers carry up and down marks.
    in property <bool> chart;
    // A button on the toast, such as Update. Empty for none.
    in property <string> toast-action;
    callback toast-clicked();
    in property <bool> signed-in;
    in property <string> account-name;
    in property <image> account-art;
    in property <bool> account-has-art;
    // The profile page, opened from the account box under the nav.
    in property <string> account-handle;
    in property <image> profile-art;
    in property <bool> profile-has-art;
    in property <[ItemData]> profile-played;
    // The artists played most, best first.
    in property <[string]> profile-artists;
    // How many songs, artists, and albums, playlists and artist pages the
    // listening history on this computer holds.
    in property <int> profile-songs;
    in property <int> profile-artist-count;
    in property <int> profile-opened;
    callback open-profile();
    callback profile-played-picked(int);
    callback profile-played-play(int);
    callback profile-artist-picked(int);
    in property <string> settings-note;

    // player
    in property <bool> has-track;
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    // The artist and album line under the title, with links. Empty when
    // nothing in it links anywhere.
    in property <[Run]> track-runs;
    in property <image> track-art;
    in property <bool> track-has-art;
    // The moving cover or Spotify Canvas. It fades in over the still
    // cover, which stays underneath, and fades out to it again.
    in property <image> track-motion;
    // The moving cover in expanded Now playing, which may differ from the
    // panel's: the panel can show a Canvas, and this only Apple's cover.
    in property <image> wide-motion;
    in property <bool> wide-motion-on;
    // An album page's moving cover, over the hero's square art.
    in property <image> page-motion;
    in property <bool> page-motion-on;
    // A heavy blur of the still cover, waved slowly from the app while
    // the expanded view is open. Its background.
    in property <image> track-backdrop;
    in property <bool> track-motion-on;
    // The song going out during a crossfade. Its cover and name stay on
    // show and fade out over the crossfade, as its sound does, while the new
    // song's fade in.
    in property <string> fade-title;
    in property <string> fade-artist;
    in property <image> fade-art;
    in property <bool> fade-has-art;
    // Its Canvas or moving cover, which keeps playing as it fades out.
    in property <image> fade-motion;
    in property <bool> fade-motion-on;
    property <duration> xfade-start;
    // Zero when no crossfade is under way.
    property <duration> xfade-length;
    // How far the crossfade has got, 0 to 1. Only follows the clock while
    // one is under way, so an idle app stays idle.
    property <float> xfade: root.xfade-length > 0ms ? clamp((animation-tick() - root.xfade-start) / root.xfade-length, 0, 1) : 1;
    // Eased at both ends, for the covers' fade.
    property <float> xfade-eased: root.xfade * root.xfade * (3 - 2 * root.xfade);
    // The names swap as the crossfade starts, when the seek bar moves on to
    // the new song: the old one slides up and out, then the new one slides
    // up into place. Quick, and never both at once.
    property <duration> xfade-elapsed: root.xfade-length > 0ms ? animation-tick() - root.xfade-start : 1000s;
    property <float> name-out-raw: clamp(root.xfade-elapsed / 180ms, 0, 1);
    property <float> name-in-raw: clamp((root.xfade-elapsed - 140ms) / 280ms, 0, 1);
    // Eased out, so each starts quick and settles.
    property <float> name-out: 1 - (1 - root.name-out-raw) * (1 - root.name-out-raw);
    property <float> name-in: 1 - (1 - root.name-in-raw) * (1 - root.name-in-raw);
    // The mix animation in Now playing, as Spotify has it: for a crossfade
    // long enough to show it, the outgoing cover shrinks to the left while
    // the next slides in from the right, both side by side through the mix,
    // then the old one is pushed off and the new one grows to fill again.
    property <bool> mix-anim: root.xfade-length >= 2s;
    // Each move eases in from rest and settles to rest, with no overshoot.
    // The cover coming in trails the one going out a little, which makes
    // the pair feel fluid rather than locked together. Unhurried, but
    // shorter when the crossfade is, so both moves fit.
    property <duration> mix-step: min(1800ms, (root.xfade-length - 2 * root.mix-lag) / 2.4);
    property <duration> mix-lag: 140ms;
    // The way out starts early enough that both have settled by the end.
    property <duration> mix-leave-at: root.xfade-length - root.mix-step - root.mix-lag;
    property <float> mix-out-e: root.mix-anim ? root.spring(root.xfade-elapsed / root.mix-step) : 1;
    property <float> mix-in-e: root.mix-anim ? root.spring((root.xfade-elapsed - root.mix-lag) / root.mix-step) : 1;
    property <float> mix-out-l: root.mix-anim ? root.spring((root.xfade-elapsed - root.mix-leave-at) / root.mix-step) : 1;
    property <float> mix-in-l: root.mix-anim ? root.spring((root.xfade-elapsed - root.mix-leave-at - root.mix-lag) / root.mix-step) : 1;
    // For the canvas giving way, which wants no bounce.
    property <float> mix-enter: clamp(root.xfade-elapsed / 500ms, 0, 1);
    // An ease from 0 to 1 that starts from rest and lands at rest
    // (smootherstep), so the mix's moves begin and end softly.
    pure function spring(x: float) -> float {
        if x <= 0 {
            return 0;
        }
        if x >= 1 {
            return 1;
        }
        return x * x * x * (x * (x * 6 - 15) + 10);
    }
    // Canvases rest during the mix, showing the still covers, and the new
    // song's comes back once it is over.
    property <float> mix-hide: root.mix-anim ? 1 : 0;
    animate mix-hide { duration: 450ms; easing: ease-in-out; }
    public function begin-crossfade(seconds: float) {
        root.xfade-start = animation-tick();
        root.xfade-length = max(1ms, seconds * 1s);
    }
    // Any other change of song cuts a crossfade's animation short.
    public function end-crossfade() {
        root.xfade-length = 0ms;
    }
    Timer {
        interval: max(root.xfade-length, 1ms);
        running: root.xfade-length > 0ms;
        triggered => { root.xfade-length = 0ms; }
    }
    // Where on the timeline the crossfade into the next song starts, as a
    // share of the song. 1 when nothing will fade in.
    in property <float> fade-from: 1;
    property <float> motion-t: track-motion-on ? 1 : 0;
    animate motion-t { duration: 450ms; easing: ease-in-out; }
    property <float> wide-motion-t: wide-motion-on ? 1 : 0;
    animate wide-motion-t { duration: 450ms; easing: ease-in-out; }
    in property <bool> playing;
    in property <bool> shuffle;
    // Shuffle that mixes in suggested songs. Only on with shuffle.
    in property <bool> smart-shuffle;
    // 0 off, 1 the whole queue, 2 the one song.
    in property <int> repeat;
    // The playing song's credits, as YouTube Music lists them.
    in property <[CreditData]> track-credits;
    // The playing song's tempo and key, once Tonearm has worked them out.
    in property <[CreditData]> track-sound;
    in property <bool> buffering;
    in property <bool> liked;
    in property <float> progress;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> volume: 1.0;
    // The cast menu: the devices on the network, the one cast to (-1 for
    // none), whether it has started playing, and its name.
    in property <[CastDevice]> cast-devices;
    in property <int> cast-active: -1;
    in property <bool> cast-connecting;
    in property <string> cast-name;
    in property <[ItemData]> queue;
    in property <int> queue-index: -1;
    // The queue after the playing song, for "Next up".
    in property <[ItemData]> up-next;
    // A song dragged from one queue position to another.
    callback queue-moved(int, int);
    // Colour pulled from the playing cover. It tints the player and panel.
    in property <color> tint: #2b2440;
    property <color> shown-tint: tint;
    animate shown-tint { duration: 700ms; easing: ease-in-out; }

    // side panel: 0 closed, 1 queue, 2 lyrics, 3 now playing
    in-out property <int> panel: 0;
    // A drag in "Next up": the row picked up and the gap it would drop
    // into, both counted within up-next. -1 when nothing is dragged.
    // The side panel's background, which the Now playing cover fades into.
    property <color> panel-color: root.shown-tint.mix(Theme.island, 0.42);
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    // How far the dragged row has moved from its place, for its raised copy.
    property <length> drag-offset;
    // The list's scroll, height and content height, so a drag can scroll it.
    property <length> drag-scroll;
    property <length> drag-view;
    property <length> drag-content;
    // Where the press was in the window, less the scroll at the time.
    property <length> drag-anchor;
    // The window carries the drag on if the dragged row loses the mouse.
    // Set as the drag starts, as the row can lose it without a word: the
    // list drops rows that scroll out of view, and the press goes with them.
    property <bool> drag-loose;

    // The row at `index` has moved `offset` from its place. Picks the slot
    // it would take, and scrolls when it nears an edge of the list.
    function drag-row(index: int, offset: length) {
        root.drag-from = index;
        root.drag-offset = offset;
        root.drag-to = clamp(round((index * 60px + offset) / 60px), 0, root.up-next.length - 1);
        if index * 60px + offset + 60px + root.drag-scroll > root.drag-view {
            root.drag-scroll = max(root.drag-scroll - 12px, min(0px, root.drag-view - root.drag-content));
        } else if index * 60px + offset + root.drag-scroll < 0px {
            root.drag-scroll = min(root.drag-scroll + 12px, 0px);
        }
    }

    function drop-row() {
        // Dropped where it started is no move at all.
        if root.drag-from >= 0 && root.drag-to >= 0 && root.drag-to != root.drag-from {
            root.queue-moved(root.queue-index + 1 + root.drag-from, root.queue-index + 1 + root.drag-to);
        }
        root.drag-from = -1;
        root.drag-to = -1;
        root.drag-offset = 0px;
        root.drag-loose = false;
    }

    // lyrics: state 0 none, 1 loading, 2 ready, 3 not found
    in property <[LyricRow]> lyrics;
    in property <int> lyrics-state;
    in property <bool> lyrics-synced;
    in property <string> lyrics-source;
    in property <int> lyrics-time;
    in property <length> lyrics-focus;
    in property <int> lyrics-line: -1;
    // Every lyric line whole, by line number, for the Now playing preview.
    in property <[string]> lyrics-preview;
    // How far the preview has scrolled: the top of the line being sung.
    property <length> preview-offset;
    animate preview-offset { duration: 500ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

    callback navigate(int);
    callback back();
    callback search(string);
    // search suggestions
    in-out property <string> search-text;
    in property <[SuggestData]> suggestions;
    in property <bool> suggest-loading;
    callback search-edited(string);
    callback suggestion-picked(int);
    callback clear-history();
    callback item-activated(int);
    callback item-rested(int);
    callback item-play(int);
    callback queue-activated(int);
    callback load-more();
    // A click on a track list's column title.
    callback sort-by(int);
    // A suggestion under a playlist: its Add button, by item id, and the
    // section's Refresh.
    callback recommend-add(int);
    callback recommend-refresh();
    in property <int> sort-column;
    in property <bool> sort-descending;
    callback play-page(bool);
    callback toggle-play();
    callback toggle-shuffle();
    // A key pressed while no text box has focus: its text, then whether
    // Control, Shift and Alt were held. True when it was a shortcut.
    callback hotkey(string, bool, bool, bool) -> bool;
    // True while a text box has the cursor, so keys type into it.
    out property <bool> typing: TextInputInterface.text-input-focused;
    out property <bool> hotkeys-focused: hotkeys.has-focus;
    public function focus-hotkeys() { hotkeys.focus(); }
    public function focus-search() { search.take-focus(); }
    // The sleep timer: which choice is running (0 is off), and the time
    // left as text.
    in property <int> sleep-choice;
    // The sleep timer's menu, by sleep-choice.
    property <[string]> sleep-options: ["Off", "5 minutes", "15 minutes", "30 minutes", "45 minutes", "1 hour", "End of song"];
    in property <string> sleep-text;
    callback sleep-chosen(int);
    callback cycle-repeat();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(float);
    // A line of the cast menu: a device by its index, or -1 for this
    // computer.
    callback cast-picked(int);
    callback toggle-like();
    callback panel-changed(int);
    callback lyrics-seek(int);
    callback save-cookie(string);
    callback sign-out();

    // connections
    in-out property <string> svc-discord;
    in-out property <string> svc-lastfm-key;
    in-out property <string> svc-lastfm-secret;
    in-out property <string> svc-spotify-id;
    in-out property <string> svc-spotify-secret;
    in-out property <string> svc-spotify-cookie;
    in property <bool> canvas-linked;
    callback canvas-unlink();
    // Opens open.spotify.com in the browser, to copy the cookie from.
    callback open-spotify-web();
    in property <string> lastfm-user;
    // True when this build carries Tonearm's own keys for the service.
    in property <bool> discord-builtin;
    in property <bool> lastfm-builtin;
    // True once a Spotify client ID and secret are saved.
    in property <bool> spotify-linked;
    callback spotify-unlink();
    in property <bool> discord-on;
    callback discord-toggle();
    // What the Discord member list shows: 0 artist, 1 song, 2 app name.
    in-out property <int> discord-status;
    callback discord-status-changed(int);
    // Which settings page shows. 0 is the main one; under it 3 is
    // Customization, 4 Playback, 5 Storage and 7 Accounts. Under Accounts
    // 6 is Tonearm, 2 YouTube Music, 8 Spotify, 9 Last.fm and 10 Discord.
    property <int> settings-page;
    // The page moving to Settings should land on (0 for the main one), set
    // by `show-connections` and the Profile page's account buttons.
    property <int> open-page;
    changed nav => {
        root.settings-page = root.open-page;
        root.open-page = 0;
        search.close();
    }
    // Settings' Spotify page, from Library's "Connect Spotify" card.
    // Rust then moves `nav` to Settings.
    public function show-connections() {
        root.open-page = root.nav != 3 ? 8 : 0;
        root.settings-page = 8;
    }
    // Opening the Tonearm account page refreshes its state.
    changed settings-page => {
        if root.settings-page == 6 {
            root.tonearm-open();
        }
    }
    in property <string> services-note;
    callback save-services();

    // updates
    in property <string> app-version;
    in property <string> update-note;
    in property <bool> update-available;
    in property <bool> update-busy;
    callback check-update();
    callback install-update();

    // storage: the offline cache and downloads
    in property <string> storage-note;
    // Index into the cache sizes: off, 512 MB, 1 GB, 2 GB, 5 GB.
    in-out property <int> cache-choice: 2;
    callback cache-choice-changed(int);
    callback clear-cache();
    // Index into the crossfade lengths: off, 1, 2, 3, 4, 6, 8, 10, 12 s.
    in-out property <int> crossfade-choice: 0;
    callback crossfade-choice-changed(int);
    // 0 off, 1 on: songs changed by hand crossfade with that length too.
    in-out property <int> crossfade-manual-choice: 0;
    callback crossfade-manual-choice-changed(int);
    // What each view shows for the cover. Panel: Spotify Canvas, Animated
    // cover or Static cover. Expanded: Animated cover or Static cover.
    in-out property <int> panel-cover: 1;
    in-out property <int> wide-cover: 0;
    callback panel-cover-changed(int);
    callback wide-cover-changed(int);
    // Index into the languages lyrics are translated into; 0 is off.
    in-out property <int> translate-choice: 0;
    callback translate-choice-changed(int);
    // Volume levelling: off, quiet, normal or loud.
    in-out property <int> levelling-choice: 2;
    callback levelling-choice-changed(int);
    // Closing the window: 0 keeps playing in the tray, 1 quits.
    in-out property <int> close-choice: 0;
    callback close-choice-changed(int);
    callback lastfm-connect();

    // The Tonearm account (settings page 6). The email is empty while signed out.
    in property <string> tonearm-email;
    in property <string> tonearm-note;
    in property <bool> tonearm-busy;
    // A sign in code was emailed, so the code box shows.
    in property <bool> tonearm-code-sent;
    // A pairing code for another device, with how long it has left.
    in property <string> tonearm-pair-code;
    in property <string> tonearm-pair-note;
    // The QR code of that pairing code, for a phone to scan.
    in property <image> tonearm-pair-qr;
    in property <[AccountDevice]> tonearm-devices;
    callback tonearm-open();
    callback tonearm-request-code(string);
    callback tonearm-sign-in(string, string);
    callback tonearm-pair-claim(string);
    callback tonearm-pair-start();
    callback tonearm-sign-out();
    callback tonearm-remove-device(int);

    // The side menu shows only its icons, its labels as tooltips. Saved.
    in-out property <bool> menu-collapsed;
    callback menu-collapsed-changed(bool);
    // Albums, artists and playlists pinned under the side menu, and the one
    // clicked.
    in property <[ItemData]> pinned;
    callback pinned-clicked(int);

    property <length> gap: 8px;
    // The side menu's width, sliding between its two sizes.
    property <length> side: menu-collapsed ? 64px : 216px;
    animate side { duration: 240ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    property <length> panel-width: 430px;
    property <length> player-height: 76px;
    // The bar across the top of the window: back, home and search.
    property <length> top-bar: 64px;
    property <length> body-height: root.height - player-height - gap * 2 - top-bar;
    // How open the side panel is, from 0 to 1. It slides rather than pops,
    // and the page beside it narrows along with it.
    property <float> panel-t: panel != 0 ? 1 : 0;
    animate panel-t { duration: 280ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    // The panel last opened. Its content stays while it slides shut.
    property <int> shown-panel: 0;
    // How much each panel's content shows, from 0 to 1. Switching panels
    // fades the old one out as the new one fades and slides in.
    property <float> queue-t: shown-panel == 1 ? 1 : 0;
    property <float> lyrics-t: shown-panel == 2 ? 1 : 0;
    property <float> np-t: shown-panel == 3 ? 1 : 0;
    property <float> mix-t: shown-panel == 4 ? 1 : 0;
    property <float> cast-t: shown-panel == 5 ? 1 : 0;
    animate queue-t, lyrics-t, np-t, mix-t, cast-t { duration: 220ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    // How far Now playing's content sits to the right while it fades in or
    // out. It is the panel's own view, and slides with the panel.
    pure function panel-slide(t: float) -> length {
        return (1 - t) * 24px;
    }
    // How far the panel's other views, the queue, lyrics, devices and the
    // mix editor, sit below their place while they fade in or out.
    pure function panel-rise(t: float) -> length {
        return (1 - t) * 16px;
    }
    // Closed, the panel leaves a rail at the window's edge with a chevron
    // that opens Now playing. Hovered, the rail widens a little and Now
    // playing shows faintly through it.
    property <length> rail: 32px;
    property <length> rail-peek: 60px;
    in-out property <bool> rail-hovered;
    // The mouse is over the open panel, and Now playing's heading makes
    // room for its hide button.
    in-out property <bool> panel-hovered;
    property <float> np-head-t: panel-hovered && panel == 3 ? 1 : 0;
    animate np-head-t { duration: 160ms; easing: ease-out; }
    property <float> peek-t: rail-hovered && panel == 0 ? 1 : 0;
    animate peek-t { duration: 200ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    // How much of the panel shows: the rail, the peek, or all of it.
    property <length> shown-width: (rail + (rail-peek - rail) * peek-t) * (1 - panel-t) + panel-width * panel-t;
    // The page keeps out of the rail, but not the peek, so a passing mouse
    // never reflows it.
    property <length> main-width: root.width - side - gap * 4 - rail - (panel-width - rail) * panel-t;
    // The width the page ends up at, for choices that should not flip
    // halfway through the slide.
    property <length> settled-width: root.width - side - gap * 4 - (panel != 0 ? panel-width : rail);
    // The search box lives at window level; the header keeps a gap for it.
    property <length> search-width: min(480px, max(220px, root.width - 440px));
    // Narrow windows get a smaller hero.
    property <bool> compact: settled-width < 700px;
    // Playlists show the album in its own column when there is room.
    property <bool> show-album: settled-width >= 760px;
    property <length> hero-height: Hero.height(header.kind, header.banner, compact);
    // The bottom of a detail page's hero, in window coordinates, as it
    // scrolls. Far down until a hero shows.
    property <length> hero-bottom: 100000px;
    // The Syncs page's rows, and what was done on one: opened a side (0 the
    // source, 1 the destination), or one of its buttons (see SyncRowView).
    in property <[SyncRowData]> sync-rows;
    callback sync-open(string, int);
    callback sync-act(string, int);
    // How many of the hero's buttons after Play still show (see
    // DetailHeader's `fit`). Rust puts the rest in the dots menu.
    out property <int> hero-fit: 5;
    // A new page starts with its hero in view.
    changed rows => { root.hero-bottom = 100000px; }

    // How far mix mode is on, eased, so rows open and close the room for
    // their transition chips smoothly.
    property <float> mix-level: header.mixing ? 1 : 0;
    animate mix-level { duration: 280ms; easing: ease-in-out; }
    // A song in mix mode also has room under it for the transition chip.
    pure function row-height(kind: int, style: int, mix: string) -> length {
        return kind == 0 ? 56px
            : kind == 1 ? (style == 1 ? 48px : 56px) + (style == 2 && mix != "" ? 34px * mix-level : 0px)
            : kind == 2 ? 236px
            : kind == 4 ? hero-height + 12px
            : kind == 5 ? 84px
            : kind == 6 ? 32px
            : kind == 7 ? 156px
            : kind == 8 ? 104px
            : kind == 9 ? 64px
            : kind == 10 ? 248px
            : kind == 11 ? 236px
            : kind == 12 ? 52px
            : 120px;
    }

    // Asks Rust what the item offers, then opens the menu at the mouse.
    function show-menu(source: int, id: int, x: length, y: length) {
        root.menu-source = source;
        root.item-menu(source, id);
        if root.menu-entries.length > 0 {
            root.menu-x = x;
            root.menu-y = y;
            context-menu.show();
        }
    }

    function show-panel(which: int) {
        if root.panel == 4 && which != 4 {
            root.leave-mix-panel(which);
            return;
        }
        root.switch-panel(which);
    }

    function switch-panel(which: int) {
        root.panel = root.panel == which ? 0 : which;
        if root.panel != 0 {
            root.shown-panel = root.panel;
        }
        // Expanded is a way of showing Now playing. Any other panel, or
        // none, puts it back.
        if root.panel != 3 {
            root.np-expanded = false;
        }
        root.panel-changed(root.panel);
    }

    // Now playing spread over the page as well as its panel: the cover on
    // the left, the lyrics on the right.
    in-out property <bool> np-expanded;
    property <float> expand-t: np-expanded && panel == 3 ? 1 : 0;
    animate expand-t { duration: 320ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    // Where the expanded view sits once open: the page and the panel together.
    property <length> wide-x: side + gap * 2;
    property <length> wide-width: root.width - side - gap * 3;
    // Where the panel sits, for the expanded view to grow from.
    property <length> panel-x: root.width - gap - shown-width;
    // The cover's column takes this share of the expanded view.
    property <float> art-share: 0.46;
    // How far the Now playing panel is scrolled. Zero or less.
    property <length> np-scroll;
    // The expanded cover: its size and place in the window.
    // Whole pixels, like its place: a size with a fraction left the last
    // column only part covered, a dark line down the cover's right side.
    property <length> wide-art: round(max(120px, min(root.wide-width * root.art-share - 96px, body-height - 64px - 200px)) / 1px) * 1px;
    property <length> wide-art-x: root.wide-x + round((root.wide-width * root.art-share - root.wide-art) / 2 / 1px) * 1px;
    property <length> wide-art-y: top-bar + 64px + round((body-height - 64px - root.wide-art - 84px) / 2 / 1px) * 1px;
    // The panel's cover in the window.
    property <length> np-art-y: top-bar + root.np-scroll;
    property <length> np-art-h: panel-width * 1.2;
    // How wide the lyrics will be once the view settles. Rust breaks lines
    // to fit it, and again whenever it changes.
    out property <length> lyrics-width: np-expanded && panel == 3
        ? root.wide-width * (1 - root.art-share) - 32px : panel-width;
    // Expanded Now playing shows the lyrics larger.
    property <bool> lyrics-wide: np-expanded && panel == 3;
    out property <length> lyrics-font: lyrics-wide ? 32px : 24px;
    property <length> lyrics-row: lyrics-font * 1.5;
    // The line being sung stands out larger. Rust breaks lines to fit
    // this size, so a line growing never runs out of room.
    // A touch, as Apple Music does: it is lit, not much larger.
    out property <float> lyrics-grow: 1.04;
    // About how wide a character of synced lyrics is, for Rust to break
    // lines to fit `lyrics-width`.
    out property <float> lyrics-char-px: lyrics-wide ? 18 : 13.5;
    // How far the lyrics have scrolled to keep the sung line in view. Each
    // row follows it on its own, a little later the further down it is, so
    // the lines ripple up the way Apple Music's do.
    in-out property <length> lyrics-scroll;
    // Scrolled by hand: every line sharp, and the view stays put until
    // Sync takes it back to the line being sung.
    in-out property <bool> lyrics-free;
    // How far the lines are moved to follow along. Freed, they are not:
    // the view itself scrolls, over every line.
    property <length> lyrics-at: lyrics-free ? 0px : lyrics-scroll;
    callback lyrics-width-changed();
    changed lyrics-width => { root.lyrics-width-changed(); }

    // A new line in view takes back any scrolling by hand, unless the
    // view was freed.
    changed lyrics-scroll => {
        if !root.lyrics-free {
            lyrics-view.content-y = 0;
        }
    }
    // New lyrics start at the top, following along.
    changed lyrics-state => {
        root.lyrics-free = false;
        lyrics-view.content-y = 0;
        root.lyrics-scroll = 0;
    }
    function sync-lyrics() {
        root.lyrics-free = false;
        lyrics-view.content-y = 0;
    }

    // Every island has a fixed place. Nothing here feeds the window's own
    // size, so opening a panel never resizes the window.

    // sidebar
    Rectangle {
        x: gap;
        y: top-bar;
        width: side;
        height: body-height;
        border-radius: Theme.radius;
        background: Theme.island;
        VerticalLayout {
            padding: 12px;
            // Room under Quick access for the collapse button.
            padding-bottom: 56px;
            spacing: 4px;
            NavItem {
                icon: Icons.home;
                label: "Home";
                collapsed: root.menu-collapsed;
                selected: root.nav == 0;
                clicked => {
                    root.np-expanded = false;
                    root.navigate(0);
                }
            }
            NavItem {
                icon: Icons.explore;
                label: "Explore";
                collapsed: root.menu-collapsed;
                selected: root.nav == 1;
                clicked => {
                    root.np-expanded = false;
                    root.navigate(1);
                }
            }
            NavItem {
                icon: Icons.library;
                label: "Library";
                collapsed: root.menu-collapsed;
                selected: root.nav == 2;
                clicked => {
                    root.np-expanded = false;
                    root.navigate(2);
                }
            }
            NavItem {
                icon: Icons.download;
                label: "Downloads";
                collapsed: root.menu-collapsed;
                selected: root.nav == 4;
                clicked => {
                    root.np-expanded = false;
                    root.navigate(4);
                }
            }
            // Playlists synced between Spotify and YouTube Music.
            NavItem {
                icon: Icons.repeat;
                label: "Syncs";
                can-fill: false;
                collapsed: root.menu-collapsed;
                selected: root.nav == 6;
                clicked => {
                    root.np-expanded = false;
                    root.navigate(6);
                }
            }
            // Quick access takes what is left of the menu, and scrolls when
            // there are more pins than fit.
            Rectangle {
                vertical-stretch: 1;
                clip: true;
                if root.pinned.length > 0: VerticalLayout {
                    spacing: 4px;
                    Rectangle {
                        height: 40px;
                        Text {
                            x: 14px;
                            y: 12px;
                            text: "Quick access";
                            color: Theme.dim;
                            font-size: 13px;
                            font-weight: 600;
                            opacity: root.menu-collapsed ? 0 : 1;
                            animate opacity { duration: 160ms; }
                        }
                        // Folded, a line stands in for the title.
                        Rectangle {
                            x: 10px;
                            y: 20px;
                            width: parent.width - 20px;
                            height: 1px;
                            background: #ffffff18;
                            opacity: root.menu-collapsed ? 1 : 0;
                            animate opacity { duration: 160ms; }
                        }
                    }
                    pinned-view := Flickable {
                        content-height: root.pinned.length * 46px - 4px;
                        for entry[i] in root.pinned: PinnedItem {
                            y: i * 46px;
                            width: pinned-view.width;
                            item: entry;
                            collapsed: root.menu-collapsed;
                            clicked => {
                                root.np-expanded = false;
                                root.pinned-clicked(i);
                            }
                            // Source 4: Quick access, by place in the list.
                            menu(x, y) => { root.show-menu(4, i, x, y); }
                        }
                        if !root.menu-collapsed: ScrollThumb {
                            x: pinned-view.width - self.width;
                            y: -pinned-view.content-y;
                            height: pinned-view.height;
                            content-y <=> pinned-view.content-y;
                            content-height: pinned-view.content-height;
                            view-height: pinned-view.height;
                            inset: 4px;
                        }
                    }
                }
            }
        }
        // Folds the menu down to its icons, or opens it out again: at the
        // bottom, to the right while open and centred while folded.
        IconButton {
            x: root.menu-collapsed ? (parent.width - self.width) / 2 : parent.width - self.width - 12px;
            y: parent.height - self.height - 12px;
            icon: root.menu-collapsed ? Icons.right : Icons.left;
            size: 18px;
            tint: Theme.dim;
            tip: root.menu-collapsed ? "Expand menu" : "Collapse menu";
            clicked => {
                root.menu-collapsed = !root.menu-collapsed;
                root.menu-collapsed-changed(root.menu-collapsed);
            }
        }
    }

    // main island
    Rectangle {
        x: side + gap * 2;
        y: top-bar;
        width: main-width;
        height: body-height;
        border-radius: Theme.radius;
        background: Theme.island;
        clip: true;
        VerticalLayout {
            if root.nav != 3 && root.nav != 5: VerticalLayout {
                // Room above the page, except over a detail page's hero,
                // whose art runs to the top edge.
                padding-top: root.header.kind == 0 ? 14px : 0px;
                // The title's capitals start 24 pixels down, as Home's chips
                // do and as far in as the page's left edge: 14 of room, 2
                // here, and the 8 a 32 pixel Figtree line has above its
                // capitals. The band is 52 tall, as Home's chip row is, so
                // the first shelf starts at the same height on every page.
                // A subtitle adds its line. The buttons centre on the text.
                if root.header.kind == 0 && root.page-title != "": HorizontalLayout {
                    padding-top: 2px;
                    padding-bottom: 12px;
                    spacing: 12px;
                    padding-left: 24px;
                    padding-right: 16px;
                    VerticalLayout {
                        alignment: start;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: root.page-title;
                            color: Theme.text;
                            font-size: 32px;
                            font-weight: 800;
                            overflow: elide;
                        }
                        if root.page-subtitle != "": Text {
                            text: root.page-subtitle;
                            color: Theme.dim;
                            font-size: 14px;
                            overflow: elide;
                        }
                    }
                    if root.nav == 2 && root.signed-in: VerticalLayout {
                        alignment: center;
                        padding-right: 14px;
                        PillButton {
                            text: "New playlist";
                            clicked => { root.new-playlist(); }
                        }
                    }
                    if root.page-playable: VerticalLayout {
                        alignment: center;
                        PillButton {
                            text: "Play";
                            primary: true;
                            clicked => { root.play-page(false); }
                        }
                    }
                    if root.page-playable: VerticalLayout {
                        alignment: center;
                        padding-right: 14px;
                        PillButton {
                            text: "Shuffle";
                            clicked => { root.play-page(true); }
                        }
                    }
                }
                // Search results by kind, as Spotify sorts them.
                if root.search-tab >= 0: HorizontalLayout {
                    height: 48px;
                    padding-left: 24px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    alignment: start;
                    for tab[i] in ["All", "Songs", "Albums", "Artists", "Playlists", "Podcasts"]: Rectangle {
                        width: tab-label.preferred-width + 28px;
                        height: 32px;
                        border-radius: 16px;
                        background: i == root.search-tab ? Theme.text : (tab-touch.has-hover && !Scroll.active) ? #ffffff24 : #ffffff14;
                        animate background { duration: 120ms; }
                        tab-label := Text {
                            text: tab;
                            color: i == root.search-tab ? #08080a : Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        tab-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if i != root.search-tab {
                                    root.search-tab-picked(i);
                                }
                            }
                        }
                    }
                }
                page-box := Rectangle {
                    vertical-stretch: 1;
                    // Home: soft glows of colour at the top of the page,
                    // behind the shelves, scrolling away with them. Each
                    // fades out well inside its square, so no edge shows.
                    if root.nav == 0 && root.header.kind == 0: Rectangle {
                        y: page-list.content-y;
                        height: 0px;
                        property <length> pink: parent.width * 0.75;
                        property <length> violet: parent.width * 0.95;
                        Rectangle {
                            x: -parent.pink * 0.3;
                            y: -parent.pink * 0.5;
                            width: parent.pink;
                            height: parent.pink;
                            background: @radial-gradient(circle, Theme.accent.with-alpha(0.3) 0%, Theme.accent.with-alpha(0) 50%);
                        }
                        Rectangle {
                            x: parent.width - parent.violet * 0.65;
                            y: -parent.violet * 0.55;
                            width: parent.violet;
                            height: parent.violet;
                            background: @radial-gradient(circle, #7a5cff.with-alpha(0.26) 0%, #7a5cff.with-alpha(0) 50%);
                        }
                    }
                    // The Syncs page: each synced pair as a row, drawn here
                    // rather than as a page of shelves.
                    if root.nav == 6: Flickable {
                        width: parent.width;
                        height: parent.height;
                        content-height: sync-column.preferred-height;
                        sync-column := VerticalLayout {
                            padding-left: 16px;
                            padding-right: 22px;
                            padding-bottom: 24px;
                            spacing: 12px;
                            alignment: start;
                            if root.sync-rows.length == 0: Text {
                                text: "Nothing syncs yet. Right-click a playlist, or open its ••• menu, and choose Sync to Spotify or Sync to YouTube Music.";
                                color: Theme.dim;
                                font-size: 15px;
                                wrap: word-wrap;
                            }
                            for synced in root.sync-rows: SyncRowView {
                                pair: synced;
                                open(side) => { root.sync-open(synced.key, side); }
                                act(action) => { root.sync-act(synced.key, action); }
                            }
                        }
                    }
                    // Stand ins while the page loads. They sit where the list
                    // does, so the room, title and tabs above come from the
                    // layout and the skeletons only mimic the rows.
                    if root.loading && root.rows.length == 0 && root.header.kind == 0: SkeletonPage {
                        x: 16px;
                        style: root.search-tab >= 0 ? 2 : root.nav == 0 ? 0 : 1;
                        width: parent.width - 22px;
                        height: parent.height;
                    }
                    if root.loading && root.rows.length == 0 && root.header.kind != 0: SkeletonDetail {
                        width: parent.width;
                        height: parent.height;
                        compact: root.compact;
                        banner: root.header.banner;
                        round: root.header.kind == 1;
                        numbered: root.header.kind == 2 || root.header.kind == 4;
                    }
                    page-list := ListView {
                        width: 100%;
                        height: 100%;
                        vertical-scrollbar-policy: always-off;
                        for row in root.rows: Rectangle {
                            // The wrapped cards take the lines they need at
                            // this width, inside the same 16 pixel margins.
                            height: row.kind == 13 ? CardGrid.height(self.width - 32px, row.cards.length)
                                : root.row-height(row.kind, row.style, row.mix);
                            if row.kind == 0: SectionHeader {
                                x: 16px;
                                width: parent.width - 32px;
                                title: row.title;
                                more: row.more;
                                more-clicked => { root.show-all(row.more-id); }
                            }
                            if row.kind == 1: SongRow {
                                x: 16px;
                                width: parent.width - 32px;
                                item: row.item;
                                wide-number: root.chart;
                                number: row.number;
                                show-art: row.style != 1;
                                show-album: row.style >= 2 && root.show-album && row.item.album != "";
                                mixing: root.header.mixing && row.style >= 2;
                                addable: row.style == 3;
                                add => { root.recommend-add(row.item.id); }
                                bpm: row.bpm;
                                camelot: row.camelot;
                                key-color: row.key-color;
                                mix-label: row.mix;
                                mix-level: row.style >= 2 ? root.mix-level : 0;
                                analysis: row.analysis;
                                analysis-progress: row.analysis-progress;
                                analyse-now => { root.analyse-now(row.item.id); }
                                edit-mix => { root.edit-mix(row.item.id); }
                                preview-mix => { root.preview-mix(row.item.id); }
                                activated => { root.item-activated(row.item.id); }
                                rested => { root.item-rested(row.item.id); }
                                play => { root.item-play(row.item.id); }
                                open(b) => { root.open-browse(b); }
                                menu(x, y) => { root.show-menu(0, row.item.id, x, y); }
                            }
                            if row.kind == 7: TopResult {
                                y: 0;
                                x: 16px;
                                width: parent.width - 32px;
                                height: 144px;
                                item: row.item;
                                activated => { root.item-activated(row.item.id); }
                                play => { root.item-play(row.item.id); }
                                menu(x, y) => { root.show-menu(0, row.item.id, x, y); }
                            }
                            if row.kind == 10: SongGrid {
                                x: 16px;
                                width: parent.width - 32px;
                                cards: row.cards;
                                activated(id) => { root.item-activated(id); }
                                rested(id) => { root.item-rested(id); }
                                open(b) => { root.open-browse(b); }
                                menu(id, x, y) => { root.show-menu(0, id, x, y); }
                            }
                            if row.kind == 11: VideoCarousel {
                                x: 16px;
                                width: parent.width - 32px;
                                cards: row.cards;
                                activated(id) => { root.item-activated(id); }
                                rested(id) => { root.item-rested(id); }
                                menu(id, x, y) => { root.show-menu(0, id, x, y); }
                            }
                            if row.kind == 12: ChipRow {
                                x: 24px;
                                width: parent.width - 48px;
                                chips: row.cards;
                                clicked(i) => { root.chip-clicked(i); }
                            }
                            if row.kind == 13: CardWrap {
                                x: 16px;
                                y: 0;
                                width: parent.width - 32px;
                                cards: row.cards;
                                activated(id) => { root.item-activated(id); }
                                rested(id) => { root.item-rested(id); }
                                play(id) => { root.item-play(id); }
                                open(b) => { root.open-browse(b); }
                                menu(id, x, y) => { root.show-menu(0, id, x, y); }
                            }
                            if row.kind == 2: Carousel {
                                x: 16px;
                                width: parent.width - 32px;
                                cards: row.cards;
                                activated(id) => { root.item-activated(id); }
                                rested(id) => { root.item-rested(id); }
                                play(id) => { root.item-play(id); }
                                open(b) => { root.open-browse(b); }
                                menu(id, x, y) => { root.show-menu(0, id, x, y); }
                            }
                            if row.kind == 4: DetailHeader {
                                // Where the hero ends in the window, for the
                                // bar that sticks once it has scrolled away.
                                // The list's own scroll offset is only a guess
                                // once the hero is out of view.
                                property <length> bottom: self.absolute-position.y + self.height + 12px;
                                changed bottom => { root.hero-bottom = self.bottom; }
                                changed fit => { root.hero-fit = self.fit; }
                                init => {
                                    root.hero-bottom = self.bottom;
                                    root.hero-fit = self.fit;
                                }
                                y: 0;
                                width: parent.width;
                                height: root.hero-height;
                                data: root.header;
                                tint: root.shown-page-tint;
                                compact: root.compact;
                                motion: root.page-motion;
                                motion-on: root.page-motion-on;
                                play => { root.play-page(false); }
                                shuffle => { root.play-page(true); }
                                mix => { root.toggle-mix(); }
                                download => { root.download-page(); }
                                follow => { root.toggle-follow(); }
                                like => { root.toggle-like-page(); }
                                byline-clicked => { root.byline-clicked(); }
                                menu(x, y) => { root.show-menu(3, 0, x, y); }
                            }
                            if row.kind == 5: Text {
                                x: 24px;
                                y: 0;
                                width: parent.width - 48px;
                                height: 72px;
                                text: row.title;
                                color: Theme.dim;
                                font-size: 14px;
                                wrap: word-wrap;
                                overflow: elide;
                            }
                            // "Recommended", under a playlist of the user's own.
                            if row.kind == 8: VerticalLayout {
                                x: 24px;
                                width: parent.width - 48px;
                                padding-top: 40px;
                                spacing: 4px;
                                Text {
                                    text: row.title;
                                    color: Theme.text;
                                    font-size: 24px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.subtitle;
                                    color: Theme.dim;
                                    font-size: 14px;
                                    overflow: elide;
                                }
                            }
                            if row.kind == 9: Rectangle {
                                x: parent.width - 16px - self.width - 8px;
                                y: 16px;
                                width: refresh-label.preferred-width + 28px;
                                height: 36px;
                                border-radius: 18px;
                                background: (refresh-touch.has-hover && !Scroll.active) && !row.more ? #ffffff14 : transparent;
                                animate background { duration: 120ms; }
                                refresh-label := Text {
                                    text: row.more ? "Finding songs…" : "Refresh";
                                    color: (refresh-touch.has-hover && !Scroll.active) && !row.more ? Theme.text : Theme.dim;
                                    font-size: 14px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                refresh-touch := TouchArea {
                                    enabled: !row.more;
                                    mouse-cursor: pointer;
                                    clicked => { root.recommend-refresh(); }
                                }
                            }
                            if row.kind == 6: TrackColumns {
                                wide-number: root.chart;
                                x: 16px;
                                width: parent.width - 32px;
                                show-art: row.style == 2;
                                show-album: row.style == 2 && root.show-album;
                                mixing: root.header.mixing;
                                sort-column: root.sort-column;
                                sort-descending: root.sort-descending;
                                sort(c) => { root.sort-by(c); }
                            }
                            if row.kind == 3: Appear {
                                appeared => { root.load-more(); }
                                SkeletonRow {
                                    y: 0;
                                    x: 16px;
                                    width: parent.width - 32px;
                                    seed: 1;
                                }
                                SkeletonRow {
                                    y: 60px;
                                    x: 16px;
                                    width: parent.width - 32px;
                                    seed: 4;
                                }
                            }
                        }
                    }
                    // Where the bottom of the hero is in the list, as it scrolls.
                    // The hero's last place stands once it is gone from the
                    // list, far out of view.
                    property <length> hero-left: root.hero-bottom - page-list.absolute-position.y;
                    // As Spotify does it: the bar at the top darkens bit by bit
                    // as the hero scrolls away. The page's name and play button
                    // come in once the hero's own play button passes under it,
                    // and the column titles stick when they reach it.
                    property <float> bar-t: max(0, min(1, 1 - (self.hero-left - 64px) / max(1px, root.hero-height + 12px - 64px)));
                    property <bool> named: self.hero-left < 64px + 60px;
                    property <bool> stuck: self.hero-left < 64px;
                    property <int> columns: root.rows.length > 1 && root.rows[1].kind == 6 ? root.rows[1].style : 0;
                    if root.header.kind != 0 && page-box.bar-t > 0: Rectangle {
                        y: 0;
                        width: page-list.width;
                        height: 64px;
                        background: root.shown-page-tint.darker(0.45).with-alpha(page-box.bar-t);
                        // Once it shows the name, clicks stop at the bar.
                        if page-box.named: TouchArea { }
                    }
                    if root.header.kind != 0 && page-box.bar-t > 0: sticky-name := Rectangle {
                        y: 0;
                        width: page-list.width;
                        height: 64px;
                        opacity: page-box.named ? 1 : 0;
                        animate opacity { duration: 180ms; easing: ease-out; }
                        // The same button as the page's own, mix mode look and all.
                        if root.header.can-play: PlayDisc {
                            x: 16px;
                            y: 10px;
                            size: 44px;
                            playing: Now.page != "" && Now.page == Now.from && Now.playing;
                            mixed: root.header.mixing;
                            clicked => {
                                if page-box.named {
                                    root.play-page(false);
                                }
                            }
                        }
                        Text {
                            x: root.header.can-play ? 72px : 24px;
                            y: 0;
                            height: 64px;
                            width: parent.width - self.x - 16px;
                            text: root.header.title;
                            color: Theme.text;
                            font-size: 24px;
                            font-weight: 800;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    if root.header.kind != 0 && page-box.stuck && page-box.columns > 0: Rectangle {
                        y: 64px;
                        width: page-list.width;
                        height: 36px;
                        background: Theme.island;
                        TouchArea { }
                        // A slightly lighter strip, as Spotify has it.
                        Rectangle { background: #ffffff0a; }
                        TrackColumns {
                            wide-number: root.chart;
                            x: 16px;
                            y: 2px;
                            width: parent.width - 32px;
                            show-art: page-box.columns == 2;
                            show-album: page-box.columns == 2 && root.show-album;
                            mixing: root.header.mixing;
                            sort-column: root.sort-column;
                            sort-descending: root.sort-descending;
                            sort(c) => { root.sort-by(c); }
                        }
                    }
                    ScrollThumb {
                        x: parent.width - self.width;
                        height: parent.height;
                        content-y <=> page-list.content-y;
                        content-height: page-list.content-height;
                        view-height: page-list.visible-height;
                    }
                }
            }

            if root.nav == 3 && root.settings-page == 0: settings-flick := Flickable {
                // Fills the panel. Left alone it takes the cards' cap as
                // its own width and stops short, scroll bar and all.
                max-width: 100000px;
                horizontal-stretch: 1;
                content-height: settings.preferred-height;
                settings := VerticalLayout {
                    padding: 28px;
                    padding-top: 26px;
                    spacing: 14px;
                    alignment: start;
                    Text {
                        text: "Settings";
                        color: Theme.text;
                        font-size: 32px;
                        font-weight: 800;
                    }
                    SubpageRow {
                        icon: Icons.artist;
                        title: "Accounts";
                        subtitle: "Tonearm, YouTube Music, Spotify, Last.fm and Discord";
                        clicked => { root.settings-page = 7; }
                    }
                    SubpageRow {
                        icon: Icons.speaker-high;
                        title: "Playback";
                        subtitle: "Crossfade and volume levelling";
                        clicked => { root.settings-page = 4; }
                    }
                    SubpageRow {
                        icon: Icons.sparkle;
                        title: "Customization";
                        subtitle: "Covers in Now playing, and lyrics translation";
                        clicked => { root.settings-page = 3; }
                    }
                    SubpageRow {
                        icon: Icons.download;
                        title: "Storage and history";
                        subtitle: "Song cache, and what Tonearm remembers you played";
                        clicked => { root.settings-page = 5; }
                    }
                    Rectangle {
                        max-width: 880px;
                        border-radius: 12px;
                        background: #ffffff0a;
                        HorizontalLayout {
                            padding: 20px;
                            SettingRow {
                                title: "Closing the window";
                                subtitle: "Keep playing hides Tonearm in the tray by the clock. Click the icon to bring it back, or right click it to quit.";
                                Dropdown {
                                    options: ["Keep playing", "Quit"];
                                    selected <=> root.close-choice;
                                    changed(i) => { root.close-choice-changed(i); }
                                }
                            }
                        }
                    }
                    Rectangle {
                        max-width: 880px;
                        border-radius: 12px;
                        background: #ffffff0a;
                        HorizontalLayout {
                            padding: 20px;
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 6px;
                                alignment: center;
                                Text {
                                    text: "Tonearm " + root.app-version;
                                    color: Theme.text;
                                    font-size: 16px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: root.update-note != "" ? root.update-note : "Updates come from the GitHub releases page.";
                                    color: root.update-available ? Theme.accent : Theme.dim;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                            }
                            if root.update-busy: VerticalLayout {
                                alignment: center;
                                Loader { }
                            }
                            if !root.update-busy: VerticalLayout {
                                alignment: center;
                                PillButton {
                                    text: root.update-available ? "Update and restart" : "Check for updates";
                                    primary: root.update-available;
                                    clicked => {
                                        if root.update-available {
                                            root.install-update();
                                        } else {
                                            root.check-update();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                ScrollThumb {
                    x: settings-flick.width - self.width;
                    y: -settings-flick.content-y;
                    height: settings-flick.height;
                    content-y <=> settings-flick.content-y;
                    content-height: settings-flick.content-height;
                    view-height: settings-flick.height;
                }
            }

            // The profile: who is signed in, what you play, and what
            // Tonearm reports to.
            if root.nav == 5: profile-flick := Flickable {
                // Its content would otherwise set its width, leaving the
                // rest of the island empty with the scrollbar mid-page.
                width: 100%;
                content-width: self.width;
                content-height: profile.preferred-height;
                profile := VerticalLayout {
                    width: profile-flick.width;
                    padding: 28px;
                    padding-top: 26px;
                    spacing: 28px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Rectangle {
                            width: 112px;
                            height: 112px;
                            if root.signed-in && root.profile-has-art: Art {
                                width: 100%;
                                height: 100%;
                                source: root.profile-art;
                                has: true;
                                round: true;
                            }
                            if !(root.signed-in && root.profile-has-art): Rectangle {
                                border-radius: self.width / 2;
                                background: #ffffff14;
                                Icon {
                                    text: Icons.artist;
                                    font-size: 44px;
                                    color: Theme.dim;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: "Profile";
                                color: Theme.dim;
                                font-size: 13px;
                                font-weight: 600;
                            }
                            Text {
                                text: root.signed-in ? root.account-name : "Not signed in";
                                color: Theme.text;
                                font-size: 36px;
                                font-weight: 800;
                                overflow: elide;
                            }
                            if root.signed-in && root.account-handle != "": Text {
                                text: root.account-handle;
                                color: Theme.dim;
                                font-size: 14px;
                                overflow: elide;
                            }
                            if !root.signed-in: Text {
                                text: "Sign in to YouTube Music for your library, playlists and mixes.";
                                color: Theme.dim;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                padding-top: 10px;
                                spacing: 8px;
                                alignment: start;
                                if root.signed-in: PillButton {
                                    text: "Account settings";
                                    clicked => {
                                        root.open-page = 2;
                                        root.navigate(3);
                                    }
                                }
                                if root.signed-in: PillButton {
                                    text: "Sign out";
                                    danger: true;
                                    clicked => { root.sign-out(); }
                                }
                                if !root.signed-in: PillButton {
                                    text: "Sign in";
                                    primary: true;
                                    clicked => {
                                        root.open-page = 2;
                                        root.navigate(3);
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "On this computer";
                            color: Theme.text;
                            font-size: 22px;
                            font-weight: 800;
                        }
                        HorizontalLayout {
                            max-width: 880px;
                            spacing: 12px;
                            StatTile {
                                value: root.profile-songs;
                                label: root.profile-songs == 1 ? "Song played" : "Songs played";
                            }
                            StatTile {
                                value: root.profile-artist-count;
                                label: root.profile-artist-count == 1 ? "Artist" : "Artists";
                            }
                            StatTile {
                                value: root.profile-opened;
                                label: "Albums and playlists";
                            }
                        }
                        if root.profile-songs == 0 && root.profile-opened == 0: Text {
                            text: "Nothing yet. What you play and open shows up here. It stays on this computer.";
                            color: Theme.dim;
                            font-size: 14px;
                            wrap: word-wrap;
                        }
                    }

                    if root.profile-artists.length > 0: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Your top artists";
                            color: Theme.text;
                            font-size: 22px;
                            font-weight: 800;
                        }
                        VerticalLayout {
                            max-width: 880px;
                            for name[i] in root.profile-artists: ArtistRank {
                                rank: i + 1;
                                name: name;
                                clicked => { root.profile-artist-picked(i); }
                            }
                        }
                    }

                    if root.profile-played.length > 0: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Played lately";
                            color: Theme.text;
                            font-size: 22px;
                            font-weight: 800;
                        }
                        Carousel {
                            cards: root.profile-played;
                            activated(id) => { root.profile-played-picked(id); }
                            play(id) => { root.profile-played-play(id); }
                        }
                    }

                    VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Connections";
                            color: Theme.text;
                            font-size: 22px;
                            font-weight: 800;
                        }
                        SubpageRow {
                            logo: @image-url("discord.svg");
                            brand: #5865f2;
                            title: "Discord";
                            subtitle: root.discord-on ? "Showing what you play" : "Not linked";
                            clicked => {
                                root.open-page = 10;
                                root.navigate(3);
                            }
                        }
                        SubpageRow {
                            logo: @image-url("lastfm.svg");
                            brand: #d51007;
                            title: "Last.fm";
                            subtitle: root.lastfm-user != "" ? "Scrobbling as " + root.lastfm-user : "Not linked";
                            clicked => {
                                root.open-page = 9;
                                root.navigate(3);
                            }
                        }
                        SubpageRow {
                            logo: @image-url("spotify.svg");
                            brand: #1db954;
                            title: "Spotify";
                            subtitle: root.spotify-linked ? (root.canvas-linked ? "Track details and Canvas" : "Track details") : "Not linked";
                            clicked => {
                                root.open-page = 8;
                                root.navigate(3);
                            }
                        }
                    }
                }
                ScrollThumb {
                    x: profile-flick.width - self.width;
                    y: -profile-flick.content-y;
                    height: profile-flick.height;
                    content-y <=> profile-flick.content-y;
                    content-height: profile-flick.content-height;
                    view-height: profile-flick.height;
                }
            }

            // Settings sub page: the YouTube Music sign in.
            if root.nav == 3 && root.settings-page == 3: customization-flick := Flickable {
                // Fills the panel, as the account page does.
                max-width: 100000px;
                horizontal-stretch: 1;
                content-height: customization.preferred-height;
                customization := VerticalLayout {
                    padding: 28px;
                    padding-top: 26px;
                    spacing: 14px;
                    alignment: start;
                    Text {
                        text: "Customization";
                        color: Theme.text;
                        font-size: 32px;
                        font-weight: 800;
                    }
                    Rectangle {
                        max-width: 880px;
                        border-radius: 12px;
                        background: #ffffff0a;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            SettingRow {
                                title: "Now playing cover";
                                subtitle: "What the Now playing panel shows for the cover. Spotify Canvas needs Spotify linked in Connections. Without a clip, the still cover shows.";
                                Dropdown {
                                    options: ["Spotify Canvas", "Animated cover", "Static cover"];
                                    selected <=> root.panel-cover;
                                    changed(i) => { root.panel-cover-changed(i); }
                                }
                            }
                            SettingRow {
                                title: "Full screen cover";
                                subtitle: "What expanded Now playing shows for the cover. Animated cover is the album's moving cover from Apple Music, when it has one.";
                                Dropdown {
                                    options: ["Animated cover", "Static cover"];
                                    selected <=> root.wide-cover;
                                    changed(i) => { root.wide-cover-changed(i); }
                                }
                            }
                        }
                    }
                    Rectangle {
                        max-width: 880px;
                        border-radius: 12px;
                        background: #ffffff0a;
                        HorizontalLayout {
                            padding: 20px;
                            SettingRow {
                                title: "Translate lyrics";
                                subtitle: "Shows a translation under each line of lyrics. The lyrics' own translation is used when they have one, and Google Translate otherwise.";
                                Dropdown {
                                    options: ["Off", "English", "Spanish", "French", "German", "Italian", "Portuguese", "Russian", "Japanese", "Korean", "Chinese (Simplified)", "Chinese (Traditional)", "Indonesian"];
                                    selected <=> root.translate-choice;
                                    changed(i) => { root.translate-choice-changed(i); }
                                }
                            }
                        }
                    }
                }
            }
            if root.nav == 3 && root.settings-page == 4: playback-flick := Flickable {
                // Fills the panel, as the account page does.
                max-width: 100000px;
                horizontal-stretch: 1;
                content-height: playback.preferred-height;
                playback := VerticalLayout {
                    padding: 28px;
                    padding-top: 26px;
                    spacing: 14px;
                    alignment: start;
                    Text {
                        text: "Playback";
                        color: Theme.text;
                        font-size: 32px;
                        font-weight: 800;
                    }
                    Rectangle {
                        max-width: 880px;
                        border-radius: 12px;
                        background: #ffffff0a;
                        HorizontalLayout {
                            padding: 20px;
                            SettingRow {
                                title: "Crossfade";
                                subtitle: "As a song ends, the next one fades in while it fades out.";
                                Dropdown {
                                    options: ["Off", "1 s", "2 s", "3 s", "4 s", "6 s", "8 s", "10 s", "12 s"];
                                    selected <=> root.crossfade-choice;
                                    changed(i) => { root.crossfade-choice-changed(i); }
                                }
                            }
                        }
                    }
                    Rectangle {
                        max-width: 880px;
                        border-radius: 12px;
                        background: #ffffff0a;
                        HorizontalLayout {
                            padding: 20px;
                            SettingRow {
                                title: "Crossfade when you change songs";
                                subtitle: "Skipping, going back or playing another song fades into it over the crossfade length, instead of switching at once. Needs a crossfade length above.";
                                Dropdown {
                                    options: ["Off", "On"];
                                    selected <=> root.crossfade-manual-choice;
                                    changed(i) => { root.crossfade-manual-choice-changed(i); }
                                }
                            }
                        }
                    }
                    Rectangle {
                        max-width: 880px;
                        border-radius: 12px;
                        background: #ffffff0a;
                        HorizontalLayout {
                            padding: 20px;
                            SettingRow {
                                title: "Volume levelling";
                                subtitle: "Plays every song at about the same loudness, using YouTube's own measure of each one. Loud also lifts quiet songs a little.";
                                Dropdown {
                                    options: ["Off", "Quiet", "Normal", "Loud"];
                                    selected <=> root.levelling-choice;
                                    changed(i) => { root.levelling-choice-changed(i); }
                                }
                            }
                        }
                    }
                }
            }
            if root.nav == 3 && root.settings-page == 5: storage-flick := Flickable {
                // Fills the panel, as the account page does.
                max-width: 100000px;
                horizontal-stretch: 1;
                content-height: storage.preferred-height;
                storage := VerticalLayout {
                    padding: 28px;
                    padding-top: 26px;
                    spacing: 14px;
                    alignment: start;
                    Text {
                        text: "Storage and history";
                        color: Theme.text;
                        font-size: 32px;
                        font-weight: 800;
                    }
                    Rectangle {
                        max-width: 880px;
                        border-radius: 12px;
                        background: #ffffff0a;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            SettingRow {
                                title: "Song cache";
                                subtitle: "Songs you play are kept so they start at once next time. The least recently played go first when it fills up.";
                                Dropdown {
                                    options: ["Off", "512 MB", "1 GB", "2 GB", "5 GB"];
                                    selected <=> root.cache-choice;
                                    changed(i) => { root.cache-choice-changed(i); }
                                }
                            }
                            SettingRow {
                                title: "Storage";
                                subtitle: root.storage-note;
                                PillButton {
                                    text: "Clear cache";
                                    clicked => { root.clear-cache(); }
                                }
                            }
                        }
                    }
                    Rectangle {
                        max-width: 880px;
                        border-radius: 12px;
                        background: #ffffff0a;
                        HorizontalLayout {
                            padding: 20px;
                            SettingRow {
                                title: "Listening history";
                                subtitle: "Tonearm remembers what you play and open on this computer, and your recent searches, and puts what you play first in search. It stays encrypted on this computer.";
                                PillButton {
                                    text: "Clear";
                                    clicked => { root.clear-history(); }
                                }
                            }
                        }
                    }
                }
            }
            // Settings sub page: the accounts Tonearm can sign in to.
            if root.nav == 3 && root.settings-page == 7: accounts-flick := Flickable {
                // Fills the panel. Left alone it takes the cards' cap as
                // its own width and stops short, scroll bar and all.
                max-width: 100000px;
                horizontal-stretch: 1;
                content-height: accounts-page.preferred-height;
                accounts-page := VerticalLayout {
                    padding: 28px;
                    padding-top: 26px;
                    spacing: 14px;
                    alignment: start;
                    Text {
                        text: "Accounts";
                        color: Theme.text;
                        font-size: 32px;
                        font-weight: 800;
                    }
                    SubpageRow {
                        logo: @image-url("tonearm-wave.svg");
                        brand: #ec343a;
                        title: "Tonearm";
                        subtitle: root.tonearm-email != "" ? "Signed in as " + root.tonearm-email : "Not signed in";
                        clicked => { root.settings-page = 6; }
                    }
                    SubpageRow {
                        logo: @image-url("youtubemusic.svg");
                        brand: #ff0000;
                        title: "YouTube Music";
                        subtitle: root.signed-in ? "Signed in as " + root.account-name : "Not signed in";
                        clicked => { root.settings-page = 2; }
                    }
                    SubpageRow {
                        logo: @image-url("spotify.svg");
                        brand: #1db954;
                        title: "Spotify";
                        subtitle: root.spotify-linked ? (root.canvas-linked ? "Track details and Canvas" : "Track details") : (root.canvas-linked ? "Library and Canvas" : "Not linked");
                        clicked => { root.settings-page = 8; }
                    }
                    SubpageRow {
                        logo: @image-url("lastfm.svg");
                        brand: #d51007;
                        title: "Last.fm";
                        subtitle: root.lastfm-user != "" ? "Connected as " + root.lastfm-user : "Not connected";
                        clicked => { root.settings-page = 9; }
                    }
                    SubpageRow {
                        logo: @image-url("discord.svg");
                        brand: #5865f2;
                        title: "Discord";
                        subtitle: root.discord-on ? "On" : "Off";
                        clicked => { root.settings-page = 10; }
                    }
                }
                ScrollThumb {
                    x: accounts-flick.width - self.width;
                    y: -accounts-flick.content-y;
                    height: accounts-flick.height;
                    content-y <=> accounts-flick.content-y;
                    content-height: accounts-flick.content-height;
                    view-height: accounts-flick.height;
                }
            }

            // Settings sub page: the Tonearm account, signed in with an emailed code or a code another device shows.
            if root.nav == 3 && root.settings-page == 6: tonearm-flick := Flickable {
                // Fills the panel. Left alone it takes the cards' cap as
                // its own width and stops short, scroll bar and all.
                max-width: 100000px;
                horizontal-stretch: 1;
                content-height: tonearm-account.preferred-height;
                tonearm-account := VerticalLayout {
                    padding: 28px;
                    padding-top: 26px;
                    spacing: 14px;
                    alignment: start;
                    Text {
                        text: "Tonearm";
                        color: Theme.text;
                        font-size: 32px;
                        font-weight: 800;
                    }
                    if root.tonearm-note != "": Text {
                        text: root.tonearm-note;
                        color: Theme.accent;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                    if root.tonearm-email == "": Section {
                        title: "Tonearm";
                        logo: @image-url("tonearm-wave.svg");
                        brand: #ec343a;
                        about: "Sign in with your email. Your settings and pins follow you to every device you sign in on. Tonearm emails you a six digit code; there is no password.";
                        tonearm-mail := Field {
                            placeholder: "Email address";
                            accepted(text) => { root.tonearm-request-code(text); }
                        }
                        if !root.tonearm-code-sent: HorizontalLayout {
                            alignment: start;
                            PillButton {
                                text: root.tonearm-busy ? "Sending…" : "Email me a code";
                                primary: true;
                                clicked => { root.tonearm-request-code(tonearm-mail.text); }
                            }
                        }
                        if root.tonearm-code-sent: VerticalLayout {
                            spacing: 10px;
                            tonearm-code := Field {
                                placeholder: "6 digit code";
                                accepted(text) => { root.tonearm-sign-in(tonearm-mail.text, text); }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                PillButton {
                                    text: root.tonearm-busy ? "Signing in…" : "Sign in";
                                    primary: true;
                                    clicked => { root.tonearm-sign-in(tonearm-mail.text, tonearm-code.text); }
                                }
                                PillButton {
                                    text: "Send again";
                                    clicked => { root.tonearm-request-code(tonearm-mail.text); }
                                }
                            }
                        }
                    }
                    if root.tonearm-email == "": Section {
                        title: "Use a pairing code";
                        about: "Already signed in on another device? Open Pair a device there, and enter the code it shows.";
                        tonearm-pair := Field {
                            placeholder: "XXXX-XXXX";
                            accepted(text) => { root.tonearm-pair-claim(text); }
                        }
                        HorizontalLayout {
                            alignment: start;
                            PillButton {
                                text: root.tonearm-busy ? "Joining…" : "Join";
                                clicked => { root.tonearm-pair-claim(tonearm-pair.text); }
                            }
                        }
                    }
                    if root.tonearm-email != "": Section {
                        title: "Tonearm";
                        logo: @image-url("tonearm-wave.svg");
                        brand: #ec343a;
                        about: "This account's settings follow you to every device signed in to it.";
                        AccountRow {
                            linked: true;
                            title: root.tonearm-email;
                            unlink-text: "Sign out";
                            unlink => { root.tonearm-sign-out(); }
                        }
                    }
                    if root.tonearm-email != "": Section {
                        title: "Pair a device";
                        about: root.tonearm-pair-code == ""
                            ? "Shows a code to enter on another device, so it joins this account without email."
                            : root.tonearm-pair-note;
                        if root.tonearm-pair-code != "": HorizontalLayout {
                            alignment: start;
                            Image {
                                source: root.tonearm-pair-qr;
                                width: 200px;
                                height: 200px;
                                image-rendering: pixelated;
                            }
                        }
                        if root.tonearm-pair-code != "": Text {
                            text: root.tonearm-pair-code;
                            color: Theme.text;
                            font-size: 36px;
                            font-weight: 800;
                        }
                        HorizontalLayout {
                            alignment: start;
                            PillButton {
                                text: root.tonearm-pair-code == "" ? "Show a code" : "New code";
                                primary: root.tonearm-pair-code == "";
                                clicked => { root.tonearm-pair-start(); }
                            }
                        }
                    }
                    if root.tonearm-email != "": Section {
                        title: "Devices";
                        for device[i] in root.tonearm-devices: HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 10px;
                                    background: #ffffff14;
                                    Icon {
                                        fill: true;
                                        text: device.kind == "computer" ? Icons.desktop : Icons.mobile;
                                        font-size: 22px;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: device.current ? device.name + " (this computer)" : device.name;
                                    color: Theme.text;
                                    font-size: 16px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: (device.model != "" ? device.model + " · " : "") + "Last used " + device.seen;
                                    color: Theme.dim;
                                    font-size: 14px;
                                    overflow: elide;
                                }
                            }
                            if !device.current: VerticalLayout {
                                alignment: center;
                                PillButton {
                                    text: "Remove";
                                    danger: true;
                                    clicked => { root.tonearm-remove-device(i); }
                                }
                            }
                        }
                    }
                }
                ScrollThumb {
                    x: tonearm-flick.width - self.width;
                    y: -tonearm-flick.content-y;
                    height: tonearm-flick.height;
                    content-y <=> tonearm-flick.content-y;
                    content-height: tonearm-flick.content-height;
                    view-height: tonearm-flick.height;
                }
            }

            // Settings sub page: the YouTube Music account.
            if root.nav == 3 && root.settings-page == 2: account-flick := Flickable {
                // Fills the panel. Left alone it takes the cards' cap as
                // its own width and stops short, scroll bar and all.
                max-width: 100000px;
                horizontal-stretch: 1;
                content-height: account.preferred-height;
                account := VerticalLayout {
                    padding: 28px;
                    padding-top: 26px;
                    spacing: 14px;
                    alignment: start;
                    Text {
                        text: "YouTube Music";
                        color: Theme.text;
                        font-size: 32px;
                        font-weight: 800;
                    }
                    if root.settings-note != "": Text {
                        text: root.settings-note;
                        color: Theme.accent;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                    Section {
                        title: "YouTube Music";
                        logo: @image-url("youtubemusic.svg");
                        brand: #ff0000;
                        about: root.signed-in
                            ? "Your library, playlists and recommendations come from this account. The sign in is encrypted with your Windows account and sent only to music.youtube.com."
                            : "Tonearm has no web view, so it cannot show the Google sign in page. Sign in to music.youtube.com in your browser, open the developer tools, pick any request to music.youtube.com on the Network tab, and copy the value of its Cookie request header. Paste it below. Tonearm encrypts it with your Windows account and sends it only to music.youtube.com.";
                        if !root.signed-in: HorizontalLayout {
                            spacing: 8px;
                            cookie := Field {
                                placeholder: "Paste the Cookie header here";
                                secret: true;
                                accepted(text) => {
                                    root.save-cookie(text);
                                    self.text = "";
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                PillButton {
                                    text: "Sign in";
                                    primary: true;
                                    clicked => {
                                        root.save-cookie(cookie.text);
                                        cookie.text = "";
                                    }
                                }
                            }
                        }
                        if root.signed-in: AccountRow {
                            linked: true;
                            title: "Signed in as " + root.account-name;
                            unlink-text: "Sign out";
                            unlink => { root.sign-out(); }
                        }
                    }
                }
                ScrollThumb {
                    x: account-flick.width - self.width;
                    y: -account-flick.content-y;
                    height: account-flick.height;
                    content-y <=> account-flick.content-y;
                    content-height: account-flick.content-height;
                    view-height: account-flick.height;
                }
            }

            // Settings sub page: Spotify.
            if root.nav == 3 && root.settings-page == 8: spotify-flick := Flickable {
                // Fills the panel. Left alone it takes the cards' cap as
                // its own width and stops short, scroll bar and all.
                max-width: 100000px;
                horizontal-stretch: 1;
                content-height: spotify-page.preferred-height;
                spotify-page := VerticalLayout {
                    padding: 28px;
                    padding-top: 26px;
                    spacing: 14px;
                    alignment: start;
                    Text {
                        text: "Spotify";
                        color: Theme.text;
                        font-size: 32px;
                        font-weight: 800;
                    }
                    if root.services-note != "": Text {
                        text: root.services-note;
                        color: Theme.accent;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                    Section {
                        title: "Spotify";
                        logo: @image-url("spotify.svg");
                        brand: #1db954;
                        about: "Optional. With credentials from developer.spotify.com, Tonearm looks each track up on Spotify and reports Spotify's title, artist and album to Discord and Last.fm.";
                        if !root.spotify-linked: HorizontalLayout {
                            spacing: 8px;
                            Field {
                                placeholder: "Spotify client ID";
                                text <=> root.svc-spotify-id;
                            }
                            Field {
                                placeholder: "Spotify client secret";
                                secret: true;
                                text <=> root.svc-spotify-secret;
                            }
                        }
                        AccountRow {
                            linked: root.spotify-linked;
                            title: root.spotify-linked ? "Linked" : "Not linked";
                            subtitle: root.spotify-linked ? "Track details come from Spotify." : "";
                            link => { root.save-services(); }
                            unlink => { root.spotify-unlink(); }
                        }
                        // Your library, sync and Canvas come from a Spotify
                        // web sign in, not the keys above: its sp_dc cookie,
                        // which these steps show how to copy.
                        if !root.canvas-linked: VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "Your Spotify library, playlist sync and Canvas need your Spotify sign in. To connect it:";
                                color: Theme.text;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                            for step[i] in [
                                "Sign in to Spotify at open.spotify.com in Chrome or Edge.",
                                "Press F12 to open the developer tools, then choose Application (in Edge, it may sit under the » button).",
                                "On the left, open Cookies and click https://open.spotify.com.",
                                "Find sp_dc in the Name column, click it, and copy its Value from the box below the list.",
                                "Paste it here and press Connect.",
                            ]: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    width: 16px;
                                    text: (i + 1) + ".";
                                    color: Theme.dim;
                                    font-size: 14px;
                                }
                                Text {
                                    text: step;
                                    color: Theme.dim;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                padding-top: 4px;
                                PillButton {
                                    text: "Open open.spotify.com";
                                    clicked => { root.open-spotify-web(); }
                                }
                            }
                        }
                        if !root.canvas-linked: Field {
                            placeholder: "sp_dc cookie from open.spotify.com";
                            secret: true;
                            text <=> root.svc-spotify-cookie;
                        }
                        AccountRow {
                            linked: root.canvas-linked;
                            title: root.canvas-linked ? "Spotify sign in connected" : "Spotify sign in not connected";
                            subtitle: root.canvas-linked
                                ? "Your Spotify playlists are in Library, they can sync with YouTube Music, and songs with a Spotify Canvas loop it in place of the cover."
                                : "The cookie stays on this computer. It is a private Spotify sign in, so it can stop working when Spotify changes its web player; copy a fresh one then. Signing out of Spotify in that browser ends it too.";
                            link => { root.save-services(); }
                            unlink => { root.canvas-unlink(); }
                        }
                    }
                }
                ScrollThumb {
                    x: spotify-flick.width - self.width;
                    y: -spotify-flick.content-y;
                    height: spotify-flick.height;
                    content-y <=> spotify-flick.content-y;
                    content-height: spotify-flick.content-height;
                    view-height: spotify-flick.height;
                }
            }

            // Settings sub page: Last.fm scrobbling.
            if root.nav == 3 && root.settings-page == 9: lastfm-flick := Flickable {
                // Fills the panel. Left alone it takes the cards' cap as
                // its own width and stops short, scroll bar and all.
                max-width: 100000px;
                horizontal-stretch: 1;
                content-height: lastfm-page.preferred-height;
                lastfm-page := VerticalLayout {
                    padding: 28px;
                    padding-top: 26px;
                    spacing: 14px;
                    alignment: start;
                    Text {
                        text: "Last.fm";
                        color: Theme.text;
                        font-size: 32px;
                        font-weight: 800;
                    }
                    if root.services-note != "": Text {
                        text: root.services-note;
                        color: Theme.accent;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                    Section {
                        title: "Last.fm";
                        logo: @image-url("lastfm.svg");
                        brand: #d51007;
                        about: "Keeps a record of what you listen to. A track scrobbles after it has played for half its length or four minutes." + (root.lastfm-builtin ? "" : " This build has no Last.fm keys of its own. Enter an API key and shared secret from last.fm/api/account/create.");
                        if !root.lastfm-builtin && root.lastfm-user == "": HorizontalLayout {
                            spacing: 8px;
                            Field {
                                placeholder: "Last.fm API key";
                                text <=> root.svc-lastfm-key;
                            }
                            Field {
                                placeholder: "Last.fm shared secret";
                                secret: true;
                                text <=> root.svc-lastfm-secret;
                            }
                        }
                        AccountRow {
                            linked: root.lastfm-user != "";
                            title: root.lastfm-user != "" ? "Linked as " + root.lastfm-user : "Not linked";
                            subtitle: root.lastfm-user != "" ? "" : "Connect opens Last.fm in your browser. Approve Tonearm there and it links by itself.";
                            link => { root.lastfm-connect(); }
                            unlink => { root.lastfm-connect(); }
                        }
                    }
                }
                ScrollThumb {
                    x: lastfm-flick.width - self.width;
                    y: -lastfm-flick.content-y;
                    height: lastfm-flick.height;
                    content-y <=> lastfm-flick.content-y;
                    content-height: lastfm-flick.content-height;
                    view-height: lastfm-flick.height;
                }
            }

            // Settings sub page: Discord rich presence.
            if root.nav == 3 && root.settings-page == 10: discord-flick := Flickable {
                // Fills the panel. Left alone it takes the cards' cap as
                // its own width and stops short, scroll bar and all.
                max-width: 100000px;
                horizontal-stretch: 1;
                content-height: discord-page.preferred-height;
                discord-page := VerticalLayout {
                    padding: 28px;
                    padding-top: 26px;
                    spacing: 14px;
                    alignment: start;
                    Text {
                        text: "Discord";
                        color: Theme.text;
                        font-size: 32px;
                        font-weight: 800;
                    }
                    if root.services-note != "": Text {
                        text: root.services-note;
                        color: Theme.accent;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                    Section {
                        title: "Discord";
                        logo: @image-url("discord.svg");
                        brand: #5865f2;
                        about: "Shows what you play on your Discord profile. Discord has to be running on this computer." + (root.discord-builtin ? "" : " This build has no Discord application of its own. Enter the application ID of an app you create at discord.com/developers.");
                        DiscordPreview {
                            title: root.has-track ? root.track-title : "Song title";
                            artist: root.has-track ? root.track-artist : "Artist";
                            album: root.has-track ? root.track-album : "Album";
                            art: root.track-art;
                            has-art: root.has-track && root.track-has-art;
                            progress: root.has-track ? root.progress : 0.4;
                            position: root.has-track ? root.position-text : "1:12";
                            duration: root.has-track ? root.duration-text : "3:04";
                            status: root.discord-status;
                        }
                        SettingRow {
                            title: "Member list status";
                            subtitle: "What shows after \"Listening to\" next to your name";
                            Dropdown {
                                options: ["Artist", "Song", "App name"];
                                selected <=> root.discord-status;
                                changed(i) => { root.discord-status-changed(i); }
                            }
                        }
                        if !root.discord-builtin && !root.discord-on: Field {
                            placeholder: "Discord application ID";
                            text <=> root.svc-discord;
                        }
                        AccountRow {
                            linked: root.discord-on;
                            title: root.discord-on ? "Linked" : "Not linked";
                            subtitle: root.discord-on ? "Your status shows whenever Discord is open on this computer." : "Discord asks for no password. It trusts apps on the same computer.";
                            link => {
                                if root.discord-builtin {
                                    root.discord-toggle();
                                } else {
                                    root.save-services();
                                }
                            }
                            unlink => { root.discord-toggle(); }
                        }
                    }
                }
                ScrollThumb {
                    x: discord-flick.width - self.width;
                    y: -discord-flick.content-y;
                    height: discord-flick.height;
                    content-y <=> discord-flick.content-y;
                    content-height: discord-flick.content-height;
                    view-height: discord-flick.height;
                }
            }
        }
    }

    // side panel island: the rail at the window's edge while closed, and
    // the panel once open. It grows from the rail as it opens. Its content
    // is laid out at the panel's full width and clipped, so nothing in it
    // reflows on the way.
    Rectangle {
        x: root.panel-x;
        y: top-bar;
        width: root.shown-width;
        height: body-height;
        border-radius: Theme.radius;
        clip: true;
        // The panel's colour. Under Now playing's cover it starts a little
        // below the cover's top, so it never reaches the rounded corners the
        // cover fills: at those edge pixels it showed through as a pale rim.
        // The rail and the peek are solid, as the cover shows faintly there.
        Rectangle {
            property <bool> under-cover: root.np-t >= 1 && root.expand-t <= 0 && root.track-has-art && root.panel-t >= 1;
            y: self.under-cover ? max(0px, root.np-art-h + root.np-scroll - 24px) : 0px;
            height: parent.height - self.y;
            border-radius: Theme.radius;
            background: root.panel-color;
        }
        // Hovering anywhere on the open panel shows Now playing's hide
        // button. Faint while it only peeks through the rail.
        if root.panel-t > 0 || root.peek-t > 0: panel-hover := TouchArea {
            width: root.panel-width;
            height: parent.height;
            changed has-hover => { root.panel-hovered = self.has-hover; }
            Rectangle {
            width: root.panel-width;
            height: parent.height;
            opacity: max(root.panel-t, 0.3 * root.peek-t);
        if root.queue-t > 0: Text {
            x: 20px;
            y: 14px + root.panel-rise(root.queue-t);
            height: 32px;
            opacity: root.queue-t;
            text: "Queue";
            color: Theme.text;
            font-size: 20px;
            font-weight: 700;
            vertical-alignment: center;
        }
        if root.lyrics-t > 0: Text {
            x: 20px;
            y: 14px + root.panel-rise(root.lyrics-t);
            height: 32px;
            opacity: root.lyrics-t;
            text: "Lyrics";
            color: Theme.text;
            font-size: 20px;
            font-weight: 700;
            vertical-alignment: center;
        }
        if root.cast-t > 0: Text {
            x: 20px;
            y: 14px + root.panel-rise(root.cast-t);
            height: 32px;
            opacity: root.cast-t;
            text: "Devices";
            color: Theme.text;
            font-size: 20px;
            font-weight: 700;
            vertical-alignment: center;
        }
        // Queue, Lyrics and Devices (and the mix editor) go back to Now
        // playing, which shows the lyrics too.
        if root.queue-t > 0: CloseButton {
            x: parent.width - self.width - 14px;
            y: 12px + root.panel-rise(root.queue-t);
            opacity: root.queue-t;
            clicked => { root.show-panel(3); }
        }
        if root.cast-t > 0: CloseButton {
            x: parent.width - self.width - 14px;
            y: 12px + root.panel-rise(root.cast-t);
            opacity: root.cast-t;
            clicked => { root.show-panel(3); }
        }
        if root.lyrics-t > 0: CloseButton {
            x: parent.width - self.width - 14px;
            y: 12px + root.panel-rise(root.lyrics-t);
            opacity: root.lyrics-t;
            clicked => { root.show-panel(3); }
        }

        // Queue: what plays now, then what plays next. Drag to reorder.
        if root.queue-t > 0 && root.queue-index < 0: Text {
            x: 20px;
            y: 56px + root.panel-rise(root.queue-t);
            opacity: root.queue-t;
            text: "Play something to start a queue";
            color: Theme.dim;
            font-size: 14px;
        }
        if root.queue-t > 0 && root.queue-index >= 0: Rectangle {
            x: 0;
            y: 52px + root.panel-rise(root.queue-t);
            opacity: root.queue-t;
            width: parent.width;
            height: parent.height - 52px;
            SectionLabel {
                x: 20px;
                y: 0;
                text: "Now playing";
            }
            QueueRow {
                x: 8px;
                y: 28px;
                width: parent.width - 16px;
                item: root.queue[root.queue-index];
                current: true;
                menu(x, y) => { root.show-menu(1, root.queue-index, x, y); }
            }
            if root.up-next.length > 0: SectionLabel {
                x: 20px;
                y: 100px;
                text: "Next up";
            }
            ScrollThumb {
                x: 8px + (parent.width - 12px) - self.width;
                y: 128px;
                height: parent.height - 136px;
                content-y <=> root.drag-scroll;
                content-height: next-list.content-height;
                view-height: next-list.visible-height;
            }
            next-list := ListView {
                x: 8px;
                y: 128px;
                width: parent.width - 12px;
                height: parent.height - 136px;
                vertical-scrollbar-policy: always-off;
                content-y <=> root.drag-scroll;
                init => {
                    root.drag-view = self.height;
                    root.drag-content = self.content-height;
                }
                changed height => { root.drag-view = self.height; }
                changed content-height => { root.drag-content = self.content-height; }
                for entry[index] in root.up-next: QueueRow {
                    item: entry;
                    lifted: index == root.drag-from;
                    // Rows between where the dragged one was and where it is
                    // going step up or down by a row to open its gap.
                    shift: root.drag-from < 0 || index == root.drag-from ? 0px
                        : root.drag-to > root.drag-from && index > root.drag-from && index <= root.drag-to ? -60px
                        : root.drag-to < root.drag-from && index >= root.drag-to && index < root.drag-from ? 60px
                        : 0px;
                    activated => { root.queue-activated(root.queue-index + 1 + index); }
                    menu(x, y) => { root.show-menu(1, root.queue-index + 1 + index, x, y); }
                    drag(offset, pressed-at) => {
                        root.drag-anchor = pressed-at - root.drag-scroll;
                        root.drag-row(index, offset);
                        // Ready to take over. While the row keeps the mouse
                        // the window hears nothing, so this changes nothing.
                        root.drag-loose = true;
                    }
                    drop => { root.drop-row(); }
                    loose => { root.drag-loose = true; }
                }
            }
            // The dragged row, drawn after the list so it passes over the
            // other rows. It only shows; the row in the list keeps the mouse.
            if root.drag-from >= 0 && root.drag-from < root.up-next.length: QueueRow {
                x: next-list.x;
                y: next-list.y + root.drag-scroll + root.drag-from * 60px + root.drag-offset;
                width: next-list.width - 4px;
                item: root.up-next[root.drag-from];
                raised: true;
            }
        }

        // Devices: where the music plays now, then the other Cast devices
        // on the network to move it to, with this computer among them while
        // casting.
        if root.cast-t > 0: Rectangle {
            x: 0;
            y: 52px + root.panel-rise(root.cast-t);
            opacity: root.cast-t;
            width: parent.width;
            height: parent.height - 52px;
            property <bool> casting: root.cast-name != "";
            // Devices other than the one playing.
            property <int> others: root.cast-devices.length - (root.cast-active >= 0 ? 1 : 0) + (casting ? 1 : 0);
            SectionLabel {
                x: 20px;
                y: 0;
                text: "Playing on";
            }
            CastLine {
                x: 8px;
                y: 28px;
                width: parent.width - 16px;
                title: casting ? root.cast-name : "This computer";
                subtitle: !casting ? "" : root.cast-connecting ? "Connecting…" : "Casting from this computer";
                kind: !casting ? 3 : root.cast-active >= 0 ? root.cast-devices[root.cast-active].kind : 0;
                active: true;
            }
            SectionLabel {
                x: 20px;
                y: 92px;
                text: "Other devices";
            }
            if others == 0: Text {
                x: 20px;
                y: 122px;
                width: parent.width - 40px;
                text: "Looking for speakers and TVs on your network…";
                color: Theme.dim;
                font-size: 14px;
                wrap: word-wrap;
            }
            devices-flick := Flickable {
                x: 8px;
                y: 120px;
                width: parent.width - 16px;
                height: parent.height - 120px - 64px;
                content-height: devices-list.preferred-height;
                devices-list := VerticalLayout {
                    alignment: start;
                    if casting: CastLine {
                        title: "This computer";
                        kind: 3;
                        clicked => { root.cast-picked(-1); }
                    }
                    // The one playing is listed above, so it takes no room here.
                    for device[i] in root.cast-devices: CastLine {
                        height: i == root.cast-active ? 0px : 46px;
                        visible: i != root.cast-active;
                        title: device.name;
                        subtitle: device.kind == 2 ? "Speaker group" : device.model;
                        kind: device.kind;
                        clicked => { root.cast-picked(i); }
                    }
                }
            }
            Text {
                x: 20px;
                y: parent.height - 56px;
                width: parent.width - 40px;
                height: 44px;
                text: "Chromecasts, Google TVs and Nest speakers on your network show up here. While casting, skips take a moment to be heard.";
                color: Theme.dim;
                font-size: 12px;
                wrap: word-wrap;
                vertical-alignment: bottom;
            }
        }

        // The transition editor, for a chip on a playlist in mix mode.
        if root.mix-t > 0: Rectangle {
            x: 0;
            y: root.panel-rise(root.mix-t);
            opacity: root.mix-t;
            editor-flick := Flickable {
                content-height: editor-body.preferred-height;
                editor-body := VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Edit transition";
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        // The editor is new, and still changing.
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: beta-text.preferred-width + 12px;
                                height: 20px;
                                border-radius: 5px;
                                background: #1ed760;
                                beta-text := Text {
                                    text: "Beta";
                                    color: #08080a;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        PillButton {
                            text: "Save";
                            primary: root.mix-changed;
                            clicked => { root.mix-save(); }
                        }
                        // As tall as Save, and centred on the same line.
                        VerticalLayout {
                            alignment: center;
                            CloseButton {
                                clicked => { root.leave-mix-panel(3); }
                            }
                        }
                    }
                    MixSongLine { song: root.mix-from; }
                    // Both songs over the mix, as Spotify draws it: the card
                    // behind the transition itself, with each song's sound
                    // running on past it, and the lines that show what the
                    // transition does to each. 340 by 230, the size
                    // `PICTURE_WIDTH` and `PICTURE_HEIGHT` draw at in Rust.
                    Rectangle {
                        height: 230px;
                        Rectangle {
                            x: parent.width * root.mix-card-from;
                            width: parent.width * (root.mix-card-to - root.mix-card-from);
                            border-radius: 12px;
                            background: #ffffff0f;
                        }
                        // How far each song is being dragged, snapped.
                        property <length> out-drag;
                        property <length> in-drag;

                        // The grid, fixed to the transition. Songs snap to it.
                        MixPath { commands: root.mix-beats-path; stroke: #ffffff0c; stroke-width: 1px; }
                        MixPath { commands: root.mix-bars-path; stroke: #ffffff22; stroke-width: 1px; }
                        // The song going out. Both songs are drawn three
                        // pictures wide, so dragging brings more of them into
                        // view.
                        Rectangle {
                            visible: root.mix-from.analysed;
                            x: parent.out-drag - parent.width;
                            width: parent.width * 3;
                            height: parent.height;
                            MixPath { commands: root.mix-out-wave; fill: #efe6dc; }
                            MixPath { commands: root.mix-out-low; fill: #e0884a; }
                        }
                        Rectangle {
                            visible: root.mix-to.analysed;
                            x: parent.in-drag - parent.width;
                            width: parent.width * 3;
                            height: parent.height;
                            MixPath { commands: root.mix-in-wave; fill: #2f62e0; }
                            MixPath { commands: root.mix-in-low; fill: #e0884a; }
                        }
                        // A song with no analysis has no waveform yet: bars
                        // of changing height stand in for it in its half of
                        // the picture, with the skeletons' light sweeping
                        // over them, until the analysis is done.
                        for i in 56: Bone {
                            visible: !root.mix-from.analysed;
                            property <float> shape: abs(sin(i * 0.55rad)) * 0.6 + abs(sin((i * 1.7 + 1) * 1rad)) * 0.4;
                            property <length> bar-h: min(parent.height / 2 - 8px, 10px + self.shape * (parent.height / 2 - 26px));
                            x: parent.width / 56 * i + parent.width / 56 * 0.18;
                            width: parent.width / 56 * 0.64;
                            height: self.bar-h;
                            y: parent.height / 4 - self.bar-h / 2;
                            corner: self.width / 2;
                        }
                        for i in 56: Bone {
                            visible: !root.mix-to.analysed;
                            property <float> shape: abs(sin(i * 0.55rad)) * 0.6 + abs(sin((i * 1.7 + 1) * 1rad)) * 0.4;
                            property <length> bar-h: min(parent.height / 2 - 8px, 10px + self.shape * (parent.height / 2 - 26px));
                            x: parent.width / 56 * i + parent.width / 56 * 0.18;
                            width: parent.width / 56 * 0.64;
                            height: self.bar-h;
                            y: parent.height * 3 / 4 - self.bar-h / 2;
                            corner: self.width / 2;
                        }
                        // Drag a song along to change where they meet.
                        TouchArea {
                            // Without a y, Slint would centre it.
                            y: 0;
                            height: parent.height / 2;
                            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                            moved => {
                                if self.pressed {
                                    parent.out-drag = self.mouse-x - self.pressed-x;
                                }
                            }
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.up && parent.out-drag != 0 {
                                    root.mix-dragged(0, -parent.out-drag / parent.width * root.mix-span, event.modifiers.shift);
                                    parent.out-drag = 0;
                                }
                            }
                        }
                        TouchArea {
                            y: parent.height / 2;
                            height: parent.height / 2;
                            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                            moved => {
                                if self.pressed {
                                    parent.in-drag = self.mouse-x - self.pressed-x;
                                }
                            }
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.up && parent.in-drag != 0 {
                                    root.mix-dragged(1, -parent.in-drag / parent.width * root.mix-span, event.modifiers.shift);
                                    parent.in-drag = 0;
                                }
                            }
                        }
                        MixPath { commands: root.mix-fx-path; stroke: #e8e8ec; stroke-width: 2px; }
                        MixPath { commands: root.mix-filter-path; stroke: #c58af9; stroke-width: 2px; }
                        MixPath { commands: root.mix-bass-path; stroke: #f5c542; stroke-width: 2px; }
                        MixPath { commands: root.mix-volume-path; stroke: #4fb3ff; stroke-width: 2px; }
                        // The playhead, moved on by the clock between updates.
                        if root.mix-head-at > -5: Rectangle {
                            property <float> head: root.mix-head-rate == 0 ? root.mix-head-at
                                : root.mix-head-at + root.mix-head-rate * ((animation-tick() - root.mix-head-stamp) / 1s);
                            visible: self.head >= 0 && self.head <= 1;
                            x: parent.width * self.head - 1px;
                            width: 2px;
                            background: #1ed760;
                        }
                        // While it waits: a faint outline, and a bright piece of
                        // it running round, drawn by Rust each frame.
                        if root.mix-loading: Rectangle {
                            width: 52px;
                            height: 40px;
                            border-radius: 13px;
                            border-width: 2px;
                            border-color: #ffffff1f;
                            MixPath {
                                commands: root.mix-spinner;
                                stroke: #ffffff;
                                stroke-width: 2px;
                            }
                        }
                        Rectangle {
                            width: 44px;
                            height: 32px;
                            border-radius: 9px;
                            background: play-touch.pressed ? #ffffff40 : (play-touch.has-hover && !Scroll.active) ? #ffffff38 : #ffffff26;
                            animate background { duration: 120ms; }
                            if !root.mix-previewing: Icon {
                                text: Icons.play;
                                fill: true;
                                font-size: 16px;
                            }
                            // Stop.
                            if root.mix-previewing: Rectangle {
                                width: 11px;
                                height: 11px;
                                border-radius: 2px;
                                background: #ffffff;
                            }
                            TipSource {
                                tip: root.mix-previewing ? "Stop preview" : "Preview the transition";
                                hovered: (play-touch.has-hover && !Scroll.active);
                                pressed: play-touch.pressed;
                            }
                            play-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.mix-preview(); }
                            }
                        }
                    }
                    MixSongLine { song: root.mix-to; }
                    Text {
                        text: "Presets";
                        color: Theme.faint;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                            for name[i] in root.mix-presets: Rectangle {
                                height: 36px;
                                width: (i == 0 ? 14px + 6px : 0px) + preset-label.preferred-width + 24px;
                                border-radius: 10px;
                                background: i == root.mix-preset ? #f0f0f3 : (preset-touch.has-hover && !Scroll.active) ? #ffffff24 : #ffffff14;
                                animate background { duration: 120ms; }
                                if i == 0: Icon {
                                    x: 12px;
                                    width: 14px;
                                    text: Icons.sparkle;
                                    fill: false;
                                    color: i == root.mix-preset ? #08080a : Theme.accent;
                                    font-size: 14px;
                                }
                                preset-label := Text {
                                    x: i == 0 ? 12px + 14px + 6px : 12px;
                                    width: self.preferred-width;
                                    text: name;
                                    color: i == root.mix-preset ? #08080a : Theme.text;
                                    font-size: 14px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            preset-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.mix-preset-picked(i); }
                            }
                        }
                    }
                    // How many bars the mix lasts. It has no line of its
                    // own in the picture, so its mark is grey.
                    MixChoice {
                        title: "Length";
                        accent: #8a8a92;
                        options: root.mix-lengths;
                        selected <=> root.mix-length;
                        changed(i) => { root.mix-length-picked(i); }
                    }
                    MixChoice {
                        title: "Volume";
                        accent: #4fb3ff;
                        options: root.mix-volumes;
                        selected <=> root.mix-volume;
                        changed(i) => { root.mix-volume-picked(i); }
                    }
                    MixChoice {
                        title: "EQ";
                        accent: #f5c542;
                        options: root.mix-eqs;
                        selected <=> root.mix-eq;
                        changed(i) => { root.mix-eq-picked(i); }
                    }
                    MixChoice {
                        title: "Filter";
                        accent: #c58af9;
                        options: root.mix-filters;
                        selected <=> root.mix-filter;
                        changed(i) => { root.mix-filter-picked(i); }
                    }
                    MixChoice {
                        title: "Effects";
                        accent: #e8e8ec;
                        options: root.mix-effects;
                        selected <=> root.mix-effect;
                        changed(i) => { root.mix-effect-picked(i); }
                    }
                    MixChoice {
                        title: "Looping";
                        accent: #ff9f43;
                        options: root.mix-loops;
                        selected <=> root.mix-loop;
                        changed(i) => { root.mix-loop-picked(i); }
                    }
                    MixToggle {
                        title: "Beatmatching";
                        on: root.mix-beatmatch;
                        enabled: root.mix-can-beatmatch;
                        toggled => { root.mix-beatmatch-toggled(); }
                    }
                    MixToggle {
                        title: "Key lock";
                        on: root.mix-key-lock;
                        enabled: root.mix-can-beatmatch && root.mix-beatmatch;
                        toggled => { root.mix-key-lock-toggled(); }
                    }
                }
                ScrollThumb {
                    x: editor-flick.width - self.width;
                    y: -editor-flick.content-y;
                    height: editor-flick.height;
                    content-y <=> editor-flick.content-y;
                    content-height: editor-flick.content-height;
                    view-height: editor-flick.height;
                }
            }
        }

        // Now playing: the cover large, the song, a look at the lyrics and
        // what comes next. Nothing else.
        // The cover runs to the panel's edges, under the heading, and fades
        // into the panel at the bottom where the song's name sits on it.
        if root.np-t > 0: np-flick := Flickable {
            x: root.panel-slide(root.np-t);
            y: 0;
            opacity: root.np-t;
            width: parent.width;
            height: parent.height;
            content-width: self.width;
            content-height: np.preferred-height;
            changed content-y => { root.np-scroll = self.content-y; }
            init => { root.np-scroll = self.content-y; }
            np := VerticalLayout {
                width: root.panel-width;
                padding-bottom: 20px;
                spacing: 16px;
                alignment: start;
                Rectangle {
                    // Taller than wide, as the cover is cropped to fill.
                    height: root.panel-width * 1.2;
                    // Only while there is no cover, so it never shows round
                    // the cover's edge at the corners.
                    background: root.track-has-art || root.motion-t > 0 ? transparent : root.panel-color;
                    // The moving cover stands in for it while Now playing
                    // expands or comes back.
                    opacity: root.expand-t > 0 ? 0 : 1;
                    ArtPending {
                        waiting: !root.track-has-art && root.motion-t <= 0;
                    }
                    if root.track-has-art && !root.mix-anim: Image {
                        width: 100%;
                        height: 100%;
                        source: root.track-art;
                        image-fit: cover;
                    }
                    if root.motion-t > 0 && root.mix-hide < 1: Image {
                        width: 100%;
                        height: 100%;
                        source: root.track-motion;
                        image-fit: cover;
                        opacity: root.motion-t * (1 - root.mix-hide);
                    }
                    // The mix animation: the two covers side by side, as
                    // Spotify's Now playing has it mid-mix, with light
                    // sweeping beneath them like stage lights and light
                    // running round their borders.
                    if root.mix-anim: mixbox := Rectangle {
                        background: root.panel-color;
                        // The small covers' size, the gap between them,
                        // and where the pair sits: in the middle.
                        property <length> c: min(self.width, self.height) * 0.45;
                        property <length> g: min(self.width, self.height) * 0.05;
                        property <length> cy: (self.height - self.c) / 2;
                        property <length> lx: self.width / 2 - self.c - self.g / 2;
                        property <length> rx: self.width / 2 + self.g / 2;
                        property <float> oe: root.mix-out-e;
                        property <float> ol: root.mix-out-l;
                        property <float> ie: root.mix-in-e;
                        property <float> il: root.mix-in-l;
                        // How settled the pair is side by side: 0 while
                        // they move apart or together, 1 in between.
                        property <float> hold: clamp(min(self.oe, self.ie), 0, 1) * (1 - clamp(max(self.ol, self.il), 0, 1));
                        // Seconds into the mix, for the light's motion.
                        property <float> t: root.xfade-elapsed / 1s;
                        // Where each cover is now, for the light round it.
                        property <length> ox: self.lx * self.oe + (-self.c - 24px - self.lx) * self.ol;
                        property <length> oy: self.cy * min(1, self.oe);
                        property <length> ix: (self.width + 24px) + (self.rx - self.width - 24px) * self.ie - self.rx * self.il;
                        // Each cover's size and top as drawn below, which
                        // the light round its border follows while they
                        // scale.
                        property <length> ow: self.width + (self.c - self.width) * self.oe;
                        property <length> oh: self.height + (self.c - self.height) * self.oe;
                        property <length> iy: self.cy - self.cy * min(1, self.il);
                        property <length> iw: self.c + (self.width - self.c) * min(1, self.il);
                        property <length> ih: self.c + (self.height - self.c) * min(1, self.il);
                        // Rays of light falling from beneath the covers, as
                        // stage lights: two from each, one leaning out and
                        // one more upright, each sweeping slowly from side
                        // to side at its own pace and shimmering. Two soft
                        // layers each, the inner narrower, so edges blur.
                        for ray in [
                            { side: -1, r: 0, layer: 0 }, { side: -1, r: 0, layer: 1 },
                            { side: -1, r: 1, layer: 0 }, { side: -1, r: 1, layer: 1 },
                            { side: 1, r: 0, layer: 0 }, { side: 1, r: 0, layer: 1 },
                            { side: 1, r: 1, layer: 0 }, { side: 1, r: 1, layer: 1 },
                        ]: Path {
                            property <length> x0: ray.side < 0 ? mixbox.lx : mixbox.rx;
                            property <length> tc: self.x0 + mixbox.c * (0.5 + ray.side * (ray.r == 0 ? 0.2 : -0.18));
                            property <length> th: mixbox.c * (0.16 - 0.06 * ray.layer);
                            property <length> top: mixbox.cy + mixbox.c - 2px;
                            property <length> len: mixbox.c * (1.9 - 0.2 * ray.layer);
                            property <float> phase: ray.r * 0.37 + (ray.side > 0 ? 0.5 : 0);
                            property <length> lean: ray.side * mixbox.c * (ray.r == 0 ? 0.55 : 0.05) + mixbox.c * 0.35 * sin((mixbox.t / (ray.r == 0 ? 4.2 : 5.6) + self.phase) * 360deg);
                            property <length> bh: mixbox.c * (0.42 - 0.12 * ray.layer);
                            x: 0;
                            y: 0;
                            width: mixbox.width;
                            height: mixbox.height;
                            viewbox-width: mixbox.width / 1px;
                            viewbox-height: mixbox.height / 1px;
                            clip: true;
                            opacity: mixbox.hold * (0.75 + 0.25 * sin((mixbox.t * 0.9 + ray.r * 0.4 + ray.side * 0.2) * 360deg));
                            fill: @linear-gradient(180deg, #ffffff1a 0%, #ffffff0a 40%, #ffffff00 100%);
                            MoveTo {
                                x: (parent.tc - parent.th) / 1px;
                                y: parent.top / 1px;
                            }
                            LineTo {
                                x: (parent.tc + parent.th) / 1px;
                                y: parent.top / 1px;
                            }
                            LineTo {
                                x: (parent.tc + parent.lean + parent.bh) / 1px;
                                y: (parent.top + parent.len) / 1px;
                            }
                            LineTo {
                                x: (parent.tc + parent.lean - parent.bh) / 1px;
                                y: (parent.top + parent.len) / 1px;
                            }
                            Close { }
                        }
                        // Going out: full size to the left slot, then off.
                        Rectangle {
                            drop-shadow-blur: 26px * mixbox.hold;
                            drop-shadow-offset-y: 8px * mixbox.hold;
                            drop-shadow-color: #000000.with-alpha(0.35 * mixbox.hold);
                            x: parent.lx * parent.oe + (-parent.c - 24px - parent.lx) * parent.ol;
                            y: parent.cy * min(1, parent.oe);
                            width: parent.width + (parent.c - parent.width) * parent.oe;
                            height: parent.height + (parent.c - parent.height) * parent.oe;
                            border-radius: 8px * min(1, parent.oe);
                            clip: true;
                            opacity: 1 - clamp(parent.ol, 0, 1);
                            if root.fade-has-art: Image {
                                width: 100%;
                                height: 100%;
                                source: root.fade-art;
                                image-fit: cover;
                            }
                            // Its Canvas gives way to the still cover first.
                            if root.fade-motion-on && root.mix-enter < 1: Image {
                                width: 100%;
                                height: 100%;
                                source: root.fade-motion;
                                image-fit: cover;
                                opacity: 1 - root.mix-enter;
                            }
                            // A thin rim of light.
                            Rectangle {
                                border-radius: parent.border-radius;
                                border-width: 1px;
                                border-color: #ffffff.with-alpha(0.14 * mixbox.hold);
                            }
                        }
                        // Coming in: from the right to the right slot, then
                        // to the middle and full size.
                        Rectangle {
                            x: (parent.width + 24px) + (parent.rx - parent.width - 24px) * parent.ie - parent.rx * parent.il;
                            y: parent.cy - parent.cy * min(1, parent.il);
                            // Never past full size, which would spill out
                            // of the cover's place.
                            width: parent.c + (parent.width - parent.c) * min(1, parent.il);
                            height: parent.c + (parent.height - parent.c) * min(1, parent.il);
                            border-radius: 8px * (1 - min(1, parent.il));
                            clip: true;
                            drop-shadow-blur: 26px * mixbox.hold;
                            drop-shadow-offset-y: 8px * mixbox.hold;
                            drop-shadow-color: #000000.with-alpha(0.35 * mixbox.hold);
                            if root.track-has-art: Image {
                                width: 100%;
                                height: 100%;
                                source: root.track-art;
                                image-fit: cover;
                            }
                            Rectangle {
                                border-radius: parent.border-radius;
                                border-width: 1px;
                                border-color: #ffffff.with-alpha(0.14 * mixbox.hold);
                            }
                        }
                        // Light running round each cover's border, a lap
                        // every 2.6 s, half a lap apart: a bright head with
                        // a glow and a tail of light fading behind it.
                        if mixbox.hold > 0.01: Rectangle {
                            opacity: mixbox.hold;
                            for i in 80: Rectangle {
                                property <int> k: i >= 40 ? 1 : 0;
                                property <int> j: mod(i, 40);
                                property <float> fade: 1 - self.j / 40;
                                property <length> x0: self.k == 0 ? mixbox.ox : mixbox.ix;
                                property <length> y0: self.k == 0 ? mixbox.oy : mixbox.iy;
                                property <length> bw: self.k == 0 ? mixbox.ow : mixbox.iw;
                                property <length> bh: self.k == 0 ? mixbox.oh : mixbox.ih;
                                property <float> u: mod(mixbox.t / 2.6 + self.k * 0.5 - self.j * 0.003 + 10, 1.0);
                                property <float> d: self.u * 4;
                                property <float> s: floor(self.d);
                                property <float> f: self.d - self.s;
                                property <length> px: self.s == 0 ? self.x0 + self.bw * self.f : self.s == 1 ? self.x0 + self.bw : self.s == 2 ? self.x0 + self.bw * (1 - self.f) : self.x0;
                                property <length> py: self.s == 0 ? self.y0 : self.s == 1 ? self.y0 + self.bh * self.f : self.s == 2 ? self.y0 + self.bh : self.y0 + self.bh * (1 - self.f);
                                property <length> size: self.j == 0 ? mixbox.c * 0.16 : 1.5px + 2.5px * self.fade;
                                width: self.size;
                                height: self.size;
                                x: self.px - self.size / 2;
                                y: self.py - self.size / 2;
                                border-radius: self.size / 2;
                                background: self.j == 0
                                    ? @radial-gradient(circle, #ffffffd0 0%, #ffffff40 30%, #ffffff00 70%)
                                    : #ffffff.with-alpha(0.9 * self.fade * self.fade);
                            }
                        }
                    }
                    // The song going out, fading off the new one's cover.
                    // Its Canvas keeps playing until it has gone.
                    if root.xfade < 1 && !root.mix-anim: Rectangle {
                        opacity: 1 - root.xfade-eased;
                        if root.fade-has-art: Image {
                            width: 100%;
                            height: 100%;
                            source: root.fade-art;
                            image-fit: cover;
                        }
                        if root.fade-motion-on: Image {
                            width: 100%;
                            height: 100%;
                            source: root.fade-motion;
                            image-fit: cover;
                        }
                    }
                    // Two plain fades stacked make the curve. One gradient
                    // with a middle stop drew a hard line at that stop.
                    Rectangle {
                        y: parent.height * 0.4;
                        height: parent.height * 0.6;
                        background: @linear-gradient(180deg, root.panel-color.transparentize(100%) 0%, root.panel-color.transparentize(25%) 100%);
                    }
                    Rectangle {
                        y: parent.height * 0.7;
                        height: parent.height * 0.3 + 1px;
                        background: @linear-gradient(180deg, root.panel-color.transparentize(100%) 0%, root.panel-color 100%);
                    }
                    // The song going out, laid like the names below. It
                    // slides up and out before they slide in.
                    if root.name-out < 1: HorizontalLayout {
                        y: parent.height - 76px - 16px * root.name-out;
                        height: 60px;
                        padding-left: 20px;
                        padding-right: 16px;
                        spacing: 8px;
                        opacity: 1 - root.name-out;
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: root.fade-title;
                                color: Theme.text;
                                font-size: 24px;
                                font-weight: 800;
                                overflow: elide;
                            }
                            Text {
                                height: 18px;
                                text: root.fade-artist;
                                color: Theme.text.with-alpha(0.75);
                                font-size: 16px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                        // Where the heart is in the row below.
                        Rectangle {
                            width: 36px;
                        }
                    }
                    HorizontalLayout {
                        y: parent.height - 76px + 16px * (1 - root.name-in);
                        height: 60px;
                        padding-left: 20px;
                        padding-right: 16px;
                        spacing: 8px;
                        opacity: root.name-in;
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Marquee {
                                text: root.has-track ? root.track-title : "Nothing playing";
                                font-size: 24px;
                                font-weight: 800;
                            }
                            RunLine {
                                height: 18px;
                                font-size: 16px;
                                text-color: Theme.text.with-alpha(0.75);
                                text: root.has-track ? root.track-artist : "Pick something to play";
                                runs: root.has-track ? root.track-runs : [];
                                open(b) => { root.open-browse(b); }
                                menu(x, y) => { root.show-menu(2, 0, x, y); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.heart;
                                fill: root.liked;
                                size: 22px;
                                tint: root.liked ? Theme.accent : Theme.text;
                                tip: root.liked ? "Remove from liked songs" : "Add to liked songs";
                                clicked => { root.toggle-like(); }
                            }
                        }
                    }
                }
                VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 16px;
                // A few lines from where the song is, straight on the panel.
                // Opens the lyrics.
                if root.has-track && root.lyrics-state == 2 && root.lyrics-preview.length > 0: Rectangle {
                    height: 150px;
                    // Every line, wrapped, in a window that scrolls so the
                    // line being sung sits at its top.
                    preview-window := Rectangle {
                        clip: true;
                        VerticalLayout {
                            y: -root.preview-offset;
                            width: parent.width;
                            height: self.preferred-height;
                            spacing: 8px;
                            for line[i] in root.lyrics-preview: Text {
                                property <bool> current: i == max(0, root.lyrics-line);
                                // How far down the window the line ends.
                                property <length> bottom: self.y - root.preview-offset + self.height;
                                changed current => {
                                    if self.current {
                                        root.preview-offset = self.y;
                                    }
                                }
                                init => {
                                    if self.current {
                                        root.preview-offset = self.y;
                                    }
                                }
                                text: line;
                                wrap: word-wrap;
                                color: !root.lyrics-synced || i == root.lyrics-line ? Theme.text : Theme.text.with-alpha(0.5);
                                animate color { duration: 300ms; }
                                // Lines fade out as they reach the bottom.
                                opacity: clamp(1 - (self.bottom - (preview-window.height - 30px)) / 50px, 0.15, 1);
                                font-size: 18px;
                                font-weight: 700;
                            }
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.show-panel(2); }
                    }
                }
                if root.up-next.length > 0: Rectangle {
                    height: 112px;
                    border-radius: 12px;
                    background: #ffffff0d;
                    Text {
                        x: 16px;
                        y: 14px;
                        text: "Next in queue";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 700;
                    }
                    Text {
                        x: parent.width - self.width - 16px;
                        y: 14px;
                        text: "Open queue";
                        color: (open-queue.has-hover && !Scroll.active) ? Theme.text : Theme.dim;
                        font-size: 14px;
                        font-weight: 600;
                        open-queue := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show-panel(1); }
                        }
                    }
                    QueueRow {
                        x: 4px;
                        y: 42px;
                        width: parent.width - 8px;
                        item: root.up-next[0];
                        activated => { root.queue-activated(root.queue-index + 1); }
                        menu(x, y) => { root.show-menu(1, root.queue-index + 1, x, y); }
                    }
                }
                // The song's tempo and key.
                if root.track-sound.length > 0: Rectangle {
                    height: sound-list.preferred-height;
                    border-radius: 12px;
                    background: #ffffff0d;
                    sound-list := VerticalLayout {
                        // Given, so wrapped names measure at this width, not
                        // as one long line, and the card is tall enough.
                        width: parent.width;
                        padding: 16px;
                        spacing: 12px;
                        Text {
                            text: "Sound";
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        // Placed by hand: in a layout of its own the wrapped
                        // names measured as one line, and the card cut off
                        // the lines past the first.
                        for row in root.track-sound: Rectangle {
                            height: sound-names.y + sound-names.height;
                            sound-role := Text {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                text: row.role;
                                color: Theme.dim;
                                font-size: 12px;
                            }
                            sound-names := Text {
                                x: 0;
                                y: sound-role.height + 2px;
                                width: parent.width;
                                height: self.preferred-height;
                                text: row.names;
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                // Who wrote and produced the song.
                if root.track-credits.length > 0: Rectangle {
                    height: credits-list.preferred-height;
                    border-radius: 12px;
                    background: #ffffff0d;
                    credits-list := VerticalLayout {
                        // Given, so wrapped names measure at this width, not
                        // as one long line, and the card is tall enough.
                        width: parent.width;
                        padding: 16px;
                        spacing: 12px;
                        Text {
                            text: "Credits";
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        // Placed by hand: in a layout of its own the wrapped
                        // names measured as one line, and the card cut off
                        // the lines past the first.
                        for credit in root.track-credits: Rectangle {
                            height: credit-names.y + credit-names.height;
                            credit-role := Text {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                text: credit.role;
                                color: Theme.dim;
                                font-size: 12px;
                            }
                            credit-names := Text {
                                x: 0;
                                y: credit-role.height + 2px;
                                width: parent.width;
                                height: self.preferred-height;
                                text: credit.names;
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                }
            }
        }
        // Dark at the top so the heading reads on any cover. It stays with
        // the heading rather than scrolling off with the cover, and goes once
        // the cover has, so it does not shade the lyrics under it.
        if root.np-t > 0: Rectangle {
            x: root.panel-slide(root.np-t);
            y: 0;
            width: parent.width;
            height: 90px;
            // Full while the cover is under the heading. It only fades once the
            // cover's lower part, which blends into the panel, reaches the top.
            opacity: root.expand-t > 0 ? 0 : root.np-t * clamp((root.np-art-h * 0.7 + root.np-scroll) / 90px, 0, 1);
            background: @linear-gradient(180deg, #000000a0 0%, #00000000 100%);
        }
        // Spreads Now playing over the page. Quiet until the mouse is near.
        if root.np-t > 0: IconButton {
            x: parent.width - self.width - 12px + root.panel-slide(root.np-t);
            y: 12px;
            icon: Icons.expand;
            tip: "Expand";
            size: 20px;
            tint: Theme.text;
            opacity: (root.expand-t > 0 ? 0 : self.hovered ? 1 : 0.7) * root.np-t;
            clicked => { root.np-expanded = true; }
        }
        // Drawn over the cover, so it comes after it. Moves over for the hide
        // button while the panel is hovered.
        if root.np-t > 0: Text {
            x: 20px + 32px * root.np-head-t + root.panel-slide(root.np-t);
            y: 14px;
            height: 32px;
            opacity: root.expand-t > 0 ? 0 : root.np-t;
            text: "Now playing";
            color: Theme.text;
            font-size: 20px;
            font-weight: 700;
            vertical-alignment: center;
        }
        // Hides Now playing, back to the rail. Only while the panel is
        // hovered, as in other players.
        if root.np-t > 0 && root.np-head-t > 0: IconButton {
            x: 10px + root.panel-slide(root.np-t);
            y: 12px;
            shape: "M 3 4 L 21 4 L 21 20 L 3 20 Z M 4.6 5.6 L 4.6 18.4 L 19.4 18.4 L 19.4 5.6 Z M 8.2 5.6 L 9.8 5.6 L 9.8 18.4 L 8.2 18.4 Z";
            size: 20px;
            tint: Theme.text;
            tip: "Hide Now playing view";
            opacity: (root.expand-t > 0 ? 0 : root.np-head-t) * root.np-t;
            clicked => { root.show-panel(3); }
        }
            }
        }
        // The rail: a chevron that opens Now playing. Hovered, the panel
        // widens a little and Now playing shows through. Only once the panel
        // has closed: while it shrinks it is still under the mouse that
        // closed it, which would leave the rail peeking.
        if root.panel == 0 && root.panel-t <= 0: TouchArea {
            mouse-cursor: pointer;
            changed has-hover => {
                root.rail-hovered = self.has-hover;
                if self.has-hover {
                    root.shown-panel = 3;
                }
            }
            clicked => {
                root.rail-hovered = false;
                root.show-panel(3);
            }
            Icon {
                x: (root.rail - self.width) / 2 + (root.rail-peek - root.rail) / 2 * root.peek-t;
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                text: Icons.left;
                font-size: 18px;
                color: parent.has-hover ? Theme.text : Theme.dim;
                opacity: 1 - root.panel-t;
            }
        }
    }

    // Now playing, expanded. It grows out of the panel to cover the page.
    if root.expand-t > 0: Rectangle {
        // It stays put and fades. The cover is what moves, on its own layer.
        x: root.wide-x;
        y: top-bar;
        width: root.wide-width;
        opacity: root.expand-t;
        height: body-height;
        border-radius: Theme.radius;
        background: @linear-gradient(160deg, root.shown-tint.mix(Theme.island, 0.55) 0%, Theme.island 75%);
        clip: true;
        // The still cover, blurred to fill the view, and darkened so the
        // cover and words stand out on it. The app waves it slowly.
        Image {
            width: 100%;
            height: 100%;
            source: root.track-backdrop;
            image-fit: cover;
            image-rendering: smooth;
        }
        Rectangle {
            background: @linear-gradient(180deg, #00000038 0%, #00000070 100%);
        }
        // Catches clicks, so nothing underneath reacts.
        TouchArea { }
        // Takes the keyboard as it opens, so Escape puts it back.
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.np-expanded = false;
                    return accept;
                }
                reject
            }
        }
        // Where the page's back button is: back to the panel.
        IconButton {
            x: 16px;
            y: 14px;
            icon: Icons.back;
            size: 20px;
            tint: Theme.text;
            tip: "Back";
            clicked => { root.np-expanded = false; }
        }
        // Back to the panel.
        IconButton {
            x: parent.width - self.width - 16px;
            y: 16px;
            icon: Icons.collapse;
            tip: "Collapse";
            size: 20px;
            tint: Theme.dim;
            clicked => { root.np-expanded = false; }
        }
    }

    // The cover and the song's name, between the panel and the expanded view.
    // Both views hide their own while this is out, and it lands exactly on
    // them, so the cover looks like it moves from one spot to the other.
    if root.expand-t > 0: Rectangle {
        property <float> t: root.expand-t;
        // Where the panel puts the title: on the cover, near its bottom.
        property <length> np-title-y: root.np-art-y + root.np-art-h - 72px;
        property <length> wide-title-y: root.wide-art-y + root.wide-art + 24px;
        Rectangle {
            x: root.panel-x + (root.wide-art-x - root.panel-x) * parent.t;
            y: root.np-art-y + (root.wide-art-y - root.np-art-y) * parent.t;
            width: panel-width + (root.wide-art - panel-width) * parent.t;
            height: root.np-art-h + (root.wide-art - root.np-art-h) * parent.t;
            border-radius: 12px;
            clip: true;
            // Only seen while there is no cover. It fades as the cover grows.
            background: root.panel-color.transparentize(parent.t);
            ArtPending {
                waiting: !root.track-has-art && root.motion-t <= 0;
            }
            if root.track-has-art: Image {
                width: 100%;
                height: 100%;
                source: root.track-art;
                image-fit: cover;
            }
            if root.motion-t > 0: Image {
                width: 100%;
                height: 100%;
                source: root.track-motion;
                image-fit: cover;
                opacity: root.motion-t * (1 - root.expand-t);
            }
            // The expanded view's own, which takes over as the view grows.
            if root.wide-motion-t > 0: Image {
                width: 100%;
                height: 100%;
                source: root.wide-motion;
                image-fit: cover;
                opacity: root.wide-motion-t * root.expand-t;
            }
            // The panel's shading, which the expanded cover does without.
            Rectangle {
                opacity: 1 - root.expand-t;
                Rectangle {
                    height: 90px;
                    y: 0;
                    background: @linear-gradient(180deg, #000000a0 0%, #00000000 100%);
                }
                Rectangle {
                    y: parent.height * 0.4;
                    height: parent.height * 0.6;
                    background: @linear-gradient(180deg, root.panel-color.transparentize(100%) 0%, root.panel-color.transparentize(25%) 100%);
                }
                Rectangle {
                    y: parent.height * 0.7;
                    height: parent.height * 0.3 + 1px;
                    background: @linear-gradient(180deg, root.panel-color.transparentize(100%) 0%, root.panel-color 100%);
                }
            }
        }
        // The panel's heading, expand button and heart fade as it leaves.
        Text {
            x: root.panel-x + 20px + 32px * root.np-head-t;
            y: top-bar + 14px;
            height: 32px;
            opacity: 1 - parent.t;
            text: "Now playing";
            color: Theme.text;
            font-size: 20px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Icon {
            x: root.panel-x + panel-width - 48px;
            y: top-bar + 12px;
            width: 36px;
            height: 36px;
            opacity: (1 - parent.t) * 0.7;
            text: Icons.expand;
            font-size: 20px;
        }
        Icon {
            x: root.panel-x + panel-width - 52px;
            y: root.np-art-y + root.np-art-h - 64px;
            width: 36px;
            height: 36px;
            opacity: 1 - parent.t;
            text: Icons.heart;
            fill: root.liked;
            color: root.liked ? Theme.accent : Theme.text;
            font-size: 22px;
        }
        Text {
            x: root.panel-x + 20px + (root.wide-art-x - root.panel-x - 20px) * parent.t;
            y: parent.np-title-y + (parent.wide-title-y - parent.np-title-y) * parent.t;
            width: panel-width - 80px + (root.wide-art - panel-width + 80px) * parent.t;
            text: root.has-track ? root.track-title : "Nothing playing";
            color: Theme.text;
            font-size: 24px + 4px * parent.t;
            font-weight: 800;
            overflow: elide;
        }
        Text {
            x: root.panel-x + 20px + (root.wide-art-x - root.panel-x - 20px) * parent.t;
            y: parent.np-title-y + 34px + (parent.wide-title-y - parent.np-title-y + 4px) * parent.t;
            width: panel-width - 80px + (root.wide-art - panel-width + 80px) * parent.t;
            text: root.has-track ? root.track-artist : "Pick something to play";
            color: Theme.text.with-alpha(0.75 - 0.2 * parent.t);
            font-size: 16px;
            overflow: elide;
        }
    }

    // Lyrics sit at window level so the scroll animation can reach them.
    lyrics-view := Flickable {
        property <bool> wide: root.expand-t > 0;
        visible: (root.lyrics-t > 0 && root.panel-t > 0) || wide;
        // Fades as the panel closes: drawn at window level, the panel's
        // edge does not clip it.
        opacity: wide ? root.expand-t : root.lyrics-t * root.panel-t;
        x: wide ? root.wide-x + root.wide-width * root.art-share : root.panel-x;
        y: wide ? top-bar + 72px : top-bar + 56px + root.panel-rise(root.lyrics-t);
        width: wide ? root.wide-width * (1 - root.art-share) - 32px : panel-width;
        height: wide ? body-height - 104px : body-height - 64px;
        content-height: max(self.height, lines.preferred-height);
        // Freed, it moves with the wheel at once. Sync glides back.
        animate content-y { duration: root.lyrics-free ? 0ms : 600ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        flicked => {
            if !root.lyrics-free && root.lyrics-synced {
                // The lines' own shift becomes scrolling, so nothing jumps
                // and the whole song can be scrolled through.
                root.lyrics-free = true;
                self.content-y = max(-(self.content-height - self.height), min(0px, self.content-y - root.lyrics-scroll));
            }
        }
        lines := VerticalLayout {
            alignment: start;
            padding-top: 8px;
            padding-bottom: 160px;
            if root.lyrics-state == 1: HorizontalLayout {
                padding-left: 20px;
                padding-right: 40px;
                padding-top: 8px;
                SkeletonLines {
                    lines: 8;
                    line-height: 24px;
                }
            }
            if root.lyrics-state == 0 || root.lyrics-state == 3: Text {
                x: 20px;
                height: 40px;
                text: root.lyrics-state == 3 ? "No lyrics for this track" : "Play a song to see its lyrics";
                color: Theme.dim;
                font-size: 16px;
                vertical-alignment: center;
            }
            for row in root.lyrics: lyric-row := Rectangle {
                // A sung line stays lit through the quiet after it, until the
                // next one starts. The interlude dots show only in their gap.
                property <bool> active: root.lyrics-synced && (row.kind == 2
                    ? root.lyrics-time >= row.start && root.lyrics-time < row.end
                    : row.line == root.lyrics-line);
                property <int> distance: abs(row.line - root.lyrics-line);
                // Puts this row a third of the way down the view, from where
                // the layout really has it.
                function bring-in() {
                    root.lyrics-scroll = clamp(self.y - lyrics-view.height * 0.2, 0px, max(0px, lines.preferred-height - lyrics-view.height));
                }
                changed active => {
                    if self.active && row.first {
                        self.bring-in();
                    }
                }
                init => {
                    if self.active && row.first {
                        self.bring-in();
                    }
                }
                // This row's own copy of the scroll. Lines below the sung one
                // follow a beat later each.
                property <length> shift: root.lyrics-at;
                // Apple Music's ripple, as AMLL measures it. Each line rides
                // a spring (mass 0.9, stiffness about 190, damping its root
                // times 2.2), drawn here as the curve that fits it to within
                // 1%. The wave starts at the top of the view, not at the sung
                // line: the line above the sung one moves first, and each line
                // under it 50 ms after the last, the step shrinking by 5% a
                // line from the sung one down.
                property <int> rel: row.line - root.lyrics-line;
                animate shift {
                    duration: root.lyrics-free ? 0ms : 800ms;
                    delay: root.lyrics-free || self.rel < 0 ? 0ms
                        : 50ms + 1050ms * (1 - pow(1 / 1.05, self.rel));
                    easing: cubic-bezier(0.228, 0.481, 0.069, 1.05);
                }
                // Lines fade with distance from the one being sung.
                property <float> fade: !root.lyrics-synced || active ? 1 : root.lyrics-free ? 0.6 : clamp(0.42 - 0.03 * distance, 0.28, 0.42);
                animate fade { duration: 350ms; easing: ease-out; }
                // Rows fade out as they pass the top or bottom of the view,
                // rather than being cut off there. The top only fades once
                // the lyrics have scrolled, so the first line starts whole.
                // Where the row is in the view, scrolled by hand or not.
                property <length> top: self.y - self.shift + lyrics-view.content-y;
                property <length> half: max(1px, self.height / 2);
                property <float> edge: clamp((self.top + self.half) / (self.half + min(28px, self.shift - lyrics-view.content-y)), 0, 1)
                    * clamp((lyrics-view.height - self.top - self.height + self.half) / (self.half + 28px), 0, 1);
                // Synced lines go out of focus with distance from the one
                // being sung: 0 sharp, 1 a little, 2 a lot.
                property <float> blur: root.lyrics-synced && !root.lyrics-free && row.kind == 0 && distance > 1 ? min(2, 0.6 * (distance - 1)) : 0;
                animate blur { duration: 400ms; easing: ease-out; }
                // The sung line grows.
                property <float> grow: active && row.kind == 0 ? root.lyrics-grow : 1;
                animate grow { duration: 350ms; easing: cubic-bezier(0.2, 0.85, 0.25, 1); }
                property <LayoutAlignment> lay: row.align == 1 ? LayoutAlignment.end : row.align == 2 ? LayoutAlignment.center : LayoutAlignment.start;
                property <TextHorizontalAlignment> side: row.align == 1 ? TextHorizontalAlignment.right : row.align == 2 ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
                property <float> gap-progress: clamp(1.0 * (root.lyrics-time - row.start) / max(1, row.end - row.start), 0, 1);
                // Backing vocals come out from under their line while it is
                // sung, and tuck away after.
                property <length> backing-font: root.lyrics-font * 0.6;
                height: row.kind == 1 ? 18px
                    : row.kind == 2 ? (active ? root.lyrics-row : 0px)
                    : row.kind == 3 ? (active ? self.backing-font * 1.5 : 0px)
                    : row.kind == 4 ? (root.lyrics-synced ? self.backing-font * 1.45 : 20px)
                    : root.lyrics-synced ? root.lyrics-row * self.grow : 24px;
                animate height { duration: 300ms; easing: ease-out; }
                if row.kind == 2 && active: HorizontalLayout {
                    y: -lyric-row.shift;
                    alignment: start;
                    padding-left: 22px;
                    spacing: 8px;
                    opacity: lyric-row.edge;
                    VerticalLayout { alignment: center; Dot { level: lyric-row.gap-progress * 3; } }
                    VerticalLayout { alignment: center; Dot { level: lyric-row.gap-progress * 3 - 1; } }
                    VerticalLayout { alignment: center; Dot { level: lyric-row.gap-progress * 3 - 2; } }
                }
                if row.kind == 3: HorizontalLayout {
                    property <float> shown: lyric-row.active ? 1 : 0;
                    animate shown { duration: 350ms; easing: ease-out; }
                    y: -lyric-row.shift - 10px * (1 - self.shown);
                    height: lyric-row.backing-font * 1.5;
                    alignment: lyric-row.lay;
                    padding-left: 20px;
                    padding-right: 20px;
                    opacity: self.shown * 0.85 * lyric-row.edge;
                    for syllable in row.syllables: SyllableView {
                        syllable: syllable;
                        time: root.lyrics-time;
                        active: lyric-row.active;
                        font-size: lyric-row.backing-font;
                    }
                }
                if row.kind == 0: Rectangle {
                    y: -lyric-row.shift;
                    opacity: lyric-row.fade * lyric-row.edge;
                    // Word by word timing shows only on the sung line. The
                    // rest draw whole, so they can blur.
                    if row.syllables.length > 0 && lyric-row.distance == 0: HorizontalLayout {
                        alignment: lyric-row.lay;
                        padding-left: 20px;
                        padding-right: 20px;
                        for syllable in row.syllables: SyllableView {
                            syllable: syllable;
                            time: root.lyrics-time;
                            active: lyric-row.active;
                            font-size: root.lyrics-font * lyric-row.grow;
                            // The row is still fading up as its line starts.
                            // Its words not yet sung stay as bright as the
                            // line was while it waited, rather than dipping.
                            unsung: 0.4 / max(0.4, lyric-row.fade);
                        }
                    }
                    if row.syllables.length == 0 || lyric-row.distance > 0: BlurText {
                        x: 20px;
                        width: parent.width - 40px;
                        height: 100%;
                        text: row.text;
                        text-color: Theme.text;
                        font-size: root.lyrics-synced ? root.lyrics-font * lyric-row.grow : 16px;
                        font-weight: root.lyrics-synced ? 700 : 400;
                        font-family: "Figtree";
                        align: lyric-row.side;
                        level: lyric-row.blur;
                        soft: row.soft;
                        softer: row.softer;
                        soft-pad: row.soft-pad;
                        soft-height: row.soft-height;
                    }
                }
                if row.kind == 4: Text {
                    font-family: "Figtree";
                    x: 20px;
                    y: -lyric-row.shift;
                    width: parent.width - 40px;
                    height: parent.height;
                    text: row.text;
                    color: Theme.text;
                    opacity: lyric-row.fade * lyric-row.edge * 0.7;
                    font-size: root.lyrics-synced ? lyric-row.backing-font : 14px;
                    font-weight: 600;
                    horizontal-alignment: lyric-row.side;
                    vertical-alignment: TextVerticalAlignment.top;
                }
                if (row.kind == 0 || row.kind == 4) && root.lyrics-synced: TouchArea {
                    y: -lyric-row.shift;
                    mouse-cursor: pointer;
                    clicked => { root.lyrics-seek(row.start); }
                }
                // Over the line, a click on a word plays from that word. Laid
                // out as the sung line's words are, so each lands on its word
                // whether the line is drawn word by word or blurred whole.
                if row.kind == 0 && root.lyrics-synced && row.syllables.length > 0: HorizontalLayout {
                    y: -lyric-row.shift;
                    height: parent.height;
                    alignment: lyric-row.lay;
                    padding-left: 20px;
                    padding-right: 20px;
                    for syllable in row.syllables: SyllableHit {
                        syllable: syllable;
                        font-size: root.lyrics-font * lyric-row.grow;
                        clicked => { root.lyrics-seek(syllable.word-start); }
                    }
                }
            }
            if root.lyrics-state == 2: Text {
                x: 20px;
                height: 44px;
                text: "Lyrics from " + root.lyrics-source;
                color: Theme.faint;
                font-size: 12px;
                vertical-alignment: bottom;
            }
        }
    }

    // Back to following the sung line, once the lyrics were scrolled.
    if root.lyrics-free && root.lyrics-synced && lyrics-view.visible: Rectangle {
        x: lyrics-view.x + (lyrics-view.width - self.width) / 2;
        y: lyrics-view.y + lyrics-view.height - self.height - 24px;
        width: 18px + 18px + 10px + sync-label.preferred-width + 24px;
        height: 44px;
        border-radius: 22px;
        opacity: lyrics-view.opacity;
        background: sync-touch.pressed ? #dcdcdc : (sync-touch.has-hover && !Scroll.active) ? #f4f4f4 : #ffffff;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000066;
        animate background { duration: 120ms; }
        WaveIcon {
            x: 20px;
            width: 13px;
            height: 18px;
            tint: #08080a;
        }
        sync-label := Text {
            x: 18px + 18px + 10px;
            text: "Sync";
            color: #08080a;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
        }
        sync-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.sync-lyrics(); }
        }
    }

    // player island, laid out as Spotify's: the song on the left, the
    // transport over the timeline in the middle, panels and volume right.
    Rectangle {
        // The middle grows with the window. The sides share what is left.
        // Never so wide that it runs under the icons on the right, which need
        // about 260px.
        property <length> centre: max(240px, min(720px, self.width * 0.4, self.width - 2 * 330px));
        property <length> side: (self.width - centre) / 2;
        x: gap;
        y: root.height - player-height - gap;
        width: root.width - gap * 2;
        height: player-height;
        border-radius: Theme.radius;
        background: root.panel-color;
        clip: true;

        // left: what is playing. A right click on it opens the song's menu.
        TouchArea {
            x: 0;
            y: 0;
            width: side;
            height: parent.height;
            enabled: root.has-track;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    root.show-menu(2, 0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
        Art {
            x: 10px;
            y: (parent.height - self.height) / 2;
            width: 56px;
            height: 56px;
            corner: 6px;
            // Always the still cover. The animated one plays in Now playing.
            source: root.track-art;
            has: root.track-has-art;
            // The song going out, fading off the new one's cover.
            if root.xfade < 1 && root.fade-has-art: Image {
                width: 100%;
                height: 100%;
                source: root.fade-art;
                image-fit: cover;
                opacity: 1 - root.xfade-eased;
            }
            // The cover opens Now playing, as in other players.
            TouchArea {
                enabled: root.has-track;
                mouse-cursor: pointer;
                clicked => { root.show-panel(3); }
            }
        }
        // The heart sits right after the longer of the two lines, as far
        // as the side has room.
        property <length> info-room: max(60px, side - 78px - 52px);
        property <length> info-width: min(info-room, max(song-title.preferred-width, artist-line.line-width));
        song-title := Text {
            x: 78px;
            y: parent.height / 2 - 20px + 10px * (1 - root.name-in);
            width: info-width;
            height: 20px;
            text: root.has-track ? root.track-title : "Nothing playing";
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
            opacity: root.name-in;
        }
        if root.name-out < 1: Text {
            x: 78px;
            y: parent.height / 2 - 20px - 10px * root.name-out;
            width: info-width;
            height: 20px;
            text: root.fade-title;
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
            opacity: 1 - root.name-out;
        }
        if root.name-out < 1: Text {
            x: 78px;
            y: parent.height / 2 + 2px - 10px * root.name-out;
            width: info-width;
            height: 16px;
            text: root.fade-artist;
            color: Theme.dim;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
            opacity: 1 - root.name-out;
        }
        artist-line := RunLine {
            opacity: root.name-in;
            x: 78px;
            y: parent.height / 2 + 2px + 10px * (1 - root.name-in);
            font-size: 12px;
            width: info-width;
            height: 16px;
            text: root.has-track ? root.track-artist : "Pick something to play";
            runs: root.has-track ? root.track-runs : [];
            open(b) => { root.open-browse(b); }
            menu(x, y) => { root.show-menu(2, 0, x, y); }
        }
        if root.has-track: IconButton {
            x: 78px + info-width + 8px;
            y: (parent.height - self.height) / 2;
            width: 32px;
            height: 32px;
            icon: Icons.heart;
            fill: root.liked;
            size: 18px;
            tint: root.liked ? Theme.accent : Theme.dim;
            tip: root.liked ? "Remove from liked songs" : "Add to liked songs";
            clicked => { root.toggle-like(); }
        }

        // centre: transport over the timeline. The buttons and the
        // timeline's track sit as one block, centred in the island.
        // Spotify's measures: 32px buttons with 16px icons, play a 32px
        // circle, centres 40px then 48px apart, the timeline under them.
        property <length> transport-y: (self.height - 50px) / 2;
        IconButton {
            x: parent.width / 2 - 88px - 16px;
            y: transport-y;
            width: 32px;
            height: 32px;
            icon: root.smart-shuffle ? Icons.sparkle : Icons.shuffle;
            size: 16px;
            tint: root.shuffle ? Theme.accent : Theme.dim;
            dot: root.shuffle;
            // Off, then shuffle, then smart shuffle: the tip names the next.
            tip: root.smart-shuffle ? "Turn off shuffle" : root.shuffle ? "Smart shuffle" : "Shuffle";
            clicked => { root.toggle-shuffle(); }
        }
        IconButton {
            x: parent.width / 2 - 48px - 16px;
            y: transport-y;
            width: 32px;
            height: 32px;
            // Two filled triangles, as the phone has them too.
            icon: Icons.rewind;
            fill: true;
            size: 18px;
            tint: Theme.text;
            tip: "Previous";
            clicked => { root.previous(); }
        }
        IconButton {
            x: parent.width / 2 - 16px;
            y: transport-y;
            width: 32px;
            height: 32px;
            // Plain white, no disc behind it, between the two.
            icon: root.buffering ? "" : root.playing ? Icons.pause : Icons.play;
            fill: true;
            size: 22px;
            tint: Theme.text;
            tip: root.playing ? "Pause" : "Play";
            clicked => { root.toggle-play(); }
            if root.buffering: Loader {
                dot: 5px;
                tint: Theme.text;
            }
        }
        IconButton {
            x: parent.width / 2 + 48px - 16px;
            y: transport-y;
            width: 32px;
            height: 32px;
            icon: Icons.fast-forward;
            fill: true;
            size: 18px;
            tint: Theme.text;
            tip: "Next";
            clicked => { root.next(); }
        }
        IconButton {
            x: parent.width / 2 + 88px - 16px;
            y: transport-y;
            width: 32px;
            height: 32px;
            icon: root.repeat == 2 ? Icons.repeat-one : Icons.repeat;
            size: 16px;
            tint: root.repeat != 0 ? Theme.accent : Theme.dim;
            dot: root.repeat != 0;
            tip: root.repeat == 0 ? "Repeat" : root.repeat == 1 ? "Repeat one" : "Turn off repeat";
            clicked => { root.cycle-repeat(); }
        }
        Text {
            x: side;
            y: transport-y + 34px;
            width: 40px;
            height: 16px;
            text: root.position-text;
            color: Theme.dim;
            font-size: 11px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Bar {
            x: side + 50px;
            y: transport-y + 34px;
            width: centre - 100px;
            value: root.progress;
            zone-from: root.fade-from;
            picked(v) => { root.seek(v); }
        }
        Text {
            x: side + centre - 40px;
            y: transport-y + 34px;
            width: 40px;
            height: 16px;
            text: root.duration-text;
            color: Theme.dim;
            font-size: 11px;
            vertical-alignment: center;
        }

        // right: the panels, then volume, from the right edge in. Left to
        // right they read lyrics, sleep timer, devices, queue, as on the
        // phone's Now playing.
        Bar {
            x: parent.width - 16px - 96px;
            y: (parent.height - self.height) / 2;
            width: 96px;
            value: root.volume;
            live: true;
            picked(v) => { root.set-volume(v); }
        }
        // The speaker shows the level. A click mutes, and another puts the
        // old level back.
        property <float> unmuted-volume: 0.5;
        IconButton {
            x: parent.width - 16px - 96px - 34px;
            y: (parent.height - self.height) / 2;
            width: 32px;
            height: 32px;
            icon: root.volume <= 0 ? Icons.muted : root.volume < 0.5 ? Icons.speaker-low : Icons.speaker-high;
            size: 20px;
            tint: Theme.dim;
            tip: root.volume <= 0 ? "Unmute" : "Mute";
            clicked => {
                if root.volume > 0 {
                    unmuted-volume = root.volume;
                    root.set-volume(0);
                } else {
                    root.set-volume(unmuted-volume);
                }
            }
        }
        IconButton {
            x: parent.width - 16px - 96px - 28px - 4px - 36px;
            y: (parent.height - self.height) / 2;
            icon: Icons.queue;
            size: 20px;
            tint: root.panel == 1 ? Theme.accent : Theme.dim;
            dot: root.panel == 1;
            tip: root.panel == 1 ? "Hide queue" : "Show queue";
            clicked => { root.show-panel(1); }
        }
        IconButton {
            x: parent.width - 16px - 96px - 28px - 4px - 144px;
            y: (parent.height - self.height) / 2;
            icon: Icons.lyrics;
            size: 20px;
            tint: root.panel == 2 ? Theme.accent : Theme.dim;
            dot: root.panel == 2;
            tip: root.panel == 2 ? "Hide lyrics" : "Show lyrics";
            clicked => { root.show-panel(2); }
        }
        // Now playing opens from the rail at the window's edge, or the
        // cover, so it has no button here.
        // The sleep timer. The moon lights up while one runs.
        sleep-button := IconButton {
            x: parent.width - 16px - 96px - 28px - 4px - 108px;
            y: (parent.height - self.height) / 2;
            icon: Icons.moon;
            size: 19px;
            tint: root.sleep-choice != 0 ? Theme.accent : Theme.dim;
            dot: root.sleep-choice != 0;
            tip: root.sleep-choice != 0 ? "Sleep timer: " + root.sleep-options[root.sleep-choice] : "Sleep timer";
            clicked => { sleep-menu.show(); }
        }
        // Devices: opens the panel of devices to cast to. Lights up while
        // casting, as on other players, and shows its dot while open.
        IconButton {
            x: parent.width - 16px - 96px - 28px - 4px - 72px;
            y: (parent.height - self.height) / 2;
            shape: CastIcon.shape;
            size: 19px;
            tint: root.cast-name != "" || root.panel == 5 ? Theme.accent : Theme.dim;
            dot: root.panel == 5;
            tip: root.panel == 5 ? "Hide devices"
                : root.cast-name == "" ? "Devices"
                : (root.cast-connecting ? "Connecting to " : "Playing on ") + root.cast-name;
            clicked => { root.show-panel(5); }
        }
        sleep-menu := PopupWindow {
            width: 200px;
            height: 40px + 7 * 34px + 10px;
            x: sleep-button.x + sleep-button.width - self.width;
            y: -self.height - 8px;
            Rectangle {
                border-radius: 12px;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 18px;
                drop-shadow-color: #00000080;
                VerticalLayout {
                    padding: 5px;
                    spacing: 2px;
                    HorizontalLayout {
                        height: 38px;
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: "Sleep timer";
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.sleep-text;
                            color: Theme.dim;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    for option[i] in root.sleep-options: Rectangle {
                        height: 32px;
                        border-radius: 8px;
                        background: (choice.has-hover && !Scroll.active) ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: option;
                                color: i == root.sleep-choice ? Theme.text : Theme.dim;
                                font-size: 14px;
                                font-weight: i == root.sleep-choice ? 600 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            if i == root.sleep-choice: Rectangle {
                                width: 6px;
                                height: 6px;
                                y: (parent.height - 6px) / 2;
                                border-radius: 3px;
                                background: Theme.accent;
                            }
                        }
                        choice := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.sleep-chosen(i); }
                        }
                    }
                }
            }
        }
    }

    if root.toast != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - player-height - gap - self.height - 12px;
        property <length> button: root.toast-action != "" ? action-measure.preferred-width + 28px : 0px;
        // Measures the button text, which sits inside an `if` out of reach.
        action-measure := Text {
            visible: false;
            text: root.toast-action;
            font-size: 13px;
            font-weight: 700;
        }
        width: min(root.width - 48px, message.preferred-width + 40px + (self.button > 0 ? self.button + 8px - 14px : 0px));
        height: 40px;
        border-radius: 20px;
        background: #f0f0f3;
        message := Text {
            x: 20px;
            text: root.toast;
            color: #08080a;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: parent.button > 0 ? left : center;
            overflow: elide;
            width: parent.width - 40px - (parent.button > 0 ? parent.button + 8px - 14px : 0px);
        }
        if root.toast-action != "": Rectangle {
            x: parent.width - self.width - 6px;
            y: 6px;
            width: parent.button;
            height: 28px;
            border-radius: 14px;
            background: action-touch.pressed ? #2a2a30 : (action-touch.has-hover && !Scroll.active) ? #1c1c21 : #08080a;
            animate background { duration: 120ms; }
            Text {
                text: root.toast-action;
                color: #f5f5f7;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            action-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toast-clicked(); }
            }
        }
    }

    // The name prompt. The dimmed window behind it closes it on a click.
    if root.prompt-open: Rectangle {
        background: #00000090;
        TouchArea {
            clicked => { root.prompt-open = false; }
        }
        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.prompt-open = false;
                    return accept;
                }
                reject
            }
            Rectangle {
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                width: 380px;
                height: root.prompt-confirm ? 132px : 172px;
                border-radius: 16px;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 30px;
                drop-shadow-color: #000000a0;
                // Keeps clicks on the box from closing it.
                TouchArea { }
                Text {
                    x: 22px;
                    y: 20px;
                    width: parent.width - 44px;
                    text: root.prompt-title;
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                    overflow: elide;
                }
                if !root.prompt-confirm: name := Field {
                    x: 22px;
                    y: 60px;
                    width: parent.width - 44px;
                    placeholder: "Name";
                    text <=> root.prompt-text;
                    init => { self.take-focus(); }
                    accepted(text) => {
                        if text != "" {
                            root.prompt-open = false;
                            root.prompt-done(text);
                        }
                    }
                }
                HorizontalLayout {
                    x: 22px;
                    y: parent.height - 56px;
                    width: parent.width - 44px;
                    height: 36px;
                    alignment: end;
                    spacing: 10px;
                    PillButton {
                        text: "Cancel";
                        clicked => { root.prompt-open = false; }
                    }
                    PillButton {
                        text: root.prompt-action;
                        primary: !root.prompt-confirm;
                        danger: root.prompt-confirm;
                        clicked => {
                            if root.prompt-confirm || root.prompt-text != "" {
                                root.prompt-open = false;
                                root.prompt-done(root.prompt-text);
                            }
                        }
                    }
                }
            }
        }
    }

    // Asked on leaving the transition editor with changes not saved.
    if root.discard-open: Rectangle {
        background: #00000090;
        TouchArea {
            clicked => { root.discard-open = false; }
        }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.discard-open = false;
                    return accept;
                }
                reject
            }
            Rectangle {
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                width: 400px;
                height: 164px;
                border-radius: 16px;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 30px;
                drop-shadow-color: #000000a0;
                // Keeps clicks on the box from closing it.
                TouchArea { }
                Text {
                    x: 24px;
                    y: 22px;
                    text: "Discard changes?";
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 800;
                }
                Text {
                    x: 24px;
                    y: 60px;
                    width: parent.width - 48px;
                    text: "If you go back now, you'll lose your changes.";
                    color: Theme.dim;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    x: 24px;
                    y: parent.height - 24px - 44px;
                    width: parent.width - 48px;
                    height: 44px;
                    alignment: end;
                    spacing: 8px;
                    Rectangle {
                        width: keep-text.preferred-width + 32px;
                        border-radius: 22px;
                        background: (keep-touch.has-hover && !Scroll.active) ? #ffffff14 : transparent;
                        animate background { duration: 120ms; }
                        keep-text := Text {
                            text: "Keep editing";
                            horizontal-alignment: center;
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        keep-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.discard-open = false; }
                        }
                    }
                    Rectangle {
                        width: discard-text.preferred-width + 48px;
                        border-radius: 22px;
                        background: discard-touch.pressed ? #c8102a : (discard-touch.has-hover && !Scroll.active) ? #ff2a40 : #e91429;
                        animate background { duration: 120ms; }
                        discard-text := Text {
                            text: "Discard";
                            horizontal-alignment: center;
                            color: #ffffff;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        discard-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.discard-open = false;
                                if root.discard-then < 0 {
                                    root.close-mix-panel();
                                } else {
                                    root.switch-panel(root.discard-then);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // While the search list is open, or the box is focused with nothing
    // typed, a click anywhere else closes it and lets go of focus.
    if search.showing || (search.focused && root.search-text == ""): TouchArea {
        clicked => { search.close(); }
    }

    IconButton {
        x: gap + 6px;
        y: (top-bar - self.height) / 2;
        icon: Icons.back;
        size: 20px;
        tint: root.can-back || root.nav == 3 || root.nav == 5 ? Theme.text : #55555e;
        tip: "Back";
        clicked => {
            if root.nav == 3 && root.settings-page != 0 {
                root.settings-page = (root.settings-page == 2 || root.settings-page == 6 || root.settings-page >= 8) ? 7 : 0;
            } else {
                root.back();
            }
        }
    }
    Rectangle {
        x: search.x - self.width - 8px;
        y: (top-bar - self.height) / 2;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        // The search field's own colours, so the two read as one control.
        background: (home-touch.has-hover && !Scroll.active) ? #ffffff1c : #ffffff10;
        animate background { duration: 120ms; }
        Icon {
            text: Icons.home;
            fill: root.nav == 0;
            color: root.nav == 0 || (home-touch.has-hover && !Scroll.active) ? Theme.text : Theme.dim;
            font-size: 24px;
        }
        TipSource {
            tip: "Home";
            hovered: (home-touch.has-hover && !Scroll.active);
            pressed: home-touch.pressed;
        }
        home-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.np-expanded = false;
                root.navigate(0);
            }
        }
    }

    // The account, at the right of the top bar as Spotify has it: the
    // picture in a dark ring, or a person until there is one.
    Rectangle {
        x: root.width - gap - 6px - self.width;
        y: (top-bar - self.height) / 2;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: (account-touch.has-hover && !Scroll.active) || root.nav == 5 ? #ffffff1c : #ffffff10;
        animate background { duration: 120ms; }
        if root.signed-in && root.account-has-art: Art {
            x: 8px;
            y: 8px;
            width: 32px;
            height: 32px;
            source: root.account-art;
            has: true;
            round: true;
        }
        if !(root.signed-in && root.account-has-art): Icon {
            text: Icons.artist;
            color: (account-touch.has-hover && !Scroll.active) ? Theme.text : Theme.dim;
            font-size: 22px;
        }
        TipSource {
            tip: "Profile";
            hovered: (account-touch.has-hover && !Scroll.active);
            pressed: account-touch.pressed;
        }
        account-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.np-expanded = false;
                root.open-profile();
            }
        }
    }

    // Settings, an icon beside the account, as the side menu no longer
    // lists it.
    Rectangle {
        x: root.width - gap - 6px - 48px - 8px - self.width;
        y: (top-bar - self.height) / 2;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        // Clear as white with no alpha, not "transparent" (clear black), so the
        // hover fades in white as the Home button's does, not through grey.
        background: (settings-touch.has-hover && !Scroll.active) ? #ffffff1c : #ffffff00;
        animate background { duration: 120ms; }
        Icon {
            text: Icons.settings;
            fill: root.nav == 3;
            color: root.nav == 3 || (settings-touch.has-hover && !Scroll.active) ? Theme.text : Theme.dim;
            font-size: 22px;
        }
        TipSource {
            tip: "Settings";
            hovered: (settings-touch.has-hover && !Scroll.active);
            pressed: settings-touch.pressed;
        }
        settings-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.np-expanded = false;
                root.settings-page = 0;
                root.navigate(3);
            }
        }
    }

    search := SearchBox {
        x: (root.width - root.search-width) / 2 + 26px;
        y: (top-bar - 48px) / 2;
        // It stays over expanded Now playing too. A search puts that back.
        width: root.search-width;
        text <=> root.search-text;
        rows: root.suggestions;
        loading: root.suggest-loading;
        edited(text) => { root.search-edited(text); }
        search(text) => {
            root.np-expanded = false;
            root.search(text);
        }
        // A song plays where you are. A search or a page closes expanded
        // Now playing to show it, which the app does as it opens one.
        picked(index) => { root.suggestion-picked(index); }
        open-link(b) => { root.open-browse(b); }
        menu(index, x, y) => { root.show-menu(5, index, x, y); }
    }

    // The right click menu, opened at the mouse by show-menu. It keeps to
    // the window: near the right edge it opens leftward, near the bottom
    // it opens upward.
    context-menu := PopupWindow {
        x: max(8px, min(root.menu-x, root.width - 236px));
        y: root.menu-y + root.menu-height > root.height - 8px ? max(8px, root.menu-y - root.menu-height) : root.menu-y;
        width: 228px;
        height: root.menu-height;
        Rectangle {
            border-radius: 12px;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000080;
            VerticalLayout {
                padding: 5px;
                spacing: 2px;
                for entry[i] in root.menu-entries: Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: (pick.has-hover && !Scroll.active) ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        Icon {
                            width: 18px;
                            text: entry.icon;
                            font-size: 18px;
                            color: (pick.has-hover && !Scroll.active) ? Theme.text : Theme.dim;
                        }
                        Text {
                            text: entry.label;
                            color: Theme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    pick := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            // What a line does happens on the page, which
                            // the list would otherwise still cover.
                            if root.menu-source == 5 {
                                search.close-from-menu();
                            }
                            root.menu-picked(i);
                        }
                    }
                }
            }
        }
    }

    // The tooltip: over its button, where the cursor does not cover it, a
    // small gap apart so it never touches the button. Whenever it does not
    // fit above, it goes under instead. A button in the page has no room
    // over the top bar, and every tip stays inside the window.
    tooltip := Rectangle {
        property <length> gap: 6px;
        property <length> page-top: Tip.y >= root.top-bar ? root.top-bar : 4px;
        property <bool> fits-above: Tip.y - self.gap - self.height >= self.page-top;
        property <length> want-y: self.fits-above
            ? Tip.y - self.gap - self.height : Tip.y + Tip.height + self.gap;
        x: max(6px, min(root.width - self.width - 6px,
            Tip.beside ? Tip.x + Tip.width + self.gap : Tip.x + (Tip.width - self.width) / 2));
        y: max(4px, min(root.height - self.height - 4px,
            Tip.beside ? Tip.y + (Tip.height - self.height) / 2 : self.want-y));
        width: tip-label.preferred-width + 20px;
        height: 28px;
        border-radius: 7px;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #00000080;
        opacity: Tip.owner != 0 ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 110ms; easing: ease-out; }
        tip-label := Text {
            text: Tip.text;
            color: Theme.text;
            font-size: 12px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // Cools down a moment after the last tip hides, so the next waits again.
    Timer {
        interval: 400ms;
        running: Tip.warm && Tip.owner == 0;
        triggered => { Tip.warm = false; }
    }
    Timer {
        interval: 300ms;
        running: Tip.owner != 0;
        triggered => {
            if !Tip.alive { Tip.owner = 0; }
            Tip.alive = false;
        }
    }

    // Carries a queue drag on once the dragged row loses the mouse. The
    // list can take the mouse from it, and a drag above "Next up" scrolls
    // the list up until the row drops out of view, and the list removes
    // it. Either way the row cannot follow the pointer or hear the release.
    // This covers the window and does, back over the list too, until the
    // button is let go.
    drag-catcher := TouchArea {
        visible: root.drag-loose;
        mouse-cursor: grabbing;
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.drag-row(root.drag-from, self.mouse-y - root.drag-anchor - root.drag-scroll);
            }
            // A release outside the window may never arrive, so the next
            // press puts the song down too.
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.down {
                root.drop-row();
            }
        }
    }
}
